function logAudit(title, detail, who){
  auditLog.unshift({id: fsIdCounter++, t:title, d:detail, who: who || 'Administrator', when: new Date().toLocaleDateString('en-US',{month:'short',day:'numeric',year:'numeric'})});
  /* QUOTA FIX: the audit log grows with every single action and was previously unbounded —
     every new tab/device then had to read the whole history on its first snapshot. Keep only
     the most recent AUDIT_KEEP entries in memory; the listener below reads the same number. */
  if(auditLog.length > AUDIT_KEEP) auditLog.length = AUDIT_KEEP;
  renderAuditLog();
}
/* Officials assist the admin on shared actions (teams, registrations, bracket, schedule) —
   the audit trail should show which of the two actually performed the action. */
function actorLabel(){
  return currentRole === 'official' ? 'Official' : 'Administrator';
}
/* Per-tournament official assignment: the admin assigns exactly one official per tournament.
   That official can delete teams and generate the bracket ONLY for their assigned tournament —
   never for other tournaments. Admin can always do both, for every tournament. */
function isAssignedOfficial(tournament){
  return currentRole === 'official' && !!tournament && tournament.assignedOfficial === currentOfficialEmail;
}
function canManageTournament(tournament){
  if(currentRole === 'admin') return true;
  return isAssignedOfficial(tournament);
}
function officialNameByEmail(email){
  const acct = officialAccounts.find(o=>o.email===email);
  return acct ? acct.name : null;
}

