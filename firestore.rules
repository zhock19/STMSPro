<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>TournamentPro — Sports Tournament Management</title>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link href="https://fonts.googleapis.com/css2?family=Rajdhani:wght@500;600;700&family=Inter:wght@400;500;600;700&family=JetBrains+Mono:wght@500;700&display=swap" rel="stylesheet">
<style>
:root{
  --bg:#070B16;
  --panel:#0C1224;
  --panel-2:#121A33;
  --line:#232B4A;
  --lime:#4C8DFF;
  --lime-dim:#2B63D9;
  --mint:#34D399;
  --purple:#A855F7;
  --pink:#EC4899;
  --danger:#FF4D6D;
  --text:#E8ECF7;
  --muted:#7C88AA;
  --muted-2:#4B5578;
  --radius:16px;
  --font-display:'Rajdhani',sans-serif;
  --font-body:'Inter',sans-serif;
  --font-mono:'JetBrains Mono',monospace;
}

*{box-sizing:border-box;margin:0;padding:0;}
body{
  background:
    radial-gradient(ellipse 900px 500px at 15% -10%, rgba(76,141,255,0.10), transparent 60%),
    radial-gradient(ellipse 700px 500px at 100% 10%, rgba(168,85,247,0.08), transparent 60%),
    radial-gradient(ellipse 800px 600px at 50% 110%, rgba(236,72,153,0.06), transparent 60%),
    var(--bg);
  color:var(--text);
  font-family:var(--font-body);
  min-height:100vh;
  -webkit-font-smoothing:antialiased;
}
::-webkit-scrollbar{width:8px;height:8px;}
::-webkit-scrollbar-thumb{background:var(--line);border-radius:8px;}
::selection{background:var(--lime);color:#070B16;}

h1,h2,h3,.display{font-family:var(--font-display);text-transform:uppercase;letter-spacing:0.02em;}
.mono{font-family:var(--font-mono);}

a{color:inherit;text-decoration:none;}
button{font-family:inherit;cursor:pointer;border:none;}
input,select{font-family:inherit;}

/* ---------- App shell ---------- */
#app{display:flex;min-height:100vh;}

/* Sidebar */
.sidebar{
  width:230px;flex-shrink:0;
  
  background:var(--panel);
  border-right:1px solid var(--line);
  display:flex;flex-direction:column;
  padding:22px 14px;
  position:sticky;top:0;height:100vh;
}
.brand{
  display:flex;align-items:center;gap:10px;
  padding:6px 10px 22px 10px;
}
.brand-badge{
  width:34px;height:34px;border-radius:9px;
  background:linear-gradient(135deg,var(--lime),var(--purple),var(--pink));
  display:flex;align-items:center;justify-content:center;
  font-family:var(--font-display);font-weight:700;color:#fff;font-size:16px;
  box-shadow:0 0 22px rgba(168,85,247,0.3);
}
.brand-name{font-family:var(--font-display);font-weight:700;font-size:19px;letter-spacing:0.03em;}
.brand-name span{color:var(--lime);}

.nav-group-label{
  font-size:11px;color:var(--muted-2);text-transform:uppercase;letter-spacing:0.09em;
  padding:14px 12px 6px;font-weight:600;
}
.navlink{
  display:flex;align-items:center;gap:11px;
  padding:10px 12px;border-radius:10px;
  color:var(--muted);font-size:14.5px;font-weight:500;
  background:transparent;width:100%;text-align:left;
  transition:background .15s,color .15s;
}
.navlink svg{width:18px;height:18px;flex-shrink:0;}
.navlink:hover{background:var(--panel-2);color:var(--text);}
.nav-badge{
  margin-left:auto;background:#ff4d4f;color:#fff;font-size:11px;font-weight:700;
  line-height:1;padding:3px 6px;border-radius:999px;min-width:18px;text-align:center;
  box-shadow:0 0 0 2px var(--panel,#12151c);flex-shrink:0;
}
.navlink.active{
  background:linear-gradient(90deg, rgba(76,141,255,0.14), rgba(76,141,255,0.02));
  color:var(--lime);
  border-left:2px solid var(--lime);
  padding-left:10px;
}
.sidebar-foot{margin-top:auto;padding:12px;}
.role-chip{
  display:flex;align-items:center;gap:9px;
  background:var(--panel-2);border:1px solid var(--line);
  padding:9px 10px;border-radius:10px;font-size:13px;
}
.role-dot{width:8px;height:8px;border-radius:50%;background:var(--mint);box-shadow:0 0 8px var(--mint);}
.logout-btn{
  margin-top:8px;width:100%;background:transparent;border:1px solid var(--line);
  color:var(--muted);padding:8px;border-radius:10px;font-size:12.5px;font-weight:600;
  text-transform:uppercase;letter-spacing:.05em;
}
.logout-btn:hover{border-color:var(--danger);color:var(--danger);}

/* Main column */
.main{flex:1;min-width:0;display:flex;flex-direction:column;}

/* Ticker */
.ticker-wrap{
  background:#080D1C;border-bottom:1px solid var(--line);
  overflow:hidden;white-space:nowrap;position:relative;height:38px;display:flex;align-items:center;
}
.ticker-wrap::before,.ticker-wrap::after{
  content:'';position:absolute;top:0;bottom:0;width:60px;z-index:2;pointer-events:none;
}
.ticker-wrap::before{left:0;background:linear-gradient(90deg,#080D1C,transparent);}
.ticker-wrap::after{right:0;background:linear-gradient(270deg,#080D1C,transparent);}
.ticker-track{display:flex;gap:40px;animation:scrollTicker 32s linear infinite;padding-left:100%;}
@keyframes scrollTicker{from{transform:translateX(0);}to{transform:translateX(-100%);}}
.tick-item{display:flex;align-items:center;gap:8px;font-family:var(--font-mono);font-size:12.5px;color:var(--muted);flex-shrink:0;}
.tick-live{color:var(--danger);font-weight:700;display:flex;align-items:center;gap:5px;}
.tick-live::before{content:'';width:6px;height:6px;border-radius:50%;background:var(--danger);animation:pulse 1.2s infinite;}
@keyframes pulse{0%,100%{opacity:1;}50%{opacity:.3;}}
.tick-score{color:var(--lime);font-weight:700;}

/* Topbar */
.topbar{
  display:flex;align-items:center;justify-content:space-between;
  padding:16px 28px;border-bottom:1px solid var(--line);
  background:rgba(12,18,36,0.6);backdrop-filter:blur(10px);
}
.topbar h1{font-size:22px;}
.topbar-sub{color:var(--muted);font-size:12.5px;margin-top:2px;font-family:var(--font-body);text-transform:none;letter-spacing:0;}
.search-mini{
  display:flex;align-items:center;gap:8px;background:var(--panel-2);
  border:1px solid var(--line);border-radius:10px;padding:8px 12px;width:280px;
}
.search-mini input{background:transparent;border:none;outline:none;color:var(--text);font-size:13.5px;width:100%;}
.search-mini svg{width:15px;height:15px;color:var(--muted);flex-shrink:0;}

/* Live sync indicator + manual refresh */
.topbar-actions{display:flex;align-items:center;gap:10px;flex-shrink:0;}
.sync-status{
  display:flex;align-items:center;gap:7px;
  font-family:var(--font-mono);font-size:11.5px;color:var(--mint);
  padding:7px 12px;border-radius:100px;
  background:rgba(52,211,153,0.1);border:1px solid rgba(52,211,153,0.25);
  white-space:nowrap;transition:color .2s,background .2s,border-color .2s;
}
.sync-dot{width:7px;height:7px;border-radius:50%;background:var(--mint);box-shadow:0 0 8px var(--mint);animation:pulse 1.6s infinite;flex-shrink:0;}
.sync-status.syncing{color:var(--lime);background:rgba(76,141,255,0.1);border-color:rgba(76,141,255,0.25);}
.sync-status.syncing .sync-dot{background:var(--lime);box-shadow:0 0 8px var(--lime);}
.sync-status.offline{color:var(--muted-2);background:var(--panel-2);border-color:var(--line);}
.sync-status.offline .sync-dot{background:var(--muted-2);box-shadow:none;animation:none;}
.refresh-btn{
  display:flex;align-items:center;justify-content:center;
  width:36px;height:36px;border-radius:10px;flex-shrink:0;
  background:var(--panel-2);border:1px solid var(--line);color:var(--muted);
  transition:border-color .15s,color .15s;
}
.refresh-btn:hover{border-color:var(--lime);color:var(--lime);}
.refresh-btn svg{width:16px;height:16px;display:block;}
.refresh-btn.spinning svg{animation:spinIcon .7s linear infinite;}
@keyframes spinIcon{from{transform:rotate(0deg);}to{transform:rotate(360deg);}}
@media(max-width:640px){.sync-status span:last-child{display:none;} .sync-status{padding:7px 9px;}}

.content{padding:26px 28px 60px;flex:1;}
.screen{display:none;animation:fadeIn .35s ease;}
.screen.active{display:block;}
@keyframes fadeIn{from{opacity:0;transform:translateY(6px);}to{opacity:1;transform:translateY(0);}}

/* Glass card */
.card{
  background:linear-gradient(180deg, rgba(18,26,51,0.9), rgba(12,18,36,0.7));
  border:1px solid var(--line);
  border-radius:var(--radius);
  padding:20px;
  backdrop-filter:blur(6px);
}
.card:hover{border-color:#2A3358;}

/* Grid utilities */
.grid{display:grid;gap:16px;}
.grid-4{grid-template-columns:repeat(4,1fr);}
.grid-3{grid-template-columns:repeat(3,1fr);}
.grid-2{grid-template-columns:repeat(2,1fr);}
@media(max-width:1100px){.grid-4{grid-template-columns:repeat(2,1fr);}.grid-3{grid-template-columns:repeat(2,1fr);}}
@media(max-width:640px){.grid-4,.grid-3,.grid-2{grid-template-columns:1fr;}}

/* Stat card */
.stat-card{display:flex;flex-direction:column;gap:6px;}
.stat-top{display:flex;justify-content:space-between;align-items:flex-start;}
.stat-icon{width:36px;height:36px;border-radius:10px;display:flex;align-items:center;justify-content:center;}
.stat-icon svg{width:18px;height:18px;}
.stat-label{color:var(--muted);font-size:12.5px;font-weight:500;}
.stat-value{font-family:var(--font-display);font-size:30px;font-weight:700;letter-spacing:0.01em;}
.stat-delta{font-size:11.5px;font-family:var(--font-mono);}
.up{color:var(--mint);}
.down{color:var(--danger);}

.section-head{display:flex;align-items:center;justify-content:space-between;margin:30px 0 14px;}
.section-head h2{font-size:16px;color:var(--text);}
.section-head .view-all{font-size:12px;color:var(--lime);font-weight:600;text-transform:uppercase;letter-spacing:.04em;}

/* Buttons */
.btn{
  display:inline-flex;align-items:center;justify-content:center;gap:8px;
  padding:11px 20px;border-radius:11px;font-weight:600;font-size:14px;
  transition:transform .12s, box-shadow .12s, background .12s;
}
.btn-primary{background:linear-gradient(90deg,var(--lime),var(--purple),var(--pink));color:#fff;box-shadow:0 4px 20px rgba(168,85,247,0.25);}
.btn-primary:hover{transform:translateY(-1px);box-shadow:0 6px 28px rgba(168,85,247,0.4);}
.btn-ghost{background:var(--panel-2);color:var(--text);border:1px solid var(--line);}
.btn-ghost:hover{border-color:var(--lime);color:var(--lime);}
.btn-outline-mint{background:transparent;border:1px solid rgba(52,211,153,0.4);color:var(--mint);}
.btn-sm{padding:7px 13px;font-size:12.5px;border-radius:9px;}
.btn-block{width:100%;}
.btn:disabled{opacity:.4;cursor:not-allowed;}

/* Badge / pill */
.pill{display:inline-flex;align-items:center;gap:5px;padding:4px 10px;border-radius:100px;font-size:11px;font-weight:700;text-transform:uppercase;letter-spacing:.04em;}
.pill-live{background:rgba(255,77,109,0.14);color:var(--danger);}
.pill-live::before{content:'';width:6px;height:6px;border-radius:50%;background:var(--danger);animation:pulse 1.2s infinite;}
.pill-upcoming{background:rgba(52,211,153,0.12);color:var(--mint);}
.pill-done{background:rgba(168,85,247,0.14);color:var(--purple);}
.pill-lime{background:rgba(76,141,255,0.14);color:var(--lime);}

/* ---------- Welcome / Auth (full screen, no sidebar) ---------- */
.gate{
  min-height:100vh;width:100%;display:flex;align-items:center;justify-content:center;
  position:relative;overflow:hidden;padding:20px;
}
.gate-bg{
  position:absolute;inset:0;z-index:0;
  background:
    radial-gradient(circle 500px at 20% 20%, rgba(76,141,255,0.12), transparent 60%),
    radial-gradient(circle 500px at 85% 80%, rgba(236,72,153,0.10), transparent 60%),
    radial-gradient(circle 600px at 50% 100%, rgba(168,85,247,0.08), transparent 60%);
}
.gate-grid-lines{
  position:absolute;inset:0;z-index:0;opacity:.35;
  background-image:linear-gradient(var(--line) 1px, transparent 1px), linear-gradient(90deg, var(--line) 1px, transparent 1px);
  background-size:42px 42px;
  mask-image:radial-gradient(ellipse 70% 60% at 50% 40%, black, transparent);
}
.gate-inner{position:relative;z-index:1;width:100%;max-width:430px;text-align:center;}
.gate-badge{
  width:64px;height:64px;border-radius:16px;margin:0 auto 18px;
  background:linear-gradient(135deg,var(--lime),var(--purple),var(--pink));
  display:flex;align-items:center;justify-content:center;font-family:var(--font-display);
  font-weight:700;font-size:28px;color:#fff;box-shadow:0 0 40px rgba(168,85,247,0.35);
}
.gate-title{font-size:38px;font-weight:700;line-height:1;}
.gate-title span{
  background:linear-gradient(90deg,var(--lime),var(--purple),var(--pink));
  -webkit-background-clip:text;background-clip:text;color:transparent;
}
.gate-sub{color:var(--muted);font-size:14px;margin-top:10px;font-family:var(--font-body);text-transform:none;letter-spacing:0;max-width:340px;margin-left:auto;margin-right:auto;}
.gate-actions{display:flex;flex-direction:column;gap:12px;margin-top:32px;}
.gate-admin-link{margin-top:22px;font-size:12px;color:var(--muted-2);}
.gate-admin-link button{color:var(--muted);text-decoration:underline;text-underline-offset:3px;background:none;font-size:12px;}
.gate-admin-link button:hover{color:var(--lime);}

.auth-card{
  position:relative;z-index:1;width:100%;max-width:420px;text-align:left;
  padding:30px 28px;
}
.auth-head{margin-bottom:22px;}
.auth-head h2{font-size:24px;}
.auth-head p{color:var(--muted);font-size:13px;margin-top:5px;font-family:var(--font-body);text-transform:none;letter-spacing:0;}
.field{margin-bottom:14px;}
.field label{display:block;font-size:12px;color:var(--muted);margin-bottom:6px;font-weight:600;text-transform:uppercase;letter-spacing:.03em;}
.field input, .field select{
  width:100%;background:var(--panel-2);border:1px solid var(--line);border-radius:10px;
  padding:11px 13px;color:var(--text);font-size:14px;outline:none;transition:border-color .15s;
}
.field input:focus, .field select:focus{border-color:var(--lime);}
.field-row{display:grid;grid-template-columns:1fr 1fr;gap:12px;}

/* ---------- CALENDAR-STYLE DATE PICKER (Tournament Generator: Start/End Date) ---------- */
.datefield{position:relative;}
.datefield-display{
  width:100%;background:var(--panel-2);border:1px solid var(--line);border-radius:10px;
  padding:11px 13px;color:var(--text);font-size:14px;outline:none;transition:border-color .15s;
  cursor:pointer;display:flex;align-items:center;justify-content:space-between;gap:8px;user-select:none;
}
.datefield-display:hover{border-color:var(--muted-2);}
.datefield-display.open{border-color:var(--lime);}
.datefield-display.disabled{cursor:not-allowed;opacity:.5;}
.datefield-display span.ph{color:var(--muted-2);}
.datefield-display svg{width:15px;height:15px;color:var(--muted);flex-shrink:0;}
.cal-popup{
  display:none;position:absolute;top:calc(100% + 6px);left:0;z-index:50;width:260px;
  background:var(--panel);border:1px solid var(--line);border-radius:12px;padding:12px;
  box-shadow:0 14px 40px rgba(0,0,0,0.45);
}
.cal-popup.open{display:block;}
.cal-head{display:flex;align-items:center;justify-content:space-between;margin-bottom:10px;}
.cal-head-label{font-family:var(--font-display);font-size:13.5px;letter-spacing:.03em;text-transform:uppercase;color:var(--text);}
.cal-nav{
  width:26px;height:26px;border-radius:8px;background:var(--panel-2);border:1px solid var(--line);
  color:var(--muted);display:flex;align-items:center;justify-content:center;font-size:13px;flex-shrink:0;
}
.cal-nav:hover:not(:disabled){border-color:var(--lime);color:var(--lime);}
.cal-nav:disabled{opacity:.3;cursor:not-allowed;}
.cal-dow{display:grid;grid-template-columns:repeat(7,1fr);gap:2px;margin-bottom:4px;}
.cal-dow span{font-size:10px;color:var(--muted-2);text-align:center;font-weight:700;text-transform:uppercase;}
.cal-grid{display:grid;grid-template-columns:repeat(7,1fr);gap:2px;}
.cal-day{
  aspect-ratio:1;border-radius:8px;display:flex;align-items:center;justify-content:center;
  font-size:12.5px;color:var(--text);background:transparent;cursor:pointer;
}
.cal-day:hover:not(:disabled){background:var(--panel-2);}
.cal-day.muted{color:var(--muted-2);}
.cal-day.today{border:1px solid var(--lime);}
.cal-day.selected{background:var(--lime);color:#070B16;font-weight:700;}
.cal-day:disabled{color:var(--muted-2);cursor:not-allowed;opacity:.35;background:transparent;}
.cal-end-hint{font-size:11px;color:var(--muted);margin-top:8px;text-align:center;text-transform:none;}

.role-select{display:grid;grid-template-columns:repeat(2,1fr);gap:8px;margin-bottom:16px;}
.role-opt{
  border:1px solid var(--line);background:var(--panel-2);border-radius:10px;
  padding:10px 6px;text-align:center;font-size:11.5px;font-weight:600;color:var(--muted);
}
.role-opt.selected{border-color:var(--lime);color:var(--lime);background:rgba(76,141,255,0.08);}
.photo-drop{
  border:1.5px dashed var(--line);border-radius:12px;padding:18px;text-align:center;
  color:var(--muted-2);font-size:12.5px;margin-bottom:14px;position:relative;cursor:pointer;
  display:flex;flex-direction:column;align-items:center;gap:8px;transition:border-color .15s, background .15s;
}
.photo-drop:hover{border-color:var(--lime);color:var(--lime);}
.photo-drop input[type="file"]{position:absolute;inset:0;opacity:0;cursor:pointer;width:100%;height:100%;}
.photo-drop .photo-preview{width:64px;height:64px;border-radius:12px;object-fit:cover;display:none;border:1px solid var(--line);}
.photo-drop .photo-drop-text{font-size:12.5px;}
.photo-drop .photo-drop-filename{color:var(--lime);font-weight:600;font-size:12px;word-break:break-all;}
.auth-switch{text-align:center;margin-top:16px;font-size:13px;color:var(--muted);}
.auth-switch button{color:var(--lime);font-weight:600;background:none;}
.back-link{display:inline-flex;align-items:center;gap:6px;color:var(--muted);font-size:12.5px;margin-bottom:16px;background:none;}
.back-link:hover{color:var(--lime);}
.error-msg{
  background:rgba(255,77,109,0.1);border:1px solid rgba(255,77,109,0.3);color:var(--danger);
  padding:9px 12px;border-radius:9px;font-size:12.5px;margin-bottom:14px;display:none;
}
.info-msg{
  background:rgba(52,211,153,0.08);border:1px solid rgba(52,211,153,0.3);color:var(--mint);
  padding:9px 12px;border-radius:9px;font-size:12.5px;margin-bottom:14px;display:none;
}
.demo-hint{font-size:11.5px;color:var(--muted-2);margin-top:12px;text-align:center;font-family:var(--font-mono);}

/* Bracket */
.bracket-scroll{overflow-x:auto;padding-bottom:14px;}
.bracket{display:flex;gap:46px;min-width:900px;padding:10px 4px;}
.bracket-round{display:flex;flex-direction:column;justify-content:space-around;gap:22px;min-width:200px;}
.round-title{font-size:11px;color:var(--muted);text-transform:uppercase;letter-spacing:.08em;text-align:center;margin-bottom:6px;font-weight:700;}
.matchup{background:var(--panel-2);border:1px solid var(--line);border-radius:11px;overflow:hidden;position:relative;}
.matchup.champion{border-color:var(--lime);box-shadow:0 0 22px rgba(76,141,255,0.15);}
.mrow{display:flex;justify-content:space-between;align-items:center;padding:9px 12px;font-size:13px;border-bottom:1px solid var(--line);}
.mrow:last-child{border-bottom:none;}
.mrow.winner{color:var(--lime);font-weight:700;}
.mrow .score{font-family:var(--font-mono);font-weight:700;}
.mrow .team-name{display:flex;align-items:center;gap:8px;overflow:hidden;text-overflow:ellipsis;white-space:nowrap;}
.mseed{color:var(--muted-2);font-size:10.5px;width:16px;}

/* Table */
.table-wrap{overflow-x:auto;}
table{width:100%;border-collapse:collapse;font-size:13.5px;}
th{text-align:left;color:var(--muted);font-size:11px;text-transform:uppercase;letter-spacing:.05em;font-weight:600;padding:10px 14px;border-bottom:1px solid var(--line);}
td{padding:12px 14px;border-bottom:1px solid var(--line);color:var(--text);}
tr:last-child td{border-bottom:none;}
tr:hover td{background:rgba(76,141,255,0.03);}
.rank-1{color:var(--lime);font-weight:700;}
.team-cell{display:flex;align-items:center;gap:10px;}
.team-logo{width:26px;height:26px;border-radius:7px;display:flex;align-items:center;justify-content:center;font-size:11px;font-weight:700;color:#070B16;flex-shrink:0;}

/* Tabs / filters */
.tabs{display:flex;gap:6px;margin-bottom:18px;flex-wrap:wrap;}
.tab-btn{padding:8px 16px;border-radius:9px;background:var(--panel-2);border:1px solid var(--line);color:var(--muted);font-size:13px;font-weight:600;}
.tab-btn.active{background:var(--lime);color:#fff;border-color:var(--lime);}

/* Player/team cards */
.player-card{display:flex;gap:14px;align-items:center;}
.avatar{
  width:52px;height:52px;border-radius:12px;flex-shrink:0;
  background:linear-gradient(135deg,var(--lime),var(--purple));
  display:flex;align-items:center;justify-content:center;font-family:var(--font-display);font-weight:700;color:#fff;font-size:18px;
  overflow:hidden;
}
.avatar img{width:100%;height:100%;object-fit:cover;}
.player-meta{flex:1;min-width:0;}
.player-name{font-weight:600;font-size:14.5px;}
.player-sub{color:var(--muted);font-size:12px;margin-top:2px;}
.player-stats-row{display:flex;gap:16px;margin-top:10px;}
.pstat{text-align:center;}
.pstat b{display:block;font-family:var(--font-mono);color:var(--lime);font-size:15px;}
.pstat span{font-size:10px;color:var(--muted);text-transform:uppercase;}

/* Schedule list */
.sched-item{display:flex;align-items:center;gap:16px;padding:14px 0;border-bottom:1px solid var(--line);flex-wrap:wrap;}
.sched-item:last-child{border-bottom:none;}
.sched-time{width:64px;flex-shrink:0;font-family:var(--font-mono);color:var(--lime);font-size:13px;text-align:center;}
.sched-date{display:block;font-family:var(--font-body);color:var(--muted-2);font-size:10px;margin-top:3px;font-weight:500;}
.sched-vs{flex:1;display:flex;align-items:center;gap:10px;font-size:14px;font-weight:600;min-width:200px;}
.sched-venue{color:var(--muted);font-size:12px;width:140px;flex-shrink:0;}
.sched-actions{display:flex;gap:6px;flex-shrink:0;}
.sched-edit-row{display:grid;grid-template-columns:150px 90px 110px 1fr 1fr 1fr 120px auto;gap:8px;align-items:center;width:100%;padding:12px 0;border-bottom:1px solid var(--line);}
.sched-edit-row:last-child{border-bottom:none;}
.sched-edit-row input, .sched-edit-row select{
  background:var(--panel-2);border:1px solid var(--line);border-radius:8px;padding:8px 9px;color:var(--text);font-size:12.5px;outline:none;width:100%;
}
.sched-edit-row input:focus, .sched-edit-row select:focus{border-color:var(--lime);}
@media(max-width:900px){.sched-edit-row{grid-template-columns:1fr 1fr;}}
.sched-block{border-bottom:1px solid var(--line);padding:4px 0;}
.sched-block:last-child{border-bottom:none;}
.sched-block .sched-item{border-bottom:none;}
.sched-score{font-family:var(--font-mono);color:var(--lime);font-weight:700;flex-shrink:0;}
.sched-result-row{display:flex;align-items:center;gap:8px;padding:0 0 10px 64px;flex-wrap:wrap;}
.sched-result-row .standings-edit-input{width:64px;}
.sched-result-label{font-size:11px;color:var(--muted-2);text-transform:uppercase;letter-spacing:.04em;font-weight:600;}

/* Generator */
.gen-steps{display:flex;gap:8px;margin-bottom:22px;}
.gen-step{flex:1;height:4px;border-radius:3px;background:var(--line);}
.gen-step.done{background:var(--lime);}
.format-grid{display:grid;grid-template-columns:repeat(2,1fr);gap:12px;}
@media(max-width:700px){.format-grid{grid-template-columns:1fr;}}
.format-opt{
  border:1px solid var(--line);background:var(--panel-2);border-radius:12px;padding:16px;cursor:pointer;
}
.format-opt.selected{border-color:var(--lime);background:rgba(76,141,255,0.06);}
.format-opt h3{font-size:14px;color:var(--text);margin-bottom:6px;}
.format-opt p{font-size:12px;color:var(--muted);font-family:var(--font-body);text-transform:none;letter-spacing:0;line-height:1.5;}

/* Mobile bottom nav — only shown once inside the app (after View Full Live Hub / Register+login / etc.), never on the public gate screens */
.mobile-nav{display:none;}
@media(max-width:880px){
  .sidebar{display:none;}
  body.app-entered .mobile-nav{
    display:flex;position:fixed;bottom:0;left:0;right:0;z-index:50;
    background:rgba(12,18,36,0.95);backdrop-filter:blur(10px);border-top:1px solid var(--line);
    padding:8px 6px calc(8px + env(safe-area-inset-bottom));
  }
  .mnav-item{flex:1;display:flex;flex-direction:column;align-items:center;gap:3px;padding:6px 2px;color:var(--muted);font-size:10px;font-weight:600;background:none;}
  .mnav-item svg{width:19px;height:19px;}
  .mnav-item.active{color:var(--lime);}
  body.app-entered .content{padding-bottom:90px;}
  .search-mini{width:150px;}
  .topbar h1{font-size:18px;}
}

.toast{
  position:fixed;bottom:24px;right:24px;z-index:200;
  background:var(--panel-2);border:1px solid var(--lime);color:var(--text);
  padding:13px 18px;border-radius:11px;font-size:13.5px;box-shadow:0 8px 30px rgba(0,0,0,0.4);
  display:flex;align-items:center;gap:10px;transform:translateY(120%);opacity:0;transition:transform .3s, opacity .3s;
}
.toast.show{transform:translateY(0);opacity:1;}
@media(max-width:880px){.toast{bottom:80px;right:14px;left:14px;}}

.divider-text{display:flex;align-items:center;gap:10px;color:var(--muted-2);font-size:11px;margin:16px 0;text-transform:uppercase;letter-spacing:.06em;}
.divider-text::before,.divider-text::after{content:'';flex:1;height:1px;background:var(--line);}

/* ---------- Landing (public live view) ---------- */
.landing-inner{position:relative;z-index:1;width:100%;max-width:760px;text-align:center;}
.landing-header{margin-bottom:26px;}
.landing-live-panel{text-align:left;margin-bottom:22px;}
.landing-live-panel .section-head{margin:0 0 14px;}
.landing-ticker-wrap{
  background:#080D1C;border:1px solid var(--line);border-radius:11px;
  overflow:hidden;white-space:nowrap;position:relative;height:36px;display:flex;align-items:center;margin-bottom:16px;
}
.landing-ticker-wrap::before,.landing-ticker-wrap::after{
  content:'';position:absolute;top:0;bottom:0;width:50px;z-index:2;pointer-events:none;
}
.landing-ticker-wrap::before{left:0;background:linear-gradient(90deg,#080D1C,transparent);}
.landing-ticker-wrap::after{right:0;background:linear-gradient(270deg,#080D1C,transparent);}
.landing-cta{display:flex;flex-direction:column;gap:12px;max-width:420px;margin:0 auto;}
.landing-cta-row{display:flex;gap:12px;}
@media(max-width:520px){.landing-cta-row{flex-direction:column;}}

/* Toggle switch */
.toggle-row{display:flex;align-items:center;gap:12px;margin-bottom:18px;}
.switch{position:relative;display:inline-block;width:42px;height:24px;flex-shrink:0;}
.switch input{opacity:0;width:0;height:0;}
.switch-track{position:absolute;cursor:pointer;inset:0;background:var(--panel-2);border:1px solid var(--line);border-radius:24px;transition:.2s;}
.switch-track::before{position:absolute;content:'';height:16px;width:16px;left:3px;top:2.5px;background:var(--muted);border-radius:50%;transition:.2s;}
.switch input:checked + .switch-track{background:rgba(76,141,255,0.18);border-color:var(--lime);}
.switch input:checked + .switch-track::before{transform:translateX(18px);background:var(--lime);}
.toggle-label{font-size:13.5px;}
.toggle-label small{display:block;color:var(--muted);font-size:11.5px;margin-top:2px;font-weight:400;}

/* Registrations / Directory */
.reg-row{display:flex;align-items:center;justify-content:space-between;gap:14px;padding:14px 0;border-bottom:1px solid var(--line);}
.reg-row:last-child{border-bottom:none;}
.reg-meta{display:flex;align-items:center;gap:12px;min-width:0;}
.reg-info{min-width:0;}
.reg-info .name{font-weight:600;font-size:14px;}
.reg-info .sub{color:var(--muted);font-size:12px;margin-top:2px;}
.reg-contact{color:var(--muted);font-size:12px;font-family:var(--font-mono);}
.reg-contact.hidden-info{color:var(--muted-2);font-style:italic;font-family:var(--font-body);}
.btn-danger{background:rgba(255,77,109,0.12);color:var(--danger);border:1px solid rgba(255,77,109,0.3);}
.btn-danger:hover{background:rgba(255,77,109,0.2);}
.role-tag{padding:3px 9px;border-radius:100px;font-size:10.5px;font-weight:700;text-transform:uppercase;letter-spacing:.03em;background:rgba(52,211,153,0.12);color:var(--mint);flex-shrink:0;}

.announce{display:flex;gap:12px;padding:12px 0;border-bottom:1px solid var(--line);}
.announce:last-child{border-bottom:none;}
.announce-dot{width:8px;height:8px;border-radius:50%;background:var(--lime);margin-top:6px;flex-shrink:0;}
.announce b{font-size:13.5px;}
.announce p{font-size:12px;color:var(--muted);margin-top:3px;font-family:var(--font-body);text-transform:none;letter-spacing:0;}
.announce-row-del{
  margin-left:auto;flex-shrink:0;align-self:flex-start;
}

/* Standings edit */
.standings-edit-input{
  width:56px;background:var(--panel-2);border:1px solid var(--line);border-radius:7px;
  padding:6px 7px;color:var(--text);font-size:12.5px;outline:none;font-family:var(--font-mono);text-align:center;
}
.standings-edit-input:focus{border-color:var(--lime);}
.standings-team-input{
  width:100%;min-width:140px;background:var(--panel-2);border:1px solid var(--line);border-radius:7px;
  padding:7px 9px;color:var(--text);font-size:13px;outline:none;
}
.standings-team-input:focus{border-color:var(--lime);}
.th-actions{width:110px;}

/* ---------- LIVE VIEWER (new — separate full-screen overlay, opened by clicking a LIVE match card) ---------- */
.live-clickable{cursor:pointer;transition:border-color .15s, transform .15s;}
.live-clickable:hover{border-color:var(--danger);transform:translateY(-2px);}
.live-viewer-overlay{
  display:none;position:fixed;inset:0;z-index:500;background:var(--bg);
  overflow-y:auto;
}
.live-viewer-overlay.open{display:block;}
.live-viewer-top{
  display:flex;align-items:center;justify-content:space-between;
  padding:16px 22px;border-bottom:1px solid var(--line);
  background:rgba(12,18,36,0.7);backdrop-filter:blur(10px);
  position:sticky;top:0;z-index:2;
}
.live-viewer-top-left{display:flex;align-items:center;gap:12px;}
.live-viewer-close{
  background:var(--panel-2);border:1px solid var(--line);color:var(--text);
  width:36px;height:36px;border-radius:10px;display:flex;align-items:center;justify-content:center;
  font-size:18px;line-height:1;
}
.live-viewer-close:hover{border-color:var(--danger);color:var(--danger);}
.live-viewer-body{
  display:flex;gap:0;min-height:calc(100vh - 69px);
}
@media(max-width:900px){.live-viewer-body{flex-direction:column;}}
.live-viewer-main{
  flex:1;min-width:0;display:flex;flex-direction:column;align-items:center;justify-content:center;
  padding:40px 24px;position:relative;
}
.live-stage{
  width:100%;max-width:820px;aspect-ratio:16/9;border-radius:18px;
  background:
    radial-gradient(ellipse 500px 300px at 30% 20%, rgba(255,77,109,0.10), transparent 60%),
    radial-gradient(ellipse 500px 300px at 80% 80%, rgba(52,211,153,0.08), transparent 60%),
    linear-gradient(160deg,#080D1C,#121A33 60%,#080D1C);
  border:1px solid var(--line);
  display:flex;flex-direction:column;align-items:center;justify-content:center;gap:14px;
  position:relative;overflow:hidden;
}
.live-stage-badge{position:absolute;top:16px;left:16px;}
.live-stage-play{
  width:70px;height:70px;border-radius:50%;background:rgba(255,255,255,0.08);
  border:1.5px solid rgba(255,255,255,0.25);display:flex;align-items:center;justify-content:center;
  font-size:26px;color:var(--text);
}
.live-stage-label{font-family:var(--font-display);text-transform:uppercase;letter-spacing:.08em;color:var(--muted);font-size:13px;}
.live-stage-teams{margin-top:6px;text-align:center;}
.live-stage-team{font-family:var(--font-display);font-size:22px;font-weight:700;letter-spacing:.02em;}
.live-stage-score{font-family:var(--font-mono);font-size:34px;color:var(--lime);font-weight:700;margin:4px 0;}
.live-stage-preview{color:var(--muted-2);font-size:11.5px;font-family:var(--font-mono);text-transform:uppercase;letter-spacing:.08em;margin-top:6px;}
.live-meta-row{display:flex;align-items:center;gap:14px;margin-top:18px;color:var(--muted);font-size:13px;font-family:var(--font-mono);flex-wrap:wrap;justify-content:center;}

.live-chat{
  width:340px;flex-shrink:0;border-left:1px solid var(--line);
  display:flex;flex-direction:column;background:rgba(12,18,36,0.4);
  max-height:calc(100vh - 69px);
}
@media(max-width:900px){.live-chat{width:100%;border-left:none;border-top:1px solid var(--line);max-height:420px;}}
.live-chat-head{padding:16px 18px;border-bottom:1px solid var(--line);font-family:var(--font-display);text-transform:uppercase;letter-spacing:.05em;font-size:14px;}
.live-chat-messages{flex:1;overflow-y:auto;padding:14px 18px;display:flex;flex-direction:column;gap:12px;}
.live-chat-msg .who{font-size:12.5px;font-weight:700;color:var(--mint);}
.live-chat-msg .who.guest{color:var(--lime);}
.live-chat-msg .txt{font-size:13.5px;color:var(--text);margin-top:2px;word-break:break-word;}
.live-chat-input-row{display:flex;gap:8px;padding:14px 18px;border-top:1px solid var(--line);}
.live-chat-input-row input{
  flex:1;background:var(--panel-2);border:1px solid var(--line);border-radius:10px;
  padding:10px 12px;color:var(--text);font-size:13.5px;outline:none;
}
.live-chat-input-row input:focus{border-color:var(--lime);}
.live-chat-send{
  background:var(--lime);color:#070B16;border-radius:10px;padding:0 16px;font-weight:700;font-size:13px;
}

/* ---------- TEAM ROSTER MODAL (new — opened by clicking a team card in Participating Teams / Teams) ---------- */
.team-card-clickable{cursor:pointer;transition:border-color .15s, transform .15s;}
.team-card-clickable:hover{border-color:var(--lime);transform:translateY(-2px);}
.team-roster-overlay{
  display:none;position:fixed;inset:0;z-index:600;background:rgba(4,7,14,0.72);
  backdrop-filter:blur(6px);align-items:center;justify-content:center;padding:20px;
}
.team-roster-overlay.open{display:flex;}
.team-roster-modal{
  background:var(--panel);border:1px solid var(--line);border-radius:var(--radius);
  width:100%;max-width:460px;max-height:85vh;overflow-y:auto;padding:26px;position:relative;
  box-shadow:0 20px 60px rgba(0,0,0,0.5);
}
.team-roster-close{
  position:absolute;top:16px;right:16px;background:var(--panel-2);border:1px solid var(--line);color:var(--text);
  width:32px;height:32px;border-radius:9px;display:flex;align-items:center;justify-content:center;font-size:16px;line-height:1;
}
.team-roster-close:hover{border-color:var(--danger);color:var(--danger);}
.team-roster-coach-box{
  margin:16px 0;padding:12px 14px;background:var(--panel-2);border-radius:10px;border:1px solid var(--line);
}
.team-roster-label{font-size:11px;color:var(--muted-2);text-transform:uppercase;letter-spacing:.06em;font-weight:600;margin-bottom:4px;}

/* ---------- MATCH LIVE-SCORE / QR MODAL (new — opened by admin/official from a Schedule row) ---------- */
.qr-modal-overlay{
  display:none;position:fixed;inset:0;z-index:600;background:rgba(4,7,14,0.72);
  backdrop-filter:blur(6px);align-items:center;justify-content:center;padding:20px;
}
.qr-modal-overlay.open{display:flex;}
.qr-modal{
  background:linear-gradient(180deg, var(--panel) 0%, var(--panel-2) 100%);
  border:1px solid var(--line);border-radius:22px;
  width:100%;max-width:400px;max-height:90vh;overflow-y:auto;padding:28px 26px 24px;position:relative;
  box-shadow:0 24px 70px rgba(0,0,0,0.55), 0 0 0 1px rgba(168,85,247,0.06);text-align:center;
}
.qr-modal::before{
  content:'';position:absolute;top:0;left:0;right:0;height:4px;border-radius:22px 22px 0 0;
  background:linear-gradient(90deg,var(--lime),var(--purple),var(--pink));
}
.qr-modal-close{
  position:absolute;top:16px;right:16px;background:var(--panel-2);border:1px solid var(--line);color:var(--text);
  width:32px;height:32px;border-radius:9px;display:flex;align-items:center;justify-content:center;font-size:16px;line-height:1;
}
.qr-modal-close:hover{border-color:var(--danger);color:var(--danger);}
.qr-modal-badge{
  display:inline-flex;align-items:center;gap:7px;margin-top:2px;
  font-family:var(--font-mono);font-size:10.5px;font-weight:700;letter-spacing:.08em;text-transform:uppercase;
  color:var(--lime);background:rgba(76,141,255,0.12);border:1px solid rgba(76,141,255,0.3);
  padding:5px 12px;border-radius:100px;
}
.qr-modal-badge::before{content:'';width:6px;height:6px;border-radius:50%;background:var(--lime);box-shadow:0 0 8px var(--lime);animation:pulse 1.6s infinite;flex-shrink:0;}
.qr-frame{
  position:relative;width:228px;height:228px;margin:18px auto 4px;border-radius:22px;
  background:linear-gradient(135deg, var(--lime), var(--purple) 55%, var(--pink));padding:4px;
  box-shadow:0 18px 45px -12px rgba(168,85,247,0.5), 0 0 0 1px rgba(255,255,255,0.04);
}
.qr-frame-inner{
  position:relative;width:100%;height:100%;background:#fff;border-radius:18px;
  display:flex;align-items:center;justify-content:center;padding:16px;
}
.qr-modal-img{width:100%;height:100%;display:block;}
.qr-corner{position:absolute;width:22px;height:22px;border:3px solid var(--lime);}
.qr-corner.tl{top:8px;left:8px;border-right:none;border-bottom:none;border-top-left-radius:6px;}
.qr-corner.tr{top:8px;right:8px;border-left:none;border-bottom:none;border-top-right-radius:6px;border-color:var(--purple);}
.qr-corner.bl{bottom:8px;left:8px;border-right:none;border-top:none;border-bottom-left-radius:6px;border-color:var(--purple);}
.qr-corner.br{bottom:8px;right:8px;border-left:none;border-top:none;border-bottom-right-radius:6px;border-color:var(--pink);}
.qr-modal-hint{font-size:12px;color:var(--muted);margin-top:10px;line-height:1.5;padding:0 4px;}
.qr-score-row{display:flex;align-items:center;justify-content:center;gap:12px;margin:16px 0;}
.qr-score-team{flex:1;text-align:center;}
.qr-score-team label{font-size:11px;color:var(--muted-2);text-transform:uppercase;letter-spacing:.05em;font-weight:600;display:block;margin-bottom:6px;}
.qr-score-team input{
  width:100%;text-align:center;font-family:var(--font-mono);font-size:20px;font-weight:700;
  background:var(--panel-2);border:1px solid var(--line);border-radius:10px;color:var(--text);padding:8px;
}
.qr-score-vs{font-family:var(--font-display);color:var(--muted-2);font-size:13px;padding-top:18px;}
.qr-score-team input:disabled{opacity:.6;cursor:not-allowed;border-color:var(--mint);}
.qr-share-row{
  display:flex;align-items:center;gap:8px;background:var(--panel-2);border:1px solid var(--line);
  border-radius:12px;padding:8px 8px 8px 14px;margin-top:16px;text-align:left;
}
.qr-modal-link{
  flex:1;font-family:var(--font-mono);font-size:11px;color:var(--muted);
  overflow:hidden;text-overflow:ellipsis;white-space:nowrap;display:block;min-width:0;
}
.qr-modal-link:hover{color:var(--lime);}
.qr-copy-btn{
  flex-shrink:0;display:flex;align-items:center;gap:6px;
  background:var(--panel);border:1px solid var(--line);color:var(--text);
  padding:8px 13px;border-radius:9px;font-size:12.5px;font-weight:600;
}
.qr-copy-btn:hover{border-color:var(--lime);color:var(--lime);}
.qr-copy-btn svg{width:14px;height:14px;flex-shrink:0;}
</style>
</head>
<body>

<!-- ================= GATE: WELCOME (public — no account needed) ================= -->
<div id="gate-welcome" class="gate">
  <div class="gate-bg"></div><div class="gate-grid-lines"></div>
  <div class="landing-inner">
    <div class="landing-header">
      <div class="gate-badge">TP</div>
      <h1 class="gate-title display">Tournament<span>Pro</span></h1>
      <p class="gate-sub">Live scores from every court, pitch, and arena — open to everyone, no account required.</p>
    </div>

    <div class="card landing-live-panel">
      <div class="landing-ticker-wrap">
        <div class="ticker-track" id="landing-ticker-track"></div>
      </div>
      <div class="section-head"><h2 id="landing-live-title">Live Right Now</h2><span class="pill pill-live">Live</span></div>
      <div class="grid grid-3" id="landing-live-list"></div>
    </div>

    <div class="landing-cta">
      <div class="landing-cta-row">
        <button class="btn btn-primary btn-block" onclick="showGate('gate-register')">Register</button>
        <button class="btn btn-ghost btn-block" onclick="enterApp('spectator')">View Full Live Hub</button>
      </div>
      <div class="landing-cta-row">
        <button class="btn btn-outline-mint btn-block" onclick="showGate('gate-coach')">Coach Login</button>
        <button class="btn btn-outline-mint btn-block" onclick="showGate('gate-official')">Official Login</button>
      </div>
    </div>

    <div class="gate-admin-link"><button onclick="showGate('gate-admin')">Administrator sign in</button></div>
  </div>
</div>

<!-- ================= GATE: ADMIN LOGIN ================= -->
<div id="gate-admin" class="gate" style="display:none;">
  <div class="gate-bg"></div><div class="gate-grid-lines"></div>
  <div class="card auth-card">
    <button class="back-link" onclick="showGate('gate-welcome')">← Back</button>
    <div class="auth-head">
      <h2 class="display">Admin Access</h2>
      <p>Restricted to tournament administrators only.</p>
    </div>
    <div id="admin-error" class="error-msg">Invalid email or password. Try again.</div>
    <div class="field">
      <label>Email</label>
      <input type="email" id="admin-email" placeholder="admin@gmail.com">
    </div>
    <div class="field">
      <label>Password</label>
      <input type="password" id="admin-pass" placeholder="••••••••">
    </div>
    <button class="btn btn-primary btn-block" onclick="adminLogin()">Sign In to Dashboard</button>
    <p class="demo-hint">Demo credentials — admin@gmail.com / admin123</p>
  </div>
</div>

<!-- ================= GATE: COACH LOGIN ================= -->
<div id="gate-coach" class="gate" style="display:none;">
  <div class="gate-bg"></div><div class="gate-grid-lines"></div>
  <div class="card auth-card">
    <button class="back-link" onclick="showGate('gate-welcome')">← Back</button>
    <div class="auth-head">
      <h2 class="display">Coach Access</h2>
      <p>Sign in to manage your own team's roster and registrations. Your login is created by the administrator once your Coach registration is approved.</p>
    </div>
    <div id="coach-error" class="error-msg">Invalid email or password. Try again.</div>
    <div class="field">
      <label>Email</label>
      <input type="email" id="coach-email" placeholder="you@email.com">
    </div>
    <div class="field">
      <label>Password</label>
      <input type="password" id="coach-pass" placeholder="••••••••">
    </div>
    <button class="btn btn-primary btn-block" onclick="coachLogin()">Sign In to Dashboard</button>
    <div class="auth-switch">Haven't registered yet? <button onclick="showGate('gate-register')">Submit your info</button></div>
  </div>
</div>

<!-- ================= GATE: OFFICIAL LOGIN ================= -->
<div id="gate-official" class="gate" style="display:none;">
  <div class="gate-bg"></div><div class="gate-grid-lines"></div>
  <div class="card auth-card">
    <button class="back-link" onclick="showGate('gate-welcome')">← Back</button>
    <div class="auth-head">
      <h2 class="display">Official Access</h2>
      <p>Sign in to your officiating dashboard. Your login is created by the administrator once your Official registration is approved.</p>
    </div>
    <div id="official-error" class="error-msg">Invalid email or password. Try again.</div>
    <div class="field">
      <label>Email</label>
      <input type="email" id="official-email" placeholder="you@email.com">
    </div>
    <div class="field">
      <label>Password</label>
      <input type="password" id="official-pass" placeholder="••••••••">
    </div>
    <button class="btn btn-primary btn-block" onclick="officialLogin()">Sign In to Dashboard</button>
    <div class="auth-switch">Haven't registered yet? <button onclick="showGate('gate-register')">Submit your info</button></div>
  </div>
</div>

<!-- ================= GATE: REGISTER (Player = info only, no login · Coach & Official = set a password, account created on admin approval) ================= -->
<div id="gate-register" class="gate" style="display:none;">
  <div class="gate-bg"></div><div class="gate-grid-lines"></div>
  <div class="card auth-card">
    <button class="back-link" onclick="showGate('gate-welcome')">← Back</button>
    <div class="auth-head">
      <h2 class="display">Register Your Information</h2>
    </div>
    <div id="register-error" class="error-msg">Please enter your full name and a valid email.</div>
    <label style="display:block;font-size:12px;color:var(--muted);margin-bottom:8px;font-weight:600;text-transform:uppercase;letter-spacing:.03em;">Select your role</label>
    <div class="role-select" id="role-select">
      <button class="role-opt selected" data-role="Player" onclick="pickRole(this)">Player</button>
      <button class="role-opt" data-role="Coach" onclick="pickRole(this)">Coach</button>
      <button class="role-opt" data-role="Official" onclick="pickRole(this)">Official</button>
    </div>
    <div class="field"><label>Full Name</label><input type="text" id="reg-name" placeholder="Juan Dela Cruz"></div>
    <div class="field-row">
      <div class="field"><label>Email</label><input type="email" id="reg-email" placeholder="you@email.com"></div>
      <div class="field"><label>Phone</label><input type="tel" id="reg-phone" placeholder="+63 900 000 0000"></div>
    </div>
    <div class="field-row" id="reg-team-sport-row">
      <div class="field"><label>Team / Organization</label><input type="text" id="reg-team" placeholder="Optional"></div>
      <div class="field">
        <label>Preferred Sport</label>
        <select id="reg-sport">
          <option>Basketball</option><option>Volleyball</option><option>Football</option>
          <option>Futsal</option><option>Badminton</option><option>Tennis</option>
          <option>Table Tennis</option><option>Chess</option><option>Esports</option>
          <option>Baseball</option><option>Softball</option><option>Custom Sport</option>
        </select>
      </div>
    </div>
    <div class="field" id="reg-password-wrap" style="display:none;">
      <label>Create Password</label>
      <input type="password" id="reg-password" placeholder="Minimum 6 characters">
    </div>
    <label class="photo-drop" id="reg-photo-drop">
      <img id="reg-photo-preview" class="photo-preview" alt="Profile photo preview">
      <span class="photo-drop-text" id="reg-photo-text">📷 Upload profile photo (optional)</span>
      <span class="photo-drop-filename" id="reg-photo-filename"></span>
      <input type="file" id="reg-photo-input" accept="image/*" onchange="handlePhotoUpload(this)">
    </label>
    <button class="btn btn-primary btn-block" onclick="registerSubmit()">Submit Registration</button>
    <div class="auth-switch">Already registered? <button onclick="showGate('gate-welcome')">Back to live scores</button></div>
  </div>
</div>

<!-- ================= GATE: PUBLIC LIVE SCORE (opened via a match's QR code / shared link — no login, one match) ================= -->
<div id="gate-public-live" class="gate" style="display:none;">
  <div class="gate-bg"></div><div class="gate-grid-lines"></div>
  <div class="gate-inner">
    <div class="gate-badge">TP</div>
    <p class="topbar-sub" id="public-live-tournament" style="text-transform:none;margin-top:10px;"></p>
    <span class="pill pill-live" id="public-live-status" style="margin-top:8px;display:inline-block;">LIVE</span>

    <div class="qr-score-row" id="public-live-score-row" style="margin-top:20px;">
      <div class="qr-score-team">
        <label id="public-live-team-a">Team A</label>
        <input type="number" id="public-live-score-a" placeholder="—">
      </div>
      <div class="qr-score-vs">VS</div>
      <div class="qr-score-team">
        <label id="public-live-team-b">Team B</label>
        <input type="number" id="public-live-score-b" placeholder="—">
      </div>
    </div>
    <button class="btn btn-primary btn-block" id="public-live-update-btn" style="margin-top:16px;" onclick="savePublicLiveScore()">Update Live Score</button>
    <button class="btn btn-block" id="public-live-end-btn" style="margin-top:10px;background:rgba(52,211,153,0.14);color:var(--mint);border:1px solid rgba(52,211,153,0.35);" onclick="endPublicLiveMatch()">🏁 End Match / Final Score</button>
    <p class="gate-sub" id="public-live-final-note" style="margin-top:10px;display:none;color:var(--mint);"></p>

    <p class="gate-sub" id="public-live-venue" style="margin-top:20px;"></p>
    <div class="gate-admin-link"><button onclick="window.location.search=''">← Back to TournamentPro</button></div>
  </div>
</div>

<!-- ================= APP ================= -->
<div id="app" style="display:none;">
  <aside class="sidebar">
    <div class="brand">
      <div class="brand-badge">TP</div>
      <div class="brand-name">Tournament<span>Pro</span></div>
    </div>

    <div class="nav-group-label">Overview</div>
    <button class="navlink active" data-screen="dashboard" onclick="nav('dashboard')">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="3" y="3" width="7" height="9" rx="1.5"/><rect x="14" y="3" width="7" height="5" rx="1.5"/><rect x="14" y="12" width="7" height="9" rx="1.5"/><rect x="3" y="16" width="7" height="5" rx="1.5"/></svg>
      Dashboard
    </button>
    <button class="navlink" data-screen="tournaments" onclick="nav('tournaments')">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M8 21h8M12 17v4M7 4H4a1 1 0 00-1 1v2a4 4 0 004 4M17 4h3a1 1 0 011 1v2a4 4 0 01-4 4M7 4h10v6a5 5 0 01-10 0V4z"/></svg>
      Tournaments
    </button>
    <button class="navlink" data-screen="bracket" onclick="nav('bracket')">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M4 5h5v4H4zM4 15h5v4H4zM15 10h5v4h-5zM9 7h3v6h-3zM12 10h3M9 17h3v-6"/></svg>
      Bracket
    </button>
    <button class="navlink" data-screen="schedule" onclick="nav('schedule')">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="3" y="4" width="18" height="17" rx="2"/><path d="M16 2v4M8 2v4M3 10h18"/></svg>
      Schedule
    </button>
    <button class="navlink" data-screen="standings" onclick="nav('standings')">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M3 3v18h18M7 16v-6M12 16V6M17 16v-3"/></svg>
      Standings
    </button>
    <button class="navlink" data-screen="search" onclick="nav('search')">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="11" cy="11" r="7"/><path d="M21 21l-4.35-4.35"/></svg>
      Player Search
    </button>
    <div class="nav-group-label" id="admin-nav-label" style="display:none;">Admin</div>
    <button class="navlink" id="admin-nav-registrations" style="display:none;" data-screen="registrations" onclick="nav('registrations')">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M16 4h2a2 2 0 012 2v14a2 2 0 01-2 2H6a2 2 0 01-2-2V6a2 2 0 012-2h2"/><rect x="8" y="2" width="8" height="4" rx="1"/><path d="M9 12l2 2 4-4"/></svg>
      Registrations
      <span class="nav-badge" id="admin-registrations-badge" style="display:none;">0</span>
    </button>
    <button class="navlink" id="admin-nav-teams" style="display:none;" data-screen="teams" onclick="nav('teams')">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="9" cy="7" r="4"/><path d="M2 21v-2a4 4 0 014-4h6a4 4 0 014 4v2"/><circle cx="19" cy="8" r="3"/><path d="M17 21v-2a4 4 0 00-1-2.6"/></svg>
      Teams
    </button>
    <button class="navlink" id="admin-nav-notifications" style="display:none;" data-screen="notifications" onclick="nav('notifications')">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M18 8a6 6 0 00-12 0c0 7-3 9-3 9h18s-3-2-3-9"/><path d="M13.73 21a2 2 0 01-3.46 0"/></svg>
      Notifications
    </button>
    <button class="navlink" id="admin-nav-generator" style="display:none;" data-screen="generator" onclick="nav('generator')">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M12 3v3M12 18v3M4.2 4.2l2.1 2.1M17.7 17.7l2.1 2.1M3 12h3M18 12h3M4.2 19.8l2.1-2.1M17.7 6.3l2.1-2.1"/><circle cx="12" cy="12" r="4"/></svg>
      Generator
    </button>
    <button class="navlink" id="admin-nav-auditlog" style="display:none;" data-screen="auditlog" onclick="nav('auditlog')">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M9 12h6M9 16h6M9 8h6M5 4h14a1 1 0 011 1v15l-3-2-3 2-3-2-3 2-3-2-3 2V5a1 1 0 011-1z"/></svg>
      Audit Log
    </button>
    <button class="navlink" id="admin-nav-reports" style="display:none;" data-screen="reports" onclick="nav('reports')">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M14 3v5h5M6 3h8l6 6v11a1 1 0 01-1 1H6a1 1 0 01-1-1V4a1 1 0 011-1z"/><path d="M9 13h6M9 17h6M9 9h1"/></svg>
      Reports
    </button>

    <div class="nav-group-label" id="coach-nav-label" style="display:none;">Coach</div>
    <button class="navlink" id="coach-nav-myteam" style="display:none;" data-screen="myteam" onclick="nav('myteam')">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="9" cy="7" r="4"/><path d="M2 21v-2a4 4 0 014-4h6a4 4 0 014 4v2"/><circle cx="19" cy="8" r="3"/><path d="M17 21v-2a4 4 0 00-1-2.6"/></svg>
      My Team
    </button>
    <button class="navlink" id="coach-nav-reports" style="display:none;" data-screen="reports" onclick="nav('reports')">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M14 3v5h5M6 3h8l6 6v11a1 1 0 01-1 1H6a1 1 0 01-1-1V4a1 1 0 011-1z"/><path d="M9 13h6M9 17h6M9 9h1"/></svg>
      Reports
    </button>

    <div class="nav-group-label" id="official-nav-label" style="display:none;">Official</div>
    <button class="navlink" id="official-nav-registrations" style="display:none;" data-screen="registrations" onclick="nav('registrations')">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M16 4h2a2 2 0 012 2v14a2 2 0 01-2 2H6a2 2 0 01-2-2V6a2 2 0 012-2h2"/><rect x="8" y="2" width="8" height="4" rx="1"/><path d="M9 12l2 2 4-4"/></svg>
      Registrations
      <span class="nav-badge" id="official-registrations-badge" style="display:none;">0</span>
    </button>
    <button class="navlink" id="official-nav-schedule" style="display:none;" data-screen="schedule" onclick="nav('schedule')">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="3" y="4" width="18" height="17" rx="2"/><path d="M16 2v4M8 2v4M3 10h18"/></svg>
      My Assignments
    </button>

    <div class="sidebar-foot">
      <div class="role-chip"><span class="role-dot"></span><span id="sidebar-role">Spectator</span></div>
      <button class="logout-btn" onclick="logout()">Log Out</button>
    </div>
  </aside>

  <div class="main">
    <div class="ticker-wrap">
      <div class="ticker-track" id="ticker-track"></div>
    </div>

    <div class="topbar">
      <div>
        <h1 class="display" id="topbar-title">Dashboard</h1>
        <div class="topbar-sub" id="topbar-sub">Welcome back — here's what's happening today</div>
      </div>
      <div class="topbar-actions">
        <div class="sync-status syncing" id="sync-status" title="Real-time sync with Firebase — new registrations and other updates appear automatically">
          <span class="sync-dot" id="sync-dot"></span>
          <span id="sync-status-text">Connecting…</span>
        </div>
        <button class="refresh-btn" id="refresh-btn" onclick="manualRefresh()" title="Refresh now">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M23 4v6h-6"/><path d="M1 20v-6h6"/><path d="M3.51 9a9 9 0 0114.85-3.36L23 10M1 14l4.64 4.36A9 9 0 0020.49 15"/></svg>
        </button>
      </div>
    </div>

    <div class="content">

      <!-- ===== DASHBOARD ===== -->
      <section class="screen active" id="screen-dashboard">
        <div class="grid grid-4" id="dashboard-stats-grid">
          <div class="card stat-card">
            <div class="stat-top"><span class="stat-label">Active Tournaments</span>
              <div class="stat-icon" style="background:rgba(76,141,255,0.12);color:var(--lime);"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M8 21h8M12 17v4M7 4H4a1 1 0 00-1 1v2a4 4 0 004 4M17 4h3a1 1 0 011 1v2a4 4 0 01-4 4M7 4h10v6a5 5 0 01-10 0V4z"/></svg></div>
            </div>
            <div class="stat-value mono">6</div><div class="stat-delta up">▲ 2 this week</div>
          </div>
          <div class="card stat-card">
            <div class="stat-top"><span class="stat-label">Registered Teams</span>
              <div class="stat-icon" style="background:rgba(52,211,153,0.12);color:var(--mint);"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="9" cy="7" r="4"/><path d="M2 21v-2a4 4 0 014-4h6a4 4 0 014 4v2"/><circle cx="19" cy="8" r="3"/><path d="M17 21v-2a4 4 0 00-1-2.6"/></svg></div>
            </div>
            <div class="stat-value mono">48</div><div class="stat-delta up">▲ 5 new</div>
          </div>
          <div class="card stat-card">
            <div class="stat-top"><span class="stat-label">Matches Today</span>
              <div class="stat-icon" style="background:rgba(255,77,109,0.12);color:var(--danger);"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="9"/><path d="M12 7v5l3 3"/></svg></div>
            </div>
            <div class="stat-value mono">9</div><div class="stat-delta" style="color:var(--danger);">3 live now</div>
          </div>
          <div class="card stat-card">
            <div class="stat-top"><span class="stat-label">Total Players</span>
              <div class="stat-icon" style="background:rgba(76,141,255,0.12);color:var(--lime);"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="8" r="4"/><path d="M4 21v-2a6 6 0 0112 0v2"/></svg></div>
            </div>
            <div class="stat-value mono">612</div><div class="stat-delta up">▲ 34 new</div>
          </div>
        </div>

        <div class="section-head"><h2>Today's Matches</h2><a class="view-all" onclick="nav('schedule')">View schedule →</a></div>
        <div class="grid grid-3" id="today-matches"></div>

        <div class="section-head"><h2>Current Tournaments</h2><a class="view-all" onclick="nav('tournaments')">View all →</a></div>
        <div class="grid grid-3" id="dash-tournaments"></div>

        <div class="grid grid-2" style="margin-top:30px;">
          <div class="card">
            <h2 style="font-size:15px;margin-bottom:6px;">Announcements</h2>
            <div id="announce-list"></div>
          </div>
          <div class="card">
            <h2 style="font-size:15px;margin-bottom:6px;">Quick Stats — Basketball Leaders</h2>
            <div id="quick-stats"></div>
          </div>
        </div>

        <!-- Live feed of what Admin / the assigned Official just did to a tournament (bracket
             generated, schedule generated, match added/edited, score updated, standings changed,
             etc). Sourced from the same real-time-synced auditLog collection the Admin's Audit Log
             screen uses, filtered down to tournament-facing items only (registration/account
             approvals stay admin-only). Visible to every role, so Spectator/Coach/Official see it
             here automatically — no refresh needed, same onSnapshot listener as everything else. -->
        <div class="section-head" style="margin-top:30px;">
          <h2>Tournament Updates</h2>
          <span class="pill pill-live">Live</span>
        </div>
        <div class="card" id="dashboard-updates-card">
          <div id="dashboard-updates-list"></div>
        </div>
      </section>

      <!-- ===== TOURNAMENTS ===== -->
      <section class="screen" id="screen-tournaments">
        <div class="tabs" id="tourney-tabs">
          <button class="tab-btn active" data-filter="all" onclick="filterTourneys(this,'all')">All</button>
          <button class="tab-btn" data-filter="Ongoing" onclick="filterTourneys(this,'Ongoing')">Ongoing</button>
          <button class="tab-btn" data-filter="Upcoming" onclick="filterTourneys(this,'Upcoming')">Upcoming</button>
          <button class="tab-btn" data-filter="Completed" onclick="filterTourneys(this,'Completed')">Completed</button>
        </div>
        <div class="grid grid-3" id="tourney-list"></div>
      </section>

      <!-- ===== TOURNAMENT DETAIL (view participating teams — admin can delete a team here) ===== -->
      <section class="screen" id="screen-tourney-detail">
        <button class="back-link" style="margin-bottom:14px;" onclick="nav('tournaments')">← Back to Tournaments</button>
        <div class="card" id="tourney-detail-head" style="margin-bottom:18px;"></div>
        <div class="section-head" style="margin-top:0;"><h2>Participating Teams</h2><span class="topbar-sub" id="tourney-detail-count"></span></div>
        <div class="grid grid-3" id="tourney-detail-teams"></div>
      </section>

      <!-- ===== BRACKET ===== -->
      <section class="screen" id="screen-bracket">
        <div class="card" id="bracket-generator-card" style="display:none;margin-bottom:18px;">
          <h2 style="font-size:15px;margin-bottom:10px;">Generate Bracket</h2>
          <div style="display:flex;gap:10px;flex-wrap:wrap;align-items:flex-end;">
            <div class="field" style="flex:1;min-width:220px;margin-bottom:0;">
              <label>Tournament</label>
              <select id="bracket-tournament-select"></select>
            </div>
            <button class="btn btn-primary btn-sm" onclick="onGenerateBracketClick()">Generate Bracket</button>
          </div>
          <p class="topbar-sub" style="text-transform:none;margin-top:10px;">Seeds a single-elimination bracket from that tournament's approved teams (randomized seeding).</p>
        </div>
        <div class="card">
          <div style="display:flex;justify-content:space-between;align-items:center;margin-bottom:16px;flex-wrap:wrap;gap:10px;">
            <div>
              <h2 style="font-size:16px;">Bracket</h2>
              <span class="topbar-sub" style="text-transform:none;">Single Elimination</span>
            </div>
            <span class="pill pill-live">Live</span>
          </div>
          <div class="bracket-scroll">
            <div class="bracket" id="bracket-render"></div>
          </div>
        </div>
      </section>

      <!-- ===== SCHEDULE ===== -->
      <section class="screen" id="screen-schedule">
        <div class="tabs" id="schedule-tabs">
          <button class="tab-btn active" data-day="today" onclick="filterScheduleDay(this,'today')">Today</button>
          <button class="tab-btn" data-day="tomorrow" onclick="filterScheduleDay(this,'tomorrow')">Tomorrow</button>
          <button class="tab-btn" data-day="week" onclick="filterScheduleDay(this,'week')">This Week</button>
        </div>
        <div class="card" id="schedule-generator-card" style="display:none;margin-bottom:18px;">
          <h2 style="font-size:15px;margin-bottom:10px;">Generate Schedule</h2>
          <div style="display:flex;gap:10px;flex-wrap:wrap;align-items:flex-end;">
            <div class="field" style="flex:1;min-width:220px;margin-bottom:0;">
              <label>Tournament</label>
              <select id="schedule-tournament-select"></select>
            </div>
            <button class="btn btn-primary btn-sm" onclick="onGenerateScheduleClick()">Generate Schedule</button>
          </div>
          <p class="topbar-sub" style="text-transform:none;margin-top:10px;">Auto-fills the date and time for that tournament's bracket matches that don't have one yet. Generate its bracket first — this only assigns when and doesn't create new matchups.</p>
        </div>
        <div class="card" id="schedule-admin-add" style="display:none;margin-bottom:18px;">
          <div class="section-head" style="margin-top:0;">
            <h2>Add Match</h2>
          </div>
          <div class="sched-edit-row">
            <select id="new-match-tournament"></select>
            <input type="text" id="new-match-time" placeholder="09:00">
            <input type="text" id="new-match-a" placeholder="Team A">
            <input type="text" id="new-match-b" placeholder="Team B">
            <input type="text" id="new-match-venue" placeholder="Venue">
            <select id="new-match-day">
              <option value="today">Today</option>
              <option value="tomorrow">Tomorrow</option>
              <option value="week">This Week</option>
            </select>
            <select id="new-match-status">
              <option value="upcoming">Upcoming</option>
              <option value="live">Live</option>
              <option value="done">Final</option>
            </select>
            <button class="btn btn-primary btn-sm" onclick="addMatch()">Add</button>
          </div>
        </div>
        <div class="card">
          <div id="schedule-list"></div>
        </div>
      </section>

      <!-- ===== STANDINGS ===== -->
      <section class="screen" id="screen-standings">
        <div class="tabs" id="standings-tabs">
          <button class="tab-btn active" onclick="renderStandings('Northside Ballers')">Group A</button>
          <button class="tab-btn" onclick="renderStandings('Group B')">Group B</button>
        </div>
        <div class="card">
          <div class="section-head" style="margin-top:0;">
            <h2>Standings</h2>
            <button class="btn btn-ghost btn-sm" id="standings-add-btn" style="display:none;" onclick="addStandingRow()">+ Add Team</button>
          </div>
          <div class="table-wrap">
            <table>
              <thead><tr><th>#</th><th>Team</th><th>GP</th><th>W</th><th>L</th><th>PD</th><th>Win %</th><th>Pts</th><th class="th-actions" id="standings-actions-head" style="display:none;">Actions</th></tr></thead>
              <tbody id="standings-body"></tbody>
            </table>
          </div>
        </div>
      </section>

      <!-- ===== PLAYER SEARCH ===== -->
      <section class="screen" id="screen-search">
        <div class="card" style="margin-bottom:18px;">
          <div class="field" style="margin-bottom:12px;">
            <input type="text" id="player-search-input" placeholder="Search by name, team, or sport…" oninput="renderPlayers()" style="width:100%;background:var(--panel-2);border:1px solid var(--line);border-radius:10px;padding:11px 13px;color:var(--text);font-size:14px;outline:none;">
          </div>
          <div class="tabs" style="margin-bottom:0;" id="search-filters">
            <button class="tab-btn active" data-sport="all" onclick="filterSport(this,'all')">All Sports</button>
            <button class="tab-btn" data-sport="Basketball" onclick="filterSport(this,'Basketball')">Basketball</button>
            <button class="tab-btn" data-sport="Volleyball" onclick="filterSport(this,'Volleyball')">Volleyball</button>
            <button class="tab-btn" data-sport="Football" onclick="filterSport(this,'Football')">Football</button>
            <button class="tab-btn" data-sport="Esports" onclick="filterSport(this,'Esports')">Esports</button>
          </div>
        </div>
        <div class="grid grid-3" id="player-results"></div>
      </section>

      <!-- ===== REGISTRATIONS (Admin) ===== -->
      <section class="screen" id="screen-registrations">
        <div class="card">
          <div class="section-head" style="margin-top:0;flex-wrap:wrap;gap:10px;">
            <h2>All Registrations</h2>
            <div style="display:flex;align-items:center;gap:10px;">
              <select id="reg-role-filter" onchange="filterRegRole(this)" style="background:var(--panel-2);border:1px solid var(--line);border-radius:9px;padding:7px 10px;color:var(--text);font-size:12.5px;">
                <option value="all">All Roles</option>
                <option value="Player">Player</option>
                <option value="Coach">Coach</option>
                <option value="Official">Official</option>
                <option value="Spectator">Spectator</option>
              </select>
              <span class="topbar-sub" id="reg-count" style="text-transform:none;"></span>
            </div>
          </div>
          <p class="topbar-sub" style="text-transform:none;margin-bottom:10px;">Approving a <b style="color:var(--text);">Coach</b> or <b style="color:var(--text);">Official</b> registration creates their dashboard login using the password they set when they registered.</p>
          <div id="registrations-list"></div>
        </div>
      </section>

      <!-- ===== TEAMS (Admin) ===== -->
      <section class="screen" id="screen-teams">
        <div class="card">
          <div class="section-head" style="margin-top:0;flex-wrap:wrap;gap:10px;">
            <h2>All Teams</h2>
            <div style="display:flex;align-items:center;gap:10px;flex-wrap:wrap;">
              <select id="teams-tournament-filter" onchange="filterTeamsAdmin()" style="background:var(--panel-2);border:1px solid var(--line);border-radius:9px;padding:7px 10px;color:var(--text);font-size:12.5px;">
                <option value="all">All Tournaments</option>
              </select>
              <select id="teams-status-filter" onchange="filterTeamsAdmin()" style="background:var(--panel-2);border:1px solid var(--line);border-radius:9px;padding:7px 10px;color:var(--text);font-size:12.5px;">
                <option value="all">All Statuses</option>
                <option value="Approved">Approved</option>
                <option value="Pending">Pending</option>
                <option value="Rejected">Rejected</option>
              </select>
              <span class="topbar-sub" id="teams-count" style="text-transform:none;"></span>
            </div>
          </div>
          <p class="topbar-sub" style="text-transform:none;margin-bottom:10px;">Every team registered across every tournament — approve, review the roster, or delete a team.</p>
          <div class="grid grid-3" id="teams-admin-list"></div>
        </div>
      </section>

      <section class="screen" id="screen-notifications">
        <div class="grid grid-2">
          <div class="card">
            <h2 style="font-size:16px;margin-bottom:4px;">Send a Notification</h2>
            <p class="topbar-sub" style="margin-bottom:16px;">Delivered to coaches, players, and spectators via their Announcements feed.</p>
            <div class="field"><label>Type</label>
              <select id="notif-type">
                <option>Tournament Announcement</option>
                <option>Registration Update</option>
                <option>Upcoming Match</option>
                <option>Schedule Change</option>
                <option>Match Result</option>
                <option>Cancellation</option>
              </select>
            </div>
            <div class="field"><label>Title</label><input type="text" id="notif-title" placeholder="e.g. Venue Change"></div>
            <div class="field"><label>Message</label><input type="text" id="notif-msg" placeholder="e.g. Court B moved to Gym 2 due to maintenance."></div>
            <button class="btn btn-primary btn-block" onclick="sendNotification()">Send Notification</button>
          </div>
          <div class="card">
            <h2 style="font-size:16px;margin-bottom:6px;">Recently Sent</h2>
            <div id="notif-sent-list"></div>
          </div>
        </div>
      </section>

      <!-- ===== GENERATOR (Admin) ===== -->
      <section class="screen" id="screen-generator">
        <div class="card" style="max-width:720px;">
          <h2 style="font-size:17px;margin-bottom:4px;">Tournament Generator</h2>
          <p class="topbar-sub" style="margin-bottom:20px;">Set up a tournament and auto-generate fixtures, groups, and standings.</p>
          <div class="field"><label>Tournament Name</label><input type="text" id="gen-name" placeholder="e.g. Barangay Cup 2026"></div>
          <div class="field-row">
            <div class="field"><label>Sport</label><select id="gen-sport"><option>Basketball</option><option>Volleyball</option><option>Football</option><option>Futsal</option><option>Badminton</option><option>Esports</option><option>Chess</option></select></div>
            <div class="field"><label>Number of Teams</label><input type="number" id="gen-teams" value="8" min="2"></div>
          </div>
          <div class="field-row">
            <div class="field datefield">
              <label>Start Date</label>
              <div class="datefield-display" id="gen-start-display" onclick="toggleCalendar('start')">
                <span id="gen-start-display-text" class="ph">Select a date</span>
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="3" y="4" width="18" height="18" rx="2"/><line x1="16" y1="2" x2="16" y2="6"/><line x1="8" y1="2" x2="8" y2="6"/><line x1="3" y1="10" x2="21" y2="10"/></svg>
              </div>
              <input type="hidden" id="gen-start" value="">
              <div class="cal-popup" id="gen-start-popup"></div>
            </div>
            <div class="field datefield">
              <label>End Date</label>
              <div class="datefield-display disabled" id="gen-end-display" onclick="toggleCalendar('end')">
                <span id="gen-end-display-text" class="ph">Pick start date first</span>
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="3" y="4" width="18" height="18" rx="2"/><line x1="16" y1="2" x2="16" y2="6"/><line x1="8" y1="2" x2="8" y2="6"/><line x1="3" y1="10" x2="21" y2="10"/></svg>
              </div>
              <input type="hidden" id="gen-end" value="">
              <div class="cal-popup" id="gen-end-popup"></div>
            </div>
          </div>
          <div class="field-row">
            <div class="field"><label>Venue</label><input type="text" id="gen-venue" placeholder="e.g. TCGC Covered Court"></div>
            <div class="field"><label>Minimum Players per Team</label><input type="number" id="gen-min-players" value="5" min="1"></div>
          </div>
          <p class="topbar-sub" style="text-transform:none;margin-top:-8px;margin-bottom:4px;">A coach's team must have at least this many players on its roster before it can join this tournament.</p>
          <label style="display:block;font-size:12px;color:var(--muted);margin:18px 0 10px;font-weight:600;text-transform:uppercase;letter-spacing:.03em;">Format</label>
          <div class="format-grid" id="format-grid">
            <div class="format-opt selected" data-f="Round Robin" onclick="pickFormat(this)"><h3>Round Robin</h3><p>Every team plays every other team once.</p></div>
            <div class="format-opt" data-f="Single Elim" onclick="pickFormat(this)"><h3>Single Elimination</h3><p>Lose once, you're out. Fastest path to a champion.</p></div>
          </div>
          <button class="btn btn-primary btn-block" style="margin-top:22px;" onclick="generateTourney()">Generate Tournament</button>
        </div>
      </section>

      <!-- ===== AUDIT LOG (Admin) ===== -->
      <section class="screen" id="screen-auditlog">
        <div class="card">
          <div class="section-head" style="margin-top:0;">
            <div><h2>Activity History</h2><span class="topbar-sub">Match results, approvals, and registration changes</span></div>
            <button class="btn btn-danger btn-sm" onclick="clearAuditLog()">Clear All</button>
          </div>
          <div id="auditlog-list"></div>
        </div>
      </section>

      <!-- ===== REPORTS (Admin / Coach) ===== -->
      <section class="screen" id="screen-reports">
        <div class="grid grid-3">
          <div class="card">
            <h3 style="font-size:14px;margin-bottom:4px;">Tournament Summary</h3>
            <p class="topbar-sub" style="margin-bottom:14px;">Teams, matches, results overview</p>
            <div style="display:flex;gap:8px;">
              <button class="btn btn-ghost btn-sm" onclick="exportToast('PDF')">Export PDF</button>
              <button class="btn btn-ghost btn-sm" onclick="exportToast('Excel')">Excel</button>
            </div>
          </div>
          <div class="card">
            <h3 style="font-size:14px;margin-bottom:4px;">Player Statistics</h3>
            <p class="topbar-sub" style="margin-bottom:14px;">Full stat lines for all players</p>
            <div style="display:flex;gap:8px;">
              <button class="btn btn-ghost btn-sm" onclick="exportToast('CSV')">Export CSV</button>
              <button class="btn btn-ghost btn-sm" onclick="exportToast('Excel')">Excel</button>
            </div>
          </div>
          <div class="card">
            <h3 style="font-size:14px;margin-bottom:4px;">Team Rankings</h3>
            <p class="topbar-sub" style="margin-bottom:14px;">Standings snapshot across groups</p>
            <div style="display:flex;gap:8px;">
              <button class="btn btn-ghost btn-sm" onclick="exportToast('PDF')">Export PDF</button>
            </div>
          </div>
        </div>
      </section>

      <!-- ===== MY TEAM (Coach) ===== -->
      <section class="screen" id="screen-myteam">
        <div class="card" id="myteam-noteam-card" style="display:none;margin-bottom:22px;">
          <h2 style="font-size:16px;margin-bottom:6px;">You don't have a team yet</h2>
          <p class="topbar-sub" style="margin-bottom:16px;">Create your team first — you'll need one before you can join any tournament.</p>
          <div class="field-row">
            <div class="field"><label>Team Name</label><input type="text" id="create-team-name" placeholder="e.g. Thunder Hawks"></div>
            <div class="field"><label>Sport</label>
              <select id="create-team-sport">
                <option>Basketball</option><option>Volleyball</option><option>Football</option>
                <option>Futsal</option><option>Badminton</option><option>Esports</option><option>Chess</option>
              </select>
            </div>
          </div>
          <button class="btn btn-primary btn-block" onclick="createMyTeam()">Create Team</button>
        </div>

        <div id="myteam-hasteam-wrap">
          <div class="grid grid-4" id="myteam-stats" style="margin-bottom:26px;"></div>

          <div class="grid grid-2">
            <div class="card">
              <div class="section-head" style="margin-top:0;">
                <h2>Team Info</h2>
                <span class="pill" id="myteam-status-pill"></span>
              </div>
              <div id="myteam-info"></div>
            </div>
            <div class="card">
              <h2 style="font-size:15px;margin-bottom:6px;">Announcements</h2>
              <div id="myteam-announce-list"></div>
            </div>
          </div>

          <div class="section-head"><h2>Roster</h2><span class="topbar-sub" id="myteam-roster-count"></span></div>
          <div class="card">
            <div class="field-row" style="margin-bottom:14px;">
              <div class="field" style="position:relative;">
                <label>Add Player (registered &amp; approved only)</label>
                <input type="text" id="new-player-search" placeholder="Search registered players…" autocomplete="off"
                  oninput="document.getElementById('new-player-select').value=''; renderAddPlayerResults();" onfocus="renderAddPlayerResults()">
                <input type="hidden" id="new-player-select" value="">
                <div id="new-player-results" style="display:none;position:absolute;top:100%;left:0;right:0;z-index:20;max-height:220px;overflow-y:auto;background:var(--card,#161D33);border:1px solid var(--border,#2A3352);border-radius:8px;margin-top:4px;"></div>
              </div>
              <div class="field" style="display:flex;align-items:flex-end;"><button class="btn btn-primary btn-block" onclick="addPlayerToMyTeam()">Add to Roster</button></div>
            </div>
            <div id="myteam-roster-list"></div>
          </div>

          <div class="section-head">
            <h2>Available Tournaments</h2>
            <a class="view-all" onclick="nav('tournaments')">Browse all →</a>
          </div>
          <div class="grid grid-3" id="myteam-available-tournaments"></div>

          <div class="section-head"><h2>Upcoming Matches</h2></div>
          <div class="grid grid-3" id="myteam-upcoming"></div>
        </div>
      </section>

    </div>
  </div>
</div>

<nav class="mobile-nav" id="mobile-nav">
  <button class="mnav-item active" data-screen="dashboard" onclick="nav('dashboard')">
    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="3" y="3" width="7" height="9" rx="1.5"/><rect x="14" y="3" width="7" height="5" rx="1.5"/><rect x="14" y="12" width="7" height="9" rx="1.5"/><rect x="3" y="16" width="7" height="5" rx="1.5"/></svg>
    Home
  </button>
  <button class="mnav-item" data-screen="bracket" onclick="nav('bracket')">
    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M4 5h5v4H4zM4 15h5v4H4zM15 10h5v4h-5zM9 7h3v6h-3zM12 10h3M9 17h3v-6"/></svg>
    Bracket
  </button>
  <button class="mnav-item" data-screen="schedule" onclick="nav('schedule')">
    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="3" y="4" width="18" height="17" rx="2"/><path d="M16 2v4M8 2v4M3 10h18"/></svg>
    Sched
  </button>
  <button class="mnav-item" data-screen="standings" onclick="nav('standings')">
    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M3 3v18h18M7 16v-6M12 16V6M17 16v-3"/></svg>
    Rank
  </button>
  <button class="mnav-item" data-screen="search" onclick="nav('search')">
    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="11" cy="11" r="7"/><path d="M21 21l-4.35-4.35"/></svg>
    Search
  </button>
</nav>

<!-- ================= LIVE VIEWER (new — separate full-screen screen, opened only by clicking a LIVE match card) ================= -->
<div class="live-viewer-overlay" id="live-viewer-overlay">
  <div class="live-viewer-top">
    <div class="live-viewer-top-left">
      <span class="pill pill-live">Live</span>
      <span class="topbar-sub" id="live-viewer-venue" style="text-transform:none;"></span>
    </div>
    <button class="live-viewer-close" onclick="closeLiveViewer()" aria-label="Close">✕</button>
  </div>
  <div class="live-viewer-body">
    <div class="live-viewer-main">
      <div class="live-stage">
        <span class="pill pill-live live-stage-badge">Live</span>
        <div class="live-stage-label">Live Match</div>
        <div class="live-stage-teams">
          <div class="live-stage-team" id="live-viewer-team-a">Team A</div>
          <div class="live-stage-score" id="live-viewer-score">-</div>
          <div class="live-stage-team" id="live-viewer-team-b">Team B</div>
        </div>
        <div class="live-stage-play">▶</div>
        <div class="live-stage-preview">Stream Preview</div>
      </div>
      <div class="live-meta-row">
        <span id="live-viewer-time"></span>
        <span>·</span>
        <span id="live-viewer-venue-2"></span>
      </div>
    </div>
    <div class="live-chat">
      <div class="live-chat-head">Live Chat</div>
      <div class="live-chat-messages" id="live-chat-messages"></div>
      <div class="live-chat-input-row">
        <input type="text" id="live-chat-input" placeholder="Say something…" onkeydown="if(event.key==='Enter')postLiveComment()">
        <button class="live-chat-send" onclick="postLiveComment()">Send</button>
      </div>
    </div>
  </div>
</div>

<!-- ================= TEAM ROSTER MODAL (new — click any team card to see its coach + full player list) ================= -->
<div class="team-roster-overlay" id="team-roster-overlay" onclick="if(event.target===this) closeTeamRosterModal()">
  <div class="team-roster-modal">
    <button class="team-roster-close" onclick="closeTeamRosterModal()" aria-label="Close">✕</button>
    <div id="team-roster-modal-body"></div>
  </div>
</div>

<!-- ================= MATCH LIVE-SCORE / QR MODAL (new — admin/official opens this from a Schedule row) ================= -->
<div class="qr-modal-overlay" id="qr-modal-overlay" onclick="if(event.target===this) closeMatchQr()">
  <div class="qr-modal">
    <button class="qr-modal-close" onclick="closeMatchQr()" aria-label="Close">✕</button>
    <span class="qr-modal-badge">Live Score QR</span>
    <h2 style="font-size:17px;margin-top:10px;" id="qr-modal-title">Team A vs Team B</h2>
    <p class="topbar-sub" id="qr-modal-sub" style="text-transform:none;margin-top:4px;"></p>

    <div class="qr-frame">
      <div class="qr-frame-inner">
        <img class="qr-modal-img" id="qr-modal-img" alt="QR code to this match's live score page">
        <span class="qr-corner tl"></span>
        <span class="qr-corner tr"></span>
        <span class="qr-corner bl"></span>
        <span class="qr-corner br"></span>
      </div>
    </div>
    <p class="qr-modal-hint">📷 Scan to open and update this match's live score on another device — it syncs to the schedule and bracket automatically.</p>

    <div class="qr-share-row">
      <a class="qr-modal-link" id="qr-modal-link" target="_blank" rel="noopener"></a>
      <button class="qr-copy-btn" onclick="copyMatchQrLink()">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="9" y="9" width="12" height="12" rx="2"/><path d="M5 15H4a1 1 0 01-1-1V4a1 1 0 011-1h10a1 1 0 011 1v1"/></svg>
        Copy
      </button>
    </div>
  </div>
</div>

<div class="toast" id="toast"></div>

<!-- Firebase (compat build — plays nicely with this file's plain global-scope script) -->
<script src="https://www.gstatic.com/firebasejs/10.13.0/firebase-app-compat.js"></script>
<script src="https://www.gstatic.com/firebasejs/10.13.0/firebase-firestore-compat.js"></script>
<script>
  const firebaseConfig = {
    apiKey: "AIzaSyCqIdv457vL3y07xc13uvqo5-qQzG-_tSw",
    authDomain: "stms-pro.firebaseapp.com",
    projectId: "stms-pro",
    storageBucket: "stms-pro.firebasestorage.app",
    messagingSenderId: "451913657805",
    appId: "1:451913657805:web:2840cc353a56197851e884",
    measurementId: "G-SZVET6R0C8"
  };
  firebase.initializeApp(firebaseConfig);
  const db = firebase.firestore();
  /* QUOTA FIX: turn on the IndexedDB cache BEFORE anything else touches Firestore.
     Without it, every time a listener is re-attached (tab switch, refresh button, reconnect)
     Firestore re-downloads every document in every collection and each one counts as a read —
     that is what burns through the free Spark quota (50k reads/day) and throws
     [code=resource-exhausted]. With the cache on, a re-attach is served from local storage and
     only genuinely changed docs are billed. synchronizeTabs keeps multiple open tabs sharing
     one cache instead of each paying for its own. */
  (function enableOfflineCache(){
    /* enablePersistence() still works but the SDK now logs a deprecation warning for it and
       wants the cache configured through settings({localCache}) instead. Prefer the new API
       when this SDK build exposes it (silences the warning), fall back to the old one when it
       doesn't so older/compat builds keep the cache either way. */
    var fs = firebase.firestore;
    try{
      if(fs.persistentLocalCache && fs.persistentMultipleTabManager){
        db.settings({ localCache: fs.persistentLocalCache({ tabManager: fs.persistentMultipleTabManager() }) });
        return;
      }
    }catch(e){ console.warn('localCache setting unavailable, falling back:', e && e.code); }
    db.enablePersistence({ synchronizeTabs: true }).catch(function(err){
      console.warn('Firestore offline cache unavailable:', err && err.code);
    });
  })();
  let quotaBlocked = false; // flipped on once Firestore reports resource-exhausted
  function isQuotaError(e){ return !!e && (e.code === 'resource-exhausted' || /resource-exhausted|Quota exceeded/i.test(e.message||'')); }
</script>

