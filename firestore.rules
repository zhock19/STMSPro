  {id:7, role:'Player', name:'Patricia Ongsuco', email:'patricia.ongsuco@email.com', phone:'+63 920 441 8890', team:'—', sport:'Volleyball', status:'Approved', date:'Aug 12, 2026', photo:null},
  {id:8, role:'Player', name:'Dale Fernandez', email:'dale.fernandez@email.com', phone:'+63 927 112 6634', team:'—', sport:'Volleyball', status:'Approved', date:'Aug 13, 2026', photo:null},
  {id:9, role:'Player', name:'Kian Espiritu', email:'kian.espiritu@email.com', phone:'+63 919 605 3347', team:'—', sport:'Football', status:'Approved', date:'Aug 14, 2026', photo:null},
  {id:10, role:'Player', name:'Mikaela Torres', email:'mikaela.torres@email.com', phone:'+63 921 887 4409', team:'—', sport:'Esports', status:'Approved', date:'Aug 14, 2026', photo:null},
  {id:11, role:'Player', name:'Angelo Buenaflor', email:'angelo.buenaflor@email.com', phone:'+63 917 502 9931', team:'—', sport:'Futsal', status:'Approved', date:'Aug 15, 2026', photo:null},
  {id:12, role:'Player', name:'Louis Amistad', email:'louis.amistad@email.com', phone:'+63 918 223 1176', team:'—', sport:'Chess', status:'Pending', date:'Aug 16, 2026', photo:null},
];
let publicInfoVisible = false;

const bracketData = [
  {round:'Quarterfinals', matches:[
    {a:'Northside Ballers',sa:78,b:'Coastal Smash',sb:64,winner:'a'},
    {a:'River Hawks',sa:70,b:'Blue Tide FC',sb:73,winner:'b'},
    {a:'Granite Wolves',sa:81,b:'Iron Spikers',sb:59,winner:'a'},
    {a:'Falcons United',sa:66,b:'Summit FC',sb:69,winner:'b'},
  ]},
  {round:'Semifinals', matches:[
    {a:'Northside Ballers',sa:88,b:'Blue Tide FC',sb:75,winner:'a'},
    {a:'Granite Wolves',sa:60,b:'Summit FC',sb:71,winner:'b'},
  ]},
  {round:'Finals', matches:[
    {a:'Northside Ballers',sa:'—',b:'Summit FC',sb:'—',winner:null,live:true},
  ]},
];

let currentRole = 'spectator';
let currentScreen = 'dashboard';
let pendingRegPhoto = null; // holds base64 data URL of an uploaded profile photo before submit
let viewingTourneyId = null; // set when a coach/spectator/admin opens a tournament's detail screen

/* ---------------- FIRESTORE SYNC ----------------
   Every collection below is mirrored to Firestore. The arrays keep being the
   "live" data the rest of the app reads and renders from — persistAll() just
   copies their current contents up to Firestore (adds/updates changed docs,
   deletes docs for items removed locally). schedulePersist() is called from
   showToast(), which runs after essentially every action in this app, so a
   sync happens automatically ~500ms after anything changes. */
const FS_COLLECTIONS = {
  tournaments:      { arr: tournaments,      key: 'id' },
  teams:            { arr: teams,            key: 'id' },
  schedule:         { arr: schedule,         key: 'id' },
  standings:        { arr: standings,        key: 'id' },
  registrations:    { arr: registrations,    key: 'id' },
  announcements:    { arr: announcements,    key: 'id' },
  auditLog:         { arr: auditLog,         key: 'id' },
  coachAccounts:    { arr: coachAccounts,    key: 'email' },
  officialAccounts: { arr: officialAccounts, key: 'email' },
};
let fsIdCounter = Date.now();
let fsReady = false; // don't sync to Firestore until the initial seed/load has finished

/* IMPORTANT FIX: persistAll() used to batch.set() EVERY item in EVERY FS_COLLECTIONS collection
   on every single call — tournaments, teams, schedule, standings, registrations, announcements,
   auditLog, coachAccounts, officialAccounts, all of it — even though one click (e.g. editing one
   score) only ever actually changes a document or two. Firestore bills/counts a write for every
   set() call regardless of whether the data inside it actually changed, and schedulePersist()
   fires after nearly every action anywhere in the app. In real use that burns through Firestore's
   daily write quota within minutes of testing and starts throwing "resource-exhausted" errors —
   at which point the writes are silently swallowed (caught below, logged to the console only), so
   something an admin just generated can look completely fine in their own tab (it's already sitting
   in the local array) while never actually reaching Firestore, so no other account ever sees it.
   lastPersistedJSON remembers the last known-saved-to-server content of every document (both from
   this client's own successful writes AND from data that just arrived from the server via
   applySnapshotToArray, so a change that originated on another client is never needlessly written
   straight back). persistAll() then only ever sends the documents whose content actually differs
   from that — usually just one or two, instead of everything. */
let lastPersistedJSON = {}; // { collectionName: { docId: jsonStringOfLastKnownSavedContent } }

/* The live bracket isn't a list of independently-keyed items like the collections above —
   it's one single-elimination structure (rounds -> matches) for the whole app. So instead of
   the per-item FS_COLLECTIONS pattern, it's mirrored as one Firestore doc (meta/bracket).
   Whoever generates it (admin/official) writes this doc; a dedicated onSnapshot listener below
   pushes that update to every other open account (spectator, coach, etc.) in real time. */
const bracketDocRef = () => db.collection('meta').doc('bracket');
async function persistBracket(){
  if(!fsReady || quotaBlocked) return;
  try{ await bracketDocRef().set({ rounds: currentBracket, tournament: currentBracketTournament }); }
  catch(e){ console.error('Bracket sync failed:', e); noteQuotaError(e); }
}

/* QUOTA FIX: a resource-exhausted error used to be logged to the console and nothing else, so
   the app carried on firing writes into a wall for the rest of the day while every screen still
   looked fine. Now the first one stops all further writes/re-subscribes for this session and
   tells the user plainly, so they know what they're looking at. */
function noteQuotaError(e){
  if(!isQuotaError(e) || quotaBlocked) return;
  quotaBlocked = true;
  setSyncStatus('offline');
  showToastOnly('⚠️ Firebase daily quota reached — changes are local only until it resets (midnight Pacific).');
}

/* IMPORTANT FIX: this used to also delete any Firestore doc NOT present in this client's local
   array (`snap.forEach(doc=>{ if(!seen.has(doc.id)) batch.delete(doc.ref); })`). That's what was
   silently deleting live matches out from under people: every open tab/device (admin, official,
   coach, spectator, and every scanned QR live-score page) runs its own copy of this app with its
   own local arrays, kept in sync via onSnapshot listeners that can lag by a moment. showToast()
   calls schedulePersist() after nearly every action anywhere in the app — including just pressing
   "Update Live Score" — so any client whose local copy hadn't yet caught up with someone else's
   very recent write would, on its next persist, delete every doc it didn't know about yet. That's
   why a match could vanish ("This match may have been removed") with nobody touching End Match.
   persistAll() is now additive-only (upsert, never delete); every explicit delete/remove action in
   this app calls deleteFromFirestore()/clearCollectionFromFirestore() right where it happens instead. */
async function persistAll(){
  if(!fsReady || quotaBlocked) return;
  const batch = db.batch();
  const pending = []; // {name, id, json} — only what's actually about to be written
  for(const name in FS_COLLECTIONS){
    const { arr, key } = FS_COLLECTIONS[name];
    if(!lastPersistedJSON[name]) lastPersistedJSON[name] = {};
    const seen = lastPersistedJSON[name];
    arr.forEach(item=>{
      const id = String(item[key]);
      const json = JSON.stringify(item);
      if(seen[id] === json) return; // identical to what the server already has — skip it, saves the write
      batch.set(db.collection(name).doc(id), item);
      pending.push({name, id, json});
    });
  }
  if(!pending.length) return; // nothing actually changed since the last successful save
  try{
    await batch.commit();
    // Only mark these as saved AFTER a confirmed success — if commit() throws (e.g. quota),
    // leave them unmarked so the next persist cycle retries them instead of skipping them.
    pending.forEach(p => { lastPersistedJSON[p.name][p.id] = p.json; });
  }catch(e){ console.error('Firestore sync failed:', e); noteQuotaError(e); }
}
async function deleteFromFirestore(collectionName, id){
  if(!fsReady) return;
  try{
    await db.collection(collectionName).doc(String(id)).delete();
    if(lastPersistedJSON[collectionName]) delete lastPersistedJSON[collectionName][String(id)];
  }
  catch(e){ console.error(`Firestore delete failed (${collectionName}/${id}):`, e); noteQuotaError(e); }
}
async function clearCollectionFromFirestore(collectionName, ids){
  if(!fsReady || !ids.length) return;
  try{
    const batch = db.batch();
    ids.forEach(id => batch.delete(db.collection(collectionName).doc(String(id))));
    await batch.commit();
    if(lastPersistedJSON[collectionName]){
      ids.forEach(id => delete lastPersistedJSON[collectionName][String(id)]);
    }
  }catch(e){ console.error(`Firestore clear failed (${collectionName}):`, e); noteQuotaError(e); }
}
let persistTimer;
function schedulePersist(){
  if(!fsReady || quotaBlocked) return;
  clearTimeout(persistTimer);
  /* QUOTA FIX: 500ms was short enough that a burst of quick actions (typing a score, then
     confirming, then the audit entry) each got their own batch commit. 1.5s coalesces those
     into one commit without being noticeable to the user. */
  persistTimer = setTimeout(persistAll, 1500);
}

function bumpIdCounters(){
  // Keep the id counters ahead of whatever the highest loaded id is, so new items don't collide.
  tourneyIdCounter  = Math.max(tourneyIdCounter,  0, ...tournaments.map(t=>t.id));
  teamIdCounter     = Math.max(teamIdCounter,     0, ...teams.map(t=>t.id));
  scheduleIdCounter = Math.max(scheduleIdCounter, 0, ...schedule.map(s=>s.id));
  standingIdCounter = Math.max(standingIdCounter, 0, ...standings.map(s=>s.id));
  regIdCounter      = Math.max(regIdCounter,      0, ...registrations.map(r=>r.id));
  fsIdCounter       = Math.max(fsIdCounter, 0, ...announcements.map(a=>a.id||0), ...auditLog.map(a=>a.id||0));
}

/* ---------------- LIVE REFRESH ----------------
   Instead of loading each collection once, we attach a real-time onSnapshot
   listener per collection. Whenever ANY change lands in Firestore — a new
   registration submitted from another device, an admin approving a team on
   another tab, a score update, etc. — the matching listener fires, the local
   array is refreshed, and the visible screens are rebuilt automatically.
   No page reload needed. A manual refresh button is also provided as a
   fallback / instant confirmation for the user. */
let firestoreUnsubs = [];
let knownRegistrationIds = new Set();
let regNotificationsArmed = false; // true once the initial hydration is done, so we only toast for *genuinely new* registrations

function setSyncStatus(state){
  const wrap = document.getElementById('sync-status');
  const text = document.getElementById('sync-status-text');
  if(!wrap || !text) return;
  wrap.classList.remove('syncing','offline');
  if(state==='offline'){ wrap.classList.add('offline'); text.textContent = 'Offline'; }
  else if(state==='syncing'){ wrap.classList.add('syncing'); text.textContent = 'Syncing…'; }
  else { text.textContent = 'Live'; }
}

let lastSnapshotAt = Date.now(); // when this client last actually heard from Firestore
function applySnapshotToArray(name, snap){
  lastSnapshotAt = Date.now();
  const { arr } = FS_COLLECTIONS[name];
  arr.length = 0;
  if(!lastPersistedJSON[name]) lastPersistedJSON[name] = {};
  const seen = lastPersistedJSON[name];
  snap.forEach(doc=>{
    const data = doc.data();
    arr.push(data);
    // This just arrived straight from the server (whether it's this client's own change
    // echoing back, or a genuinely new change from another account) — remember it as already
    // saved, so a later persistAll() (triggered by some unrelated local edit) doesn't waste a
    // write sending this exact same document straight back to Firestore.
    seen[doc.id] = JSON.stringify(data);
  });
}

function checkForNewRegistrations(){
  const currentIds = new Set(registrations.map(r=>r.id));
  if(regNotificationsArmed){
    const fresh = registrations.filter(r=>!knownRegistrationIds.has(r.id));
    // Only surface this to the people who review registrations, so players/spectators
    // browsing the public views aren't interrupted by unrelated admin notifications.
    if(fresh.length && (currentRole==='admin' || currentRole==='official')){
      fresh.forEach(r=>showToastOnly(`🔔 New ${r.role} registration: ${r.name}`));
    }
  }
  knownRegistrationIds = currentIds;
}

let rebuildTimer;
function scheduleRebuild(){
  // Several collections can update within milliseconds of each other (e.g. creating
  // a tournament also writes an announcement + audit entry) — coalesce into one rebuild.
  clearTimeout(rebuildTimer);
  rebuildTimer = setTimeout(()=>{
    bumpIdCounters();
    buildAll();
    buildLandingLive();
    if(viewingTourneyId) openTourneyDetail(viewingTourneyId);
    if(publicLiveMatchId) renderPublicLiveMatch();
    if(qrModalMatchId) renderMatchQrModal();
  }, 150);
}

/* QUOTA FIX: auditLog is append-only and unbounded, and every client used to subscribe to the
   entire collection — on a busy tournament that alone is thousands of reads per connection.
   Only the newest AUDIT_KEEP entries are ever displayed anyway. */
const AUDIT_KEEP = 60;
function collectionQuery(name){
  if(name === 'auditLog') return db.collection(name).orderBy('id','desc').limit(AUDIT_KEEP);
  return db.collection(name);
}

function listenToCollection(name){
  return new Promise(resolve=>{
    let first = true;
    const unsub = collectionQuery(name).onSnapshot(snap=>{
      applySnapshotToArray(name, snap);
      if(first){
        first = false;
        resolve();
      }else{
        if(name === 'registrations') checkForNewRegistrations();
        scheduleRebuild();
      }
    }, err=>{
      console.error(`Firestore listener error (${name}):`, err);
      setSyncStatus('offline');
      noteQuotaError(err);
      if(first){ first = false; resolve(); }
    });
    firestoreUnsubs.push(unsub);
  });
}

function listenToBracketDoc(){
  return new Promise(resolve=>{
    let first = true;
    const unsub = bracketDocRef().onSnapshot(doc=>{
      if(doc.exists && Array.isArray(doc.data().rounds)){
        currentBracket = doc.data().rounds;
        if(doc.data().tournament) currentBracketTournament = doc.data().tournament;
      }
      if(first){
        first = false;
        resolve();
      }else{
        // Someone (admin/official) just generated or regenerated the bracket — reflect it
        // immediately on every other open account (spectator, coach, etc.), no refresh needed.
        buildBracket();
      }
    }, err=>{
      console.error('Firestore bracket listener error:', err);
      noteQuotaError(err);
      if(first){ first = false; resolve(); }
    });
    firestoreUnsubs.push(unsub);
  });
}

async function attachRealtimeListeners(){
  // Wait for every collection's first snapshot before treating the app as "live" —
  // this hydrates local arrays from the server before we start reacting to *changes*,
  // so nothing already in Firestore gets mistaken for a brand-new registration.
  firestoreUnsubs.forEach(u=>{ try{ u(); }catch(e){} });
  firestoreUnsubs = [];
  await Promise.all([...Object.keys(FS_COLLECTIONS).map(listenToCollection), listenToBracketDoc()]);
  bumpIdCounters();
  knownRegistrationIds = new Set(registrations.map(r=>r.id));
  regNotificationsArmed = true;
  buildAll();
  if(publicLiveMatchId) renderPublicLiveMatch();
  setSyncStatus('live');
}

async function initFirestore(){
  setSyncStatus('syncing');
  try{
    // QUOTA FIX: this only needs to know whether the collection is empty — .limit(1) makes it
    // a single read instead of downloading every tournament on top of the listener that follows.
    const snap = await db.collection('tournaments').limit(1).get();
    if(snap.empty){
      // First run ever for this Firebase project — push up the built-in demo data as the seed.
      fsReady = true;
      await persistAll();
      await persistBracket();
      await attachRealtimeListeners();
      showToastOnly('Connected to Firebase — demo data seeded to Firestore');
    } else {
      await attachRealtimeListeners();
      fsReady = true;
      showToastOnly('Connected to Firebase — live sync enabled');
    }
  }catch(e){
    console.error('Firestore init failed:', e);
    showToastOnly('Could not reach Firebase — using local data only');
    setSyncStatus('offline');
  }
  buildLandingLive();
}

let manualRefreshInFlight = false;
/* IMPORTANT FIX: this used to skip straight to buildAll() (a re-render of whatever's already
   sitting in the local arrays) whenever firestoreUnsubs.length > 0 — i.e. whenever listeners
   were technically still attached. But a listener can go quiet without throwing any visible
   error: a backgrounded browser tab, a brief wifi drop, a laptop waking from sleep, a proxy
   silently dropping an idle long-poll connection. In that state firestoreUnsubs.length is
   still > 0, fsReady is still true, yet no new snapshot has arrived — so "Refresh" was just
   repainting the same stale data and reporting "Up to date ✓" on it. That's exactly the shape
   of bug where an admin's newly-generated tournament/bracket/schedule item never shows up on
   an already-open Spectator/Coach/Official tab even after they press the refresh button.
   Now it always tears down and re-subscribes every listener (attachRealtimeListeners already
   unsubscribes the old ones first), which forces a genuine fresh pull from the Firestore
   server instead of trusting memory that might itself be the stale thing. */
/* QUOTA FIX: a full re-subscribe drops the listeners' resume tokens and re-reads every document
   in every collection. It is still the right escape hatch when something really is stale, but it
   must not happen freely — this caps it to once per RESUBSCRIBE_COOLDOWN_MS. Any refresh inside
   that window just repaints from the live local arrays, which is free and, with the listeners
   still attached, just as current. */
const RESUBSCRIBE_COOLDOWN_MS = 60000;
let lastResubscribeAt = 0;
function repaintFromLocal(){
  buildAll();
  buildLandingLive();
  if(viewingTourneyId) openTourneyDetail(viewingTourneyId);
  if(publicLiveMatchId) renderPublicLiveMatch();
}

async function manualRefresh(silent){
  if(manualRefreshInFlight) return;
  manualRefreshInFlight = true;
  const btn = document.getElementById('refresh-btn');
  if(btn) btn.classList.add('spinning');
  try{
    if(!fsReady){
      // Never finished connecting in the first place — try again from scratch.
      await initFirestore();
    } else if(quotaBlocked){
      repaintFromLocal(); // no point hammering Firestore until the quota resets
    } else if(Date.now() - lastResubscribeAt > RESUBSCRIBE_COOLDOWN_MS){
      lastResubscribeAt = Date.now();
      await attachRealtimeListeners(); // re-subscribes to every collection + the bracket doc fresh
      buildLandingLive();
      if(viewingTourneyId) openTourneyDetail(viewingTourneyId);
      setSyncStatus('live');
    } else {
      repaintFromLocal();
      setSyncStatus('live');
    }
    if(!silent) showToastOnly('Up to date ✓');
  }catch(e){
    console.error('Manual refresh failed:', e);
    setSyncStatus('offline');
    if(!silent) showToastOnly('Refresh failed — check your connection');
  }
  setTimeout(()=>{ if(btn) btn.classList.remove('spinning'); }, 400);
  manualRefreshInFlight = false;
}
window.addEventListener('online', ()=>{ if(fsReady) setSyncStatus('live'); });
window.addEventListener('offline', ()=>setSyncStatus('offline'));
/* QUOTA FIX: this used to call manualRefresh() on every single tab switch, and manualRefresh()
   tore down and re-created every listener — so one person idly switching between tabs (or a phone
   locking and unlocking, which fires the same event) re-read the entire database each time. That,
   multiplied by every admin/official/coach/spectator/QR-scanner tab, is what exhausted the daily
   read quota. The listeners survive backgrounding and Firestore reconnects them itself, so coming
   back to the tab now just repaints what the still-attached listeners already delivered. A genuine
   re-subscribe only happens if nothing has arrived for a long time, or if the user presses Refresh. */
const STALE_AFTER_MS = 10 * 60 * 1000;
document.addEventListener('visibilitychange', function(){
  if(document.visibilityState !== 'visible' || !fsReady || manualRefreshInFlight) return;
  if(quotaBlocked) return;
  repaintFromLocal();
  if(Date.now() - lastSnapshotAt > STALE_AFTER_MS) manualRefresh(true);
});

/* ---------------- GATE / AUTH ---------------- */
function showGate(id){
  document.body.classList.remove('app-entered');
  document.querySelectorAll('.gate').forEach(g=>g.style.display='none');
  document.getElementById(id).style.display='flex';
  document.getElementById('admin-error').style.display='none';
  document.getElementById('register-error').style.display='none';
  const coachErr = document.getElementById('coach-error');
  if(coachErr) coachErr.style.display='none';
  const officialErr = document.getElementById('official-error');
  if(officialErr) officialErr.style.display='none';
}
function pickRole(el){
  document.querySelectorAll('.role-opt').forEach(r=>r.classList.remove('selected'));
  el.classList.add('selected');
  const role = el.dataset.role;
  const pwWrap = document.getElementById('reg-password-wrap');
  const pwInput = document.getElementById('reg-password');
  if(role === 'Coach' || role === 'Official'){
    pwWrap.style.display = 'block';
  } else {
    pwWrap.style.display = 'none';
    if(pwInput) pwInput.value = '';
  }

  // Officials only need name, email, phone, and a password — hide Team/Organization and Preferred Sport for them.
  const teamSportRow = document.getElementById('reg-team-sport-row');
  const teamInput = document.getElementById('reg-team');
  const sportSelect = document.getElementById('reg-sport');
  if(role === 'Official'){
    teamSportRow.style.display = 'none';
    if(teamInput) teamInput.value = '';
    if(sportSelect) sportSelect.selectedIndex = 0;
  } else {
    teamSportRow.style.display = 'grid';
  }
}

/* ---- Profile photo upload on the Register page ---- */
function handlePhotoUpload(input){
  const file = input.files && input.files[0];
  if(!file) return;
  if(!file.type.startsWith('image/')){
    showToast('Please choose an image file.');
    input.value = '';
    return;
  }
  const reader = new FileReader();
  reader.onload = function(e){
    pendingRegPhoto = e.target.result;
    const preview = document.getElementById('reg-photo-preview');
    preview.src = pendingRegPhoto;
    preview.style.display = 'block';
    document.getElementById('reg-photo-text').style.display = 'none';
    document.getElementById('reg-photo-filename').textContent = `✓ ${file.name}`;
  };
  reader.readAsDataURL(file);
}
function resetPhotoUpload(){
  pendingRegPhoto = null;
  const input = document.getElementById('reg-photo-input');
  const preview = document.getElementById('reg-photo-preview');
  if(input) input.value = '';
  if(preview){ preview.src=''; preview.style.display='none'; }
  const text = document.getElementById('reg-photo-text');
  if(text) text.style.display = 'block';
  const filename = document.getElementById('reg-photo-filename');
  if(filename) filename.textContent = '';
}

function registerSubmit(){
  const role = document.querySelector('.role-opt.selected').dataset.role;
  const name = document.getElementById('reg-name').value.trim();
  const email = document.getElementById('reg-email').value.trim();
  const phone = document.getElementById('reg-phone').value.trim();
  const team = role === 'Official' ? '' : document.getElementById('reg-team').value.trim();
  const sport = role === 'Official' ? '—' : document.getElementById('reg-sport').value;
  const errEl = document.getElementById('register-error');
  const needsPassword = (role === 'Coach' || role === 'Official');
  const password = needsPassword ? document.getElementById('reg-password').value : '';

  const emailOk = /^\S+@\S+\.\S+$/.test(email);
  if(!name || !emailOk){
    errEl.textContent = 'Please enter your full name and a valid email.';
    errEl.style.display = 'block';
    return;
  }
  if(needsPassword && password.length < 6){
    errEl.textContent = 'Coaches and Officials must set a password (at least 6 characters).';
    errEl.style.display = 'block';
    return;
  }
  errEl.style.display = 'none';

  regIdCounter += 1;
  const newReg = {
    id: regIdCounter,
    role, name, email, phone,
    team: team || '—',
    sport,
    status: 'Pending',
    date: new Date().toLocaleDateString('en-US', {month:'short', day:'numeric', year:'numeric'}),
    photo: pendingRegPhoto
  };
  if(needsPassword) newReg.password = password;
  registrations.push(newReg);

  // Notify the admin that someone new has submitted their information via "Register Your Information".
  announcements.unshift({
    id: fsIdCounter++,
    t: `🆕 New ${role} Registration: ${name}`,
    d: `${name} submitted their information (${email}${phone ? ' · '+phone : ''}) and is awaiting your review in Registrations.`,
    forAdmin: true
  });
  logAudit('New Registration Submitted', `${name} registered as ${role} — awaiting admin review.`, name);

  renderRegistrationsAdmin();
  renderDirectory();
  buildDashboard();

  // Reset the form and send them back to the public live view.
  // Player/Spectator registrations are info-only. Coach/Official accounts are
  // created automatically (using the password they just set) once an admin approves them.
  document.getElementById('reg-name').value = '';
  document.getElementById('reg-email').value = '';
  document.getElementById('reg-phone').value = '';
  document.getElementById('reg-team').value = '';
  document.getElementById('reg-password').value = '';
  document.getElementById('reg-password-wrap').style.display = 'none';
  document.querySelectorAll('.role-opt').forEach(r=>r.classList.remove('selected'));
  document.querySelector('.role-opt[data-role="Player"]').classList.add('selected');
  document.getElementById('reg-team-sport-row').style.display = 'grid';
  resetPhotoUpload();

  showGate('gate-welcome');
  const msg = needsPassword
    ? `Thanks, ${name} — your ${role} registration was submitted. You can log in with the password you set once the admin approves it.`
    : `Thanks, ${name} — your registration was submitted for admin review.`;
  showToast(msg);
}
function adminLogin(){
  const email = document.getElementById('admin-email').value.trim();
  const pass = document.getElementById('admin-pass').value.trim();
  if(email==='admin@gmail.com' && pass==='admin123'){
    enterApp('admin','Administrator');
  } else {
    document.getElementById('admin-error').style.display='block';
  }
}
function coachLogin(){
  const email = document.getElementById('coach-email').value.trim().toLowerCase();
  const pass = document.getElementById('coach-pass').value.trim();
  const acct = coachAccounts.find(c=>c.email.toLowerCase()===email && c.password===pass);
  if(acct){
    currentCoachEmail = acct.email;
    enterApp('coach', acct.name);
  } else {
    const pendingCoach = registrations.find(r=>r.role==='Coach' && r.email.toLowerCase()===email && r.status==='Pending');
    const errEl = document.getElementById('coach-error');
    errEl.textContent = pendingCoach
      ? 'Your coach registration is still awaiting admin approval. Check back once it\'s approved.'
      : 'Invalid email or password. Try again, or register first if you\'re a new coach.';
    errEl.style.display='block';
  }
}
function officialLogin(){
  const email = document.getElementById('official-email').value.trim().toLowerCase();
  const pass = document.getElementById('official-pass').value.trim();
  const acct = officialAccounts.find(o=>o.email.toLowerCase()===email && o.password===pass);
  if(acct){
    currentOfficialEmail = acct.email;
    enterApp('official', acct.name);
  } else {
    const pendingOfficial = registrations.find(r=>r.role==='Official' && r.email.toLowerCase()===email && r.status==='Pending');
    const errEl = document.getElementById('official-error');
    errEl.textContent = pendingOfficial
      ? 'Your official registration is still awaiting admin approval. Check back once it\'s approved.'
      : 'Invalid email or password. Try again, or register first if you\'re a new official.';
    errEl.style.display='block';
  }
}
function enterApp(role, name){
  currentRole = role;
  document.body.classList.add('app-entered');
  document.querySelectorAll('.gate').forEach(g=>g.style.display='none');
  document.getElementById('app').style.display='flex';
  const isAdmin = role==='admin';
  const isCoach = role==='coach';
  const isOfficial = role==='official';
  document.getElementById('admin-nav-label').style.display = isAdmin?'block':'none';
  document.getElementById('admin-nav-registrations').style.display = isAdmin?'flex':'none';
  document.getElementById('admin-nav-teams').style.display = isAdmin?'flex':'none';
  document.getElementById('admin-nav-notifications').style.display = isAdmin?'flex':'none';
  document.getElementById('admin-nav-generator').style.display = isAdmin?'flex':'none';
  document.getElementById('admin-nav-auditlog').style.display = isAdmin?'flex':'none';
  document.getElementById('admin-nav-reports').style.display = isAdmin?'flex':'none';
  document.getElementById('coach-nav-label').style.display = isCoach?'block':'none';
  document.getElementById('coach-nav-myteam').style.display = isCoach?'flex':'none';
  document.getElementById('coach-nav-reports').style.display = isCoach?'flex':'none';
  document.getElementById('official-nav-label').style.display = isOfficial?'block':'none';
  document.getElementById('official-nav-registrations').style.display = isOfficial?'flex':'none';
  document.getElementById('official-nav-schedule').style.display = isOfficial?'flex':'none';
  updateRegistrationBadges();
  document.getElementById('sidebar-role').textContent = name ? `${name} · ${cap(role)}` : cap(role);
  // Officials assist the admin on tournament operations: schedule management, standings stay admin-only, bracket generation is shared.
  document.getElementById('schedule-admin-add').style.display = (isAdmin||isOfficial) ? 'block' : 'none';
  document.getElementById('standings-add-btn').style.display = isAdmin ? 'inline-flex' : 'none';
  document.getElementById('standings-actions-head').style.display = isAdmin ? 'table-cell' : 'none';
  document.getElementById('bracket-generator-card').style.display = (isAdmin||isOfficial) ? 'block' : 'none';
  document.getElementById('schedule-generator-card').style.display = (isAdmin||isOfficial) ? 'block' : 'none';
  const regRoleFilterEl = document.getElementById('reg-role-filter');
  if(regRoleFilterEl){
    regRoleFilterEl.querySelectorAll('option[value="Official"], option[value="Spectator"]').forEach(o=>{
      o.style.display = isOfficial ? 'none' : '';
    });
    if(isOfficial && (regRoleFilterEl.value==='Official' || regRoleFilterEl.value==='Spectator')) regRoleFilterEl.value='all';
  }
  regRoleFilter = regRoleFilterEl ? regRoleFilterEl.value : 'all';
  buildAll();
  nav(isCoach?'myteam':'dashboard');
  showToast(isAdmin ? 'Welcome back, Administrator' : isCoach ? `Welcome back, Coach ${name.split(' ')[0]}` : isOfficial ? `Welcome back, ${name.split(' ')[0]}` : `Account created — welcome, ${name}!`);
}
function cap(s){return s.charAt(0).toUpperCase()+s.slice(1);}
function logout(){
  document.getElementById('app').style.display='none';
  currentRole='spectator';
  currentCoachEmail=null;
  currentOfficialEmail=null;
  showGate('gate-welcome');
  document.getElementById('admin-email').value='';
  document.getElementById('admin-pass').value='';
  const ce=document.getElementById('coach-email'), cp=document.getElementById('coach-pass');
  if(ce) ce.value=''; if(cp) cp.value='';
  const oe=document.getElementById('official-email'), op=document.getElementById('official-pass');
  if(oe) oe.value=''; if(op) op.value='';
}

/* ---------------- NAV ---------------- */
const titles = {
  dashboard:['Dashboard',"Welcome back — here's what's happening today"],
  tournaments:['Tournaments','Browse ongoing, upcoming, and completed events'],
  'tourney-detail':['Tournament Details','Teams currently competing in this tournament'],
  bracket:['Bracket','Live bracket — auto-updates after every result'],
  schedule:['Match Schedule',"Today's fixtures across all venues"],
  standings:['Standings','Auto-calculated after every game'],
  search:['Player Search','Find any player across teams, sports, and tournaments'],
  directory:['Directory','Everyone who has registered — public view'],
  registrations:['Registrations','Manage everyone who has submitted their information'],
  teams:['Teams','All teams registered across every tournament'],
  notifications:['Notifications','Send updates to coaches, players, and spectators'],
  generator:['Tournament Generator','Create a tournament and auto-generate fixtures'],
  auditlog:['Audit Log','Every match-result and approval change, recorded'],
  reports:['Reports','Export tournament data as PDF, Excel, or CSV'],
  myteam:['My Team','Manage your roster, documents, and registrations'],
};
function nav(screen){
  currentScreen = screen;
  document.querySelectorAll('.screen').forEach(s=>s.classList.remove('active'));
  document.getElementById('screen-'+screen).classList.add('active');
  document.querySelectorAll('.navlink').forEach(n=>n.classList.toggle('active', n.dataset.screen===screen));
  document.querySelectorAll('.mnav-item').forEach(n=>n.classList.toggle('active', n.dataset.screen===screen));
  document.getElementById('topbar-title').textContent = titles[screen][0];
  document.getElementById('topbar-sub').textContent = titles[screen][1];
  if(screen==='teams') renderTeamsAdmin();
  window.scrollTo({top:0,behavior:'smooth'});
}

/* ---- Tournament Detail: view a tournament + its participating teams (all roles). Admin can delete a team from here. ---- */
function openTourneyDetail(tournamentId){
  viewingTourneyId = tournamentId;
  const t = tournaments.find(t=>t.id===tournamentId);
  if(!t) return;
  const headEl = document.getElementById('tourney-detail-head');
  const countEl = document.getElementById('tourney-detail-count');
  const teamsEl = document.getElementById('tourney-detail-teams');
  // Only the admin, or the ONE official assigned to this specific tournament, can approve/delete teams
  // or generate its bracket. An official assigned to a different tournament gets view-only here.
  const canManageTeams = canManageTournament(t);
  const assignedName = officialNameByEmail(t.assignedOfficial);

  const assignmentHtml = currentRole === 'admin' ? `
    <div style="margin-top:14px;padding-top:14px;border-top:1px solid var(--line);">
      <label style="display:block;font-size:12px;color:var(--muted);margin-bottom:8px;font-weight:600;text-transform:uppercase;letter-spacing:.03em;">Assigned Official</label>
      <div style="display:flex;gap:10px;flex-wrap:wrap;align-items:center;">
        <select id="assign-official-select" style="background:var(--panel-2);border:1px solid var(--line);border-radius:9px;padding:9px 11px;color:var(--text);font-size:13px;min-width:220px;">
          <option value="">— Unassigned —</option>
          ${officialAccounts.map(o=>`<option value="${o.email}" ${t.assignedOfficial===o.email?'selected':''}>${o.name}</option>`).join('')}
        </select>
        <button class="btn btn-primary btn-sm" onclick="saveOfficialAssignment(${t.id})">Save</button>
      </div>
      <p class="topbar-sub" style="text-transform:none;margin-top:8px;">Only this official can delete teams and generate the bracket for this tournament.</p>
    </div>
  ` : `
    <div style="margin-top:14px;padding-top:14px;border-top:1px solid var(--line);">
      <span class="topbar-sub" style="text-transform:none;">Assigned Official: <b style="color:var(--text);">${assignedName || 'Unassigned'}</b></span>
    </div>
  `;

  headEl.innerHTML = `
    <div style="display:flex;justify-content:space-between;align-items:flex-start;flex-wrap:wrap;gap:10px;">
      <div>
        <h2 style="font-size:20px;">${t.name}</h2>
        <div class="topbar-sub" style="text-transform:none;margin-top:6px;">${t.sport} · ${t.format} · ${t.venue} · ${t.dates}${t.minPlayers ? ` · Min ${t.minPlayers} player(s)/team` : ''}</div>
      </div>
      <span class="pill ${t.status==='Ongoing'?'pill-live':t.status==='Upcoming'?'pill-upcoming':'pill-done'}">${t.status}</span>
    </div>
    ${assignmentHtml}
  `;

  const joined = teams.filter(tm=>tm.tournament===t.name);
  const approved = joined.filter(tm=>tm.status==='Approved');
  countEl.textContent = `${approved.length} approved of ${t.teams} slot(s) · ${joined.length} total registered`;

  teamsEl.innerHTML = joined.map(tm=>`
    <div class="card team-card-clickable" onclick="openTeamRosterModal(${tm.id})">
      <div style="display:flex;justify-content:space-between;align-items:flex-start;margin-bottom:10px;">
        <div class="team-logo" style="width:36px;height:36px;font-size:13px;background:${colorFor(tm.name)}">${initials(tm.name)}</div>
        <span class="pill ${tm.status==='Approved'?'pill-upcoming':tm.status==='Rejected'?'pill-done':'pill-live'}">${tm.status}</span>
      </div>
      <h3 style="font-size:15px;">${tm.name}</h3>
      <div class="topbar-sub" style="text-transform:none;margin:4px 0 8px;">Coach ${tm.coach}</div>
      <div style="font-size:12px;color:var(--muted);margin-bottom:${canManageTeams?'12px':'0'};">${tm.players.length} player(s) on roster · tap to view</div>
      ${canManageTeams ? `
      <div style="display:flex;gap:8px;flex-wrap:wrap;">
        ${tm.status==='Pending' ? `
          <button class="btn btn-outline-mint btn-sm" onclick="event.stopPropagation();setTeamStatusFromDetail(${tm.id})">Approve</button>
        ` : ''}
        <button class="btn btn-danger btn-sm" onclick="event.stopPropagation();deleteTeamFromDetail(${tm.id})">Delete Team</button>
      </div>` : ''}
    </div>`).join('') || `<p class="topbar-sub" style="text-transform:none;">No teams have registered for this tournament yet.</p>`;

  document.querySelectorAll('.screen').forEach(s=>s.classList.remove('active'));
  document.getElementById('screen-tourney-detail').classList.add('active');
  document.getElementById('topbar-title').textContent = t.name;
  document.getElementById('topbar-sub').textContent = 'Teams currently competing in this tournament';
  window.scrollTo({top:0,behavior:'smooth'});
}
function saveOfficialAssignment(tournamentId){
  const t = tournaments.find(t=>t.id===tournamentId);
  if(!t || currentRole !== 'admin') return;
  const sel = document.getElementById('assign-official-select');
  const email = sel.value || null;
  t.assignedOfficial = email;
  const name = officialNameByEmail(email);
  logAudit('Official Assigned', `${name ? `"${name}"` : 'No official'} assigned to manage "${t.name}".`, actorLabel());
  buildTourneyList(document.querySelector('#tourney-tabs .tab-btn.active')?.dataset.filter || 'all');
  populateBracketTournamentSelect();
  populateScheduleTournamentSelect();
  populateNewMatchTournamentSelect();
  if(viewingTourneyId) openTourneyDetail(viewingTourneyId);
  showToast(name ? `${name} assigned to "${t.name}"` : `Unassigned official from "${t.name}"`);
}
function setTeamStatusFromDetail(teamId){
  const t = teams.find(t=>t.id===teamId);
  if(!t) return;
  const tourney = tournaments.find(x=>x.name===t.tournament);
  if(!canManageTournament(tourney)){ showToast('Only the admin or this tournament\'s assigned official can do that.'); return; }
  // Safety net: re-check the minimum-roster rule in case players were removed
  // from the team after it requested to join but before the admin approved it.
  const minPlayers = tourney?.minPlayers || 0;
  if(minPlayers > 0 && t.players.length < minPlayers){
    showToast(`Can't approve — ${t.name} needs at least ${minPlayers} player(s) but only has ${t.players.length}.`);
    return;
  }
  t.status = 'Approved';
  t.eligibility = 'Eligible';
  logAudit('Team Approved', `"${t.name}" approved for ${t.tournament}.`, actorLabel());
  announcements.unshift({
    id: fsIdCounter++,
    t: `✅ ${t.name} is confirmed for ${t.tournament}`,
    d: `Your registration has been approved by the admin. Your team is now eligible to compete.`,
    forCoach: t.coach
  });
  buildMyTeam();
  renderTeamsAdmin();
  if(viewingTourneyId) openTourneyDetail(viewingTourneyId);
  showToast(`${t.name} approved`);
}
function deleteTeamFromDetail(teamId){
  const t = teams.find(t=>t.id===teamId);
  if(!t) return;
  const tourney = tournaments.find(x=>x.name===t.tournament);
  if(!canManageTournament(tourney)){ showToast('Only the admin or this tournament\'s assigned official can delete a team here.'); return; }
  if(!confirm(`Delete team "${t.name}" from ${t.tournament}? This can't be undone.`)) return;
  const idx = teams.findIndex(x=>x.id===teamId);
  teams.splice(idx,1);
  deleteFromFirestore('teams', teamId);
  logAudit('Team Deleted', `"${t.name}" was deleted by ${currentRole==='official'?'an official':'admin'} from ${t.tournament}.`, actorLabel());
  buildMyTeam();
  renderTeamsAdmin();
  if(viewingTourneyId) openTourneyDetail(viewingTourneyId);
  showToast(`Deleted team "${t.name}"`);
}

/* ---- Team Roster Modal: click any team card (Participating Teams, or the admin Teams page)
   to see that team's coach + its full list of rostered players. Read-only — view only, no editing here. ---- */
function openTeamRosterModal(teamId){
  const tm = teams.find(t=>t.id===teamId);
  if(!tm) return;
  const body = document.getElementById('team-roster-modal-body');
  if(!body) return;
  body.innerHTML = `
    <div style="display:flex;align-items:center;gap:12px;margin-bottom:2px;padding-right:30px;">
      <div class="team-logo" style="width:44px;height:44px;font-size:15px;flex-shrink:0;background:${colorFor(tm.name)}">${initials(tm.name)}</div>
      <div style="min-width:0;">
        <h2 style="font-size:18px;line-height:1.2;">${tm.name}</h2>
        <div class="topbar-sub" style="text-transform:none;margin-top:3px;">${tm.sport}${tm.tournament && tm.tournament!=='—' ? ' · '+tm.tournament : ''}</div>
      </div>
      <span class="pill ${tm.status==='Approved'?'pill-upcoming':tm.status==='Rejected'?'pill-done':'pill-live'}" style="margin-left:auto;flex-shrink:0;">${tm.status}</span>
    </div>
    <div class="team-roster-coach-box">
      <div class="team-roster-label">Coach</div>
      <div style="font-size:15px;font-weight:600;">${tm.coach || '—'}</div>
    </div>
    <div class="section-head" style="margin-top:18px;margin-bottom:4px;"><h2 style="font-size:14px;">Roster</h2><span class="topbar-sub" style="margin:0;">${tm.players.length} player(s)</span></div>
    <div>
      ${tm.players.map(p=>`
        <div class="reg-row">
          <div class="reg-meta">
            <div class="avatar" style="width:34px;height:34px;font-size:12px;">${initials(p)}</div>
            <div class="reg-info"><div class="name">${p}</div></div>
          </div>
        </div>`).join('') || `<p class="topbar-sub" style="text-transform:none;">No players listed on this team's roster yet.</p>`}
    </div>
  `;
  document.getElementById('team-roster-overlay').classList.add('open');
}
function closeTeamRosterModal(){
  const el = document.getElementById('team-roster-overlay');
  if(el) el.classList.remove('open');
}
document.addEventListener('keydown', function(e){
  if(e.key === 'Escape'){ closeTeamRosterModal(); closeMatchQr(); }
});

/* ---- Teams (Admin-only): every team across every tournament, filterable, approve/delete from one place ---- */
function populateTeamsTournamentFilter(){
  const sel = document.getElementById('teams-tournament-filter');
  if(!sel) return;
  const current = sel.value || 'all';
  const names = [...new Set(teams.map(t=>t.tournament))];
  sel.innerHTML = `<option value="all">All Tournaments</option>` + names.map(n=>`<option value="${n}">${n}</option>`).join('');
  sel.value = names.includes(current) ? current : 'all';
}
function filterTeamsAdmin(){ renderTeamsAdmin(); }
function renderTeamsAdmin(){
  const el = document.getElementById('teams-admin-list');
  if(!el) return;
  populateTeamsTournamentFilter();
  const tournyFilter = document.getElementById('teams-tournament-filter')?.value || 'all';
  const statusFilter = document.getElementById('teams-status-filter')?.value || 'all';
  let list = teams;
  if(tournyFilter !== 'all') list = list.filter(t=>t.tournament===tournyFilter);
  if(statusFilter !== 'all') list = list.filter(t=>t.status===statusFilter);
  const countEl = document.getElementById('teams-count');
  if(countEl) countEl.textContent = `${list.length} of ${teams.length} total`;
  el.innerHTML = list.map(tm=>`
    <div class="card team-card-clickable" onclick="openTeamRosterModal(${tm.id})">
      <div style="display:flex;justify-content:space-between;align-items:flex-start;margin-bottom:10px;">
        <div class="team-logo" style="width:36px;height:36px;font-size:13px;background:${colorFor(tm.name)}">${initials(tm.name)}</div>
        <span class="pill ${tm.status==='Approved'?'pill-upcoming':tm.status==='Rejected'?'pill-done':'pill-live'}">${tm.status}</span>
      </div>
      <h3 style="font-size:15px;">${tm.name}</h3>
      <div class="topbar-sub" style="text-transform:none;margin:4px 0 2px;">Coach ${tm.coach}</div>
      <div class="topbar-sub" style="text-transform:none;margin-bottom:8px;">${tm.sport} · ${tm.tournament}</div>
      <div style="font-size:12px;color:var(--muted);margin-bottom:12px;">${tm.players.length} player(s) on roster · tap to view</div>
      <div style="display:flex;gap:8px;flex-wrap:wrap;">
        ${tm.status==='Pending' ? `<button class="btn btn-outline-mint btn-sm" onclick="event.stopPropagation();setTeamStatusFromDetail(${tm.id})">Approve</button>` : ''}
        <button class="btn btn-danger btn-sm" onclick="event.stopPropagation();deleteTeamFromAdmin(${tm.id})">Delete Team</button>
      </div>
    </div>`).join('') || `<p class="topbar-sub" style="text-transform:none;">No teams match this filter.</p>`;
}
function deleteTeamFromAdmin(teamId){
  const t = teams.find(t=>t.id===teamId);
  if(!t) return;
  if(currentRole !== 'admin'){ showToast('Only the admin can delete a team here.'); return; }
  if(!confirm(`Delete team "${t.name}" from ${t.tournament}? This can't be undone.`)) return;
  const idx = teams.findIndex(x=>x.id===teamId);
  teams.splice(idx,1);
  deleteFromFirestore('teams', teamId);
  logAudit('Team Deleted', `"${t.name}" was deleted by admin from ${t.tournament}.`, actorLabel());
  buildMyTeam();
  renderTeamsAdmin();
  if(viewingTourneyId) openTourneyDetail(viewingTourneyId);
  showToast(`Deleted team "${t.name}"`);
}


/* ---------------- BUILDERS ---------------- */
function buildAll(){
  buildTicker();
  buildDashboard();
  buildTourneyList('all');
  buildBracket();
  buildSchedule();
  renderStandings();
  renderPlayers();
  renderDirectory();
  renderRegistrationsAdmin();
  renderSentNotifications();
  renderAuditLog();
  buildMyTeam();
  populateBracketTournamentSelect();
  populateScheduleTournamentSelect();
  populateNewMatchTournamentSelect();
  const toggle = document.getElementById('public-info-toggle');
  if(toggle) toggle.checked = publicInfoVisible;
}

const TICKER_ITEMS = [
  {live:true, t:'Iron Spikers vs Coastal Smash', s:'2 - 1'},
  {live:true, t:'Team Vortex vs Neon Circuit', s:'13 - 9'},
  {live:false, t:'Northside Ballers def. River Hawks', s:'88 - 75'},
  {live:false, t:'Granite Wolves vs Summit FC', s:'Finals Aug 24'},
  {live:false, t:'Regional Esports Showdown', s:'Round 3 underway'},
  {live:false, t:'City Volleyball Championship', s:'Semis this weekend'},
];
function buildTicker(elId){
  const html = TICKER_ITEMS.map(i=>`<div class="tick-item">${i.live?'<span class="tick-live">LIVE</span>':'<span>●</span>'} ${i.t} <span class="tick-score">${i.s}</span></div>`).join('');
  const target = document.getElementById(elId || 'ticker-track');
  if(target) target.innerHTML = html + html;
}

/* ---- Public landing: live sports, visible to everyone, no login required ---- */
function buildLandingLive(){
  buildTicker('landing-ticker-track');
  const live = schedule.filter(s=>s.status==='live');
  const list = live.length ? live : schedule.filter(s=>s.status==='upcoming').slice(0,3);
  document.getElementById('landing-live-title').textContent = live.length ? 'Live Right Now' : 'Next Up';
  document.getElementById('landing-live-list').innerHTML = list.map(m=>`
    <div class="card ${m.status==='live'?'live-clickable':''}" ${m.status==='live'?`onclick="openLiveViewer(${m.id})"`:''}>
      <div style="display:flex;justify-content:space-between;align-items:center;margin-bottom:10px;">
        <span class="mono" style="color:var(--muted);font-size:12px;">${m.time} · ${m.venue}</span>
        <span class="pill ${m.status==='live'?'pill-live':'pill-upcoming'}">${m.status==='live'?'Live':'Upcoming'}</span>
      </div>
      <div class="team-cell" style="margin-bottom:8px;"><div class="team-logo" style="background:${colorFor(m.a)}">${initials(m.a)}</div>${m.a}</div>
      <div class="team-cell"><div class="team-logo" style="background:${colorFor(m.b)}">${initials(m.b)}</div>${m.b}</div>
    </div>`).join('') || `<p class="topbar-sub" style="text-transform:none;">No matches scheduled right now — check back soon.</p>`;
}

/* ---- Directory: public list, everyone can view; contact info gated by admin toggle ---- */
function renderDirectory(){
  const el = document.getElementById('directory-list');
  if(!el) return;
  el.innerHTML = registrations.map(r=>`
    <div class="reg-row">
      <div class="reg-meta">
        <div class="avatar" style="width:40px;height:40px;font-size:14px;">${r.photo ? `<img src="${r.photo}" alt="${r.name}">` : initials(r.name)}</div>
        <div class="reg-info">
          <div class="name">${r.name}</div>
          <div class="sub">${r.team!=='—' ? r.team+' · ' : ''}${r.sport}</div>
        </div>
      </div>
      <div style="display:flex;align-items:center;gap:14px;">
        ${publicInfoVisible
          ? `<div class="reg-contact">${r.email}<br>${r.phone||''}</div>`
          : `<div class="reg-contact hidden-info">Contact hidden by admin</div>`}
        <span class="role-tag">${r.role}</span>
      </div>
    </div>`).join('') || `<p class="topbar-sub" style="text-transform:none;">No one has registered yet.</p>`;
}

/* ---- Registrations (admin-only): manage, view personal info, approve, delete ---- */
let regRoleFilter = 'all';
function filterRegRole(sel){
  regRoleFilter = sel.value;
  renderRegistrationsAdmin();
}
/* ---- Nav badges: show a red count bubble on the Registrations nav item while there are Pending registrations ---- */
function updateRegistrationBadges(){
  const pendingAll = registrations.filter(r=>r.status==='Pending');
  const pendingOfficialScope = pendingAll.filter(r=>r.role==='Player'||r.role==='Coach');
  const adminBadge = document.getElementById('admin-registrations-badge');
  const officialBadge = document.getElementById('official-registrations-badge');
  if(adminBadge){
    adminBadge.textContent = pendingAll.length > 99 ? '99+' : pendingAll.length;
    adminBadge.style.display = pendingAll.length > 0 ? 'inline-block' : 'none';
  }
  if(officialBadge){
    officialBadge.textContent = pendingOfficialScope.length > 99 ? '99+' : pendingOfficialScope.length;
    officialBadge.style.display = pendingOfficialScope.length > 0 ? 'inline-block' : 'none';
  }
}
function renderRegistrationsAdmin(){
  const el = document.getElementById('registrations-list');
  const countEl = document.getElementById('reg-count');
  updateRegistrationBadges();
  if(!el) return;
  // Officials assist the admin here too, but only for Player and Coach registrations — not fellow Officials or Spectators.
  const scoped = currentRole==='official' ? registrations.filter(r=>r.role==='Player'||r.role==='Coach') : registrations;
  const list = regRoleFilter==='all' ? scoped : scoped.filter(r=>r.role===regRoleFilter);
  if(countEl) countEl.textContent = `${list.length} of ${scoped.length} total`;
  el.innerHTML = list.map(r=>`
    <div class="reg-row">
      <div class="reg-meta">
        <div class="avatar" style="width:40px;height:40px;font-size:14px;">${r.photo ? `<img src="${r.photo}" alt="${r.name}">` : initials(r.name)}</div>
        <div class="reg-info">
          <div class="name">${r.name} <span class="role-tag" style="margin-left:6px;">${r.role}</span></div>
          <div class="sub">${r.team!=='—' ? r.team+' · ' : ''}${r.sport} · Registered ${r.date}</div>
        </div>
      </div>
      <div style="display:flex;align-items:center;gap:16px;flex-wrap:wrap;">
        <div class="reg-contact">${r.email}<br>${r.phone||''}</div>
        <span class="pill ${r.status==='Approved'?'pill-upcoming':r.status==='Rejected'?'pill-done':'pill-live'}">${r.status}</span>
        ${r.status==='Pending' ? `
          <button class="btn btn-outline-mint btn-sm" onclick="approveRegistration(${r.id})">Approve</button>
          <button class="btn btn-ghost btn-sm" onclick="rejectRegistration(${r.id})">Reject</button>
        ` : ''}
        <button class="btn btn-danger btn-sm" onclick="deleteRegistration(${r.id})">Delete</button>
      </div>
    </div>`).join('') || `<p class="topbar-sub" style="text-transform:none;">No registrations match this filter.</p>`;
}
function approveRegistration(id){
  const reg = registrations.find(r=>r.id===id);
  if(!reg) return;
  reg.status = 'Approved';

  if(reg.role === 'Coach'){
    const existing = coachAccounts.find(c=>c.email.toLowerCase()===reg.email.toLowerCase());
    if(existing){
      showToast(`${reg.name} already has a coach account.`);
    } else {
      coachAccounts.push({email:reg.email, password:reg.password, name:reg.name, team: ''});
      logAudit('Coach Account Approved', `${reg.name} approved as coach — dashboard login created with their chosen password.`, actorLabel());
      showToast(`Coach account created for ${reg.name}. They can now log in with the password they set.`);
    }
  } else if(reg.role === 'Official'){
    const existing = officialAccounts.find(o=>o.email.toLowerCase()===reg.email.toLowerCase());
    if(existing){
      showToast(`${reg.name} already has an official account.`);
    } else {
      officialAccounts.push({email:reg.email, password:reg.password, name:reg.name});
      logAudit('Official Account Approved', `${reg.name} approved as official — dashboard login created with their chosen password.`, 'Administrator');
      showToast(`Official account created for ${reg.name}. They can now log in with the password they set.`);
    }
  } else {
    logAudit('Registration Approved', `${reg.name} (${reg.role}) approved.`, actorLabel());
    showToast(`Approved ${reg.name}'s registration.`);
  }
  renderRegistrationsAdmin();
  renderDirectory();
}
function rejectRegistration(id){
  const reg = registrations.find(r=>r.id===id);
  if(!reg) return;
  reg.status = 'Rejected';
  logAudit('Registration Rejected', `${reg.name} (${reg.role}) registration rejected.`, actorLabel());
  renderRegistrationsAdmin();
  renderDirectory();
  showToast(`Rejected ${reg.name}'s registration.`);
}
function deleteRegistration(id){
  const reg = registrations.find(r=>r.id===id);
  if(!reg) return;
  if(!confirm(`Delete ${reg.name}'s registration? This can't be undone.`)) return;
  const idx = registrations.findIndex(r=>r.id===id);
  registrations.splice(idx,1);
  deleteFromFirestore('registrations', id);

  // If this person also has a login account (Coach/Official), revoke it too so they can no longer sign in.
  let accountRevoked = false;
  if(reg.role === 'Coach'){
    const ai = coachAccounts.findIndex(c=>c.email.toLowerCase()===reg.email.toLowerCase());
    if(ai !== -1){ const removedEmail = coachAccounts[ai].email; coachAccounts.splice(ai,1); deleteFromFirestore('coachAccounts', removedEmail); accountRevoked = true; }
  } else if(reg.role === 'Official'){
    const ai = officialAccounts.findIndex(o=>o.email.toLowerCase()===reg.email.toLowerCase());
    if(ai !== -1){ const removedEmail = officialAccounts[ai].email; officialAccounts.splice(ai,1); deleteFromFirestore('officialAccounts', removedEmail); accountRevoked = true; }
  }

  logAudit('Registration Deleted', `${reg.name} (${reg.role}) registration deleted.${accountRevoked ? ' Their login account was also revoked.' : ''}`, actorLabel());
  renderRegistrationsAdmin();
  renderDirectory();
  renderPlayers();
  showToast(accountRevoked ? `Deleted ${reg.name} and revoked their account access` : `Deleted registration for ${reg.name}`);
}

/* ---- Delete a registered player straight from Search Players (admin/official only) ---- */
function deletePlayerFromSearch(id){
  if(currentRole !== 'admin' && currentRole !== 'official'){
    showToast('Only the admin or an official can remove a player here.');
    return;
  }
  deleteRegistration(id);
}
function togglePublicInfo(checkbox){
  publicInfoVisible = checkbox.checked;
  renderDirectory();
  showToast(publicInfoVisible ? 'Personal info is now visible to all users in the Directory' : 'Personal info is now hidden from the public Directory');
}

/* ---- Notifications (Admin): send + recently sent list ---- */
const sentNotifications = [];
function sendNotification(){
  const type = document.getElementById('notif-type').value;
  const title = document.getElementById('notif-title').value.trim();
  const msg = document.getElementById('notif-msg').value.trim();
  if(!title || !msg){
    showToast('Title and message are required.');
    return;
  }
  sentNotifications.unshift({type, title, msg, when: new Date().toLocaleDateString('en-US',{month:'short',day:'numeric',year:'numeric'})});
  announcements.unshift({id: fsIdCounter++, t:title, d:msg});
  document.getElementById('notif-title').value='';
  document.getElementById('notif-msg').value='';
  renderSentNotifications();
  buildDashboard();
  logAudit('Notification Sent', `"${title}" (${type}) sent to coaches, players, and spectators.`, 'Administrator');
  showToast('Notification sent');
}
function renderSentNotifications(){
  const el = document.getElementById('notif-sent-list');
  if(!el) return;
  el.innerHTML = sentNotifications.map(n=>`
    <div class="announce"><div class="announce-dot"></div><div>
      <b>${n.title}</b> <span class="topbar-sub" style="text-transform:none;">· ${n.type} · ${n.when}</span>
      <p>${n.msg}</p>
    </div></div>`).join('') || `<p class="topbar-sub" style="text-transform:none;">Nothing sent yet.</p>`;
}

/* ---- Audit Log (Admin) ---- */
function renderAuditLog(){
  const el = document.getElementById('auditlog-list');
  if(!el) return;
  el.innerHTML = auditLog.map(a=>`
    <div class="announce"><div class="announce-dot"></div><div>
      <b>${a.t}</b> <span class="topbar-sub" style="text-transform:none;">· ${a.who} · ${a.when}</span>
      <p>${a.d}</p>
    </div>
    <button class="btn btn-danger btn-sm announce-row-del" onclick="deleteAuditEntry(${a.id})">Delete</button></div>`).join('') || `<p class="topbar-sub" style="text-transform:none;">No activity recorded yet.</p>`;
}
function deleteAuditEntry(id){
  if(currentRole !== 'admin'){ showToast('Only the admin can delete audit log entries.'); return; }
  const idx = auditLog.findIndex(a=>a.id===id);
  if(idx === -1) return;
  auditLog.splice(idx,1);
  deleteFromFirestore('auditLog', id);
  renderAuditLog();
  showToast('Audit log entry deleted');
}
function clearAuditLog(){
  if(currentRole !== 'admin'){ showToast('Only the admin can clear the audit log.'); return; }
  if(!auditLog.length){ showToast('Audit log is already empty.'); return; }
  if(!confirm(`Clear all ${auditLog.length} audit log entries? This can't be undone.`)) return;
  const ids = auditLog.map(a=>a.id);
  auditLog.length = 0;
  clearCollectionFromFirestore('auditLog', ids);
  renderAuditLog();
  showToast('Audit log cleared');
}

/* ---- My Team (Coach): shows the logged-in coach's actual team, or a create-team prompt ---- */
function getMyTeam(){
  const acct = coachAccounts.find(c=>c.email===currentCoachEmail);
  if(!acct || !acct.team) return null;
  return teams.find(t=>t.name===acct.team) || null;
}
function createMyTeam(){
  const acct = coachAccounts.find(c=>c.email===currentCoachEmail);
  if(!acct){ showToast('Coach account not found.'); return; }
  if(acct.team){ showToast('You already have a team.'); return; }

  const name = document.getElementById('create-team-name').value.trim();
  const sport = document.getElementById('create-team-sport').value;
  if(!name){
    showToast('Enter a team name first.');
    return;
  }
  const nameTaken = teams.some(t=>t.name.toLowerCase()===name.toLowerCase());
  if(nameTaken){
    showToast('A team with that name already exists — pick a different name.');
    return;
  }

  teamIdCounter += 1;
  teams.push({
    id: teamIdCounter, name, sport, coach: acct.name,
    tournament: '—', status:'Approved', eligibility:'Eligible', players:[]
  });
  acct.team = name;

  logAudit('Team Created', `${acct.name} created team "${name}" (${sport}).`, acct.name);
  document.getElementById('create-team-name').value = '';
  buildMyTeam();
  showToast(`Team "${name}" created! You can now register it for a tournament.`);
}
function buildMyTeam(){
  const noTeamCard = document.getElementById('myteam-noteam-card');
  const hasTeamWrap = document.getElementById('myteam-hasteam-wrap');
  const statsEl = document.getElementById('myteam-stats');
  const infoEl = document.getElementById('myteam-info');
  const pillEl = document.getElementById('myteam-status-pill');
  const announceEl = document.getElementById('myteam-announce-list');
  const rosterCountEl = document.getElementById('myteam-roster-count');
  const rosterListEl = document.getElementById('myteam-roster-list');
  const upcomingEl = document.getElementById('myteam-upcoming');
  const availableEl = document.getElementById('myteam-available-tournaments');
  if(!statsEl) return;

  const team = getMyTeam();
  if(!team){
    if(noTeamCard) noTeamCard.style.display = 'block';
    if(hasTeamWrap) hasTeamWrap.style.display = 'none';
    return;
  }
  if(noTeamCard) noTeamCard.style.display = 'none';
  if(hasTeamWrap) hasTeamWrap.style.display = 'block';

  populateAddPlayerSelect();

  statsEl.innerHTML = `
    <div class="card stat-card"><span class="stat-label">Roster Size</span><div class="stat-value mono">${team.players.length}</div></div>
    <div class="card stat-card"><span class="stat-label">Team Status</span><div class="stat-value mono" style="font-size:20px;">${team.status}</div></div>
    <div class="card stat-card"><span class="stat-label">Eligibility</span><div class="stat-value mono" style="font-size:20px;">${team.eligibility}</div></div>
    <div class="card stat-card"><span class="stat-label">Tournament</span><div class="stat-value mono" style="font-size:15px;">${team.tournament!=='—'?team.tournament:'Unassigned'}</div></div>
  `;
  pillEl.textContent = team.status;
  pillEl.className = `pill ${team.status==='Approved'?'pill-upcoming':team.status==='Rejected'?'pill-done':'pill-live'}`;
  infoEl.innerHTML = `
    <div class="topbar-sub" style="text-transform:none;margin-bottom:6px;"><b style="color:var(--text);">${team.name}</b></div>
    <div class="topbar-sub" style="text-transform:none;">${team.sport} · Coach ${team.coach}</div>
    <div class="topbar-sub" style="text-transform:none;margin-top:4px;">${team.tournament!=='—' ? 'Registered for '+team.tournament : 'Not yet registered for a tournament — browse Available Tournaments below'}</div>
  `;
  // Show general announcements + anything specifically addressed to this coach or to coaches in general,
  // filtering out admin-only notices so the coach doesn't see internal approval-queue alerts.
  const myAnnouncements = announcements.filter(a => !a.forAdmin && (!a.forCoach || a.forCoach === team.coach)).slice(0,4);
  announceEl.innerHTML = myAnnouncements.map(a=>`
    <div class="announce"><div class="announce-dot"></div><div><b>${a.t}</b><p>${a.d}</p></div></div>`).join('') || `<p class="topbar-sub" style="text-transform:none;">No announcements yet.</p>`;

  rosterCountEl.textContent = `${team.players.length} player(s)`;
  rosterListEl.innerHTML = team.players.map((p,i)=>`
    <div class="reg-row">
      <div class="reg-meta">
        <div class="avatar" style="width:36px;height:36px;font-size:13px;">${initials(p)}</div>
        <div class="reg-info"><div class="name">${p}</div></div>
      </div>
      <button class="btn btn-danger btn-sm" onclick="removePlayerFromMyTeam(${i})">Remove</button>
    </div>`).join('') || `<p class="topbar-sub" style="text-transform:none;">No players on the roster yet.</p>`;

  const upcoming = schedule.filter(m => (m.a===team.name || m.b===team.name) && m.status!=='done');
  upcomingEl.innerHTML = upcoming.map(m=>`
    <div class="card ${m.status==='live'?'live-clickable':''}" ${m.status==='live'?`onclick="openLiveViewer(${m.id})"`:''}>
      <div style="display:flex;justify-content:space-between;align-items:center;margin-bottom:10px;">
        <span class="mono" style="color:var(--muted);font-size:12px;">${m.time} · ${m.venue}</span>
        <span class="pill ${m.status==='live'?'pill-live':'pill-upcoming'}">${m.status==='live'?'Live':'Upcoming'}</span>
      </div>
      <div class="team-cell" style="margin-bottom:8px;"><div class="team-logo" style="background:${colorFor(m.a)}">${initials(m.a)}</div>${m.a}</div>
      <div class="team-cell"><div class="team-logo" style="background:${colorFor(m.b)}">${initials(m.b)}</div>${m.b}</div>
    </div>`).join('') || `<p class="topbar-sub" style="text-transform:none;">No upcoming matches.</p>`;

  // Available Tournaments: every published tournament, showing this team's status in it
  // and letting the coach view participating teams or request to join.
  if(availableEl){
    const publishedTourneys = tournaments.filter(t=>t.published);
    availableEl.innerHTML = publishedTourneys.map(t=>{
      const approvedCount = teams.filter(tm => tm.tournament===t.name && tm.status==='Approved').length;
      const isMine = team.tournament === t.name;
      const minPlayers = t.minPlayers || 0;
      const shortOfMin = minPlayers > 0 && team.players.length < minPlayers;
      let actionHtml = '';
      if(isMine){
        actionHtml = `<span class="pill ${team.status==='Approved'?'pill-upcoming':'pill-live'}">${team.status}</span>`;
      } else if(!t.regOpen){
        actionHtml = `<span class="topbar-sub" style="text-transform:none;margin:0;">Registration closed</span>`;
      } else if(approvedCount >= t.teams){
        actionHtml = `<span class="topbar-sub" style="text-transform:none;margin:0;">Full (${t.teams}/${t.teams})</span>`;
      } else if(shortOfMin){
        actionHtml = `<span class="topbar-sub" style="text-transform:none;margin:0;color:var(--danger);">Need ${minPlayers - team.players.length} more player(s) to join</span>`;
      } else {
        actionHtml = `<button class="btn btn-primary btn-sm btn-block" onclick="registerTeamForTournament(${t.id})">Join with ${team.name}</button>`;
      }
      return `
      <div class="card">
        <div style="display:flex;justify-content:space-between;align-items:flex-start;margin-bottom:10px;">
          <div class="stat-icon" style="background:rgba(76,141,255,0.1);color:var(--lime);">🏆</div>
          <span class="pill ${t.status==='Ongoing'?'pill-live':t.status==='Upcoming'?'pill-upcoming':'pill-done'}">${t.status}</span>
        </div>
        <h3 style="font-size:15px;cursor:pointer;" onclick="openTourneyDetail(${t.id})">${t.name}</h3>
        <div class="topbar-sub" style="text-transform:none;margin:6px 0 10px;">${t.sport} · ${t.venue} · ${t.dates}</div>
        <div style="font-size:12px;color:var(--muted);margin-bottom:12px;">${approvedCount}/${t.teams} teams joined${minPlayers ? ` · Min ${minPlayers} player(s)/team` : ''}</div>
        <div style="display:flex;gap:8px;flex-wrap:wrap;">
          <button class="btn btn-ghost btn-sm" onclick="openTourneyDetail(${t.id})">View Teams</button>
        </div>
        <div style="margin-top:8px;">${actionHtml}</div>
      </div>`;
    }).join('') || `<p class="topbar-sub" style="text-transform:none;">No tournaments published yet.</p>`;
  }
}
function rosteredPlayerNames(){
  // Every player name currently sitting on any team's roster, across all teams.
  const set = new Set();
  teams.forEach(t => t.players.forEach(p => set.add(p)));
  return set;
}
function availableRegisteredPlayers(team){
  // Registered + approved players not yet placed on any team's roster,
  // AND only players whose preferred sport matches this team's sport —
  // this is what stops a coach from pulling in a player from a totally
  // different sport into their roster.
  const taken = rosteredPlayerNames();
  return registeredPlayers().filter(p => !taken.has(p.name) && (!team || p.sport === team.sport));
}
function populateAddPlayerSelect(){
  // Reset the search box + hidden selection whenever the roster panel rebuilds.
  const search = document.getElementById('new-player-search');
  const sel = document.getElementById('new-player-select');
  const results = document.getElementById('new-player-results');
  if(search) search.value = '';
  if(sel) sel.value = '';
  if(results){ results.style.display = 'none'; results.innerHTML = ''; }
}
function renderAddPlayerResults(){
  const search = document.getElementById('new-player-search');
  const results = document.getElementById('new-player-results');
  if(!search || !results) return;
  const team = getMyTeam();
  if(!team){ results.style.display = 'none'; return; }
  const q = search.value.trim().toLowerCase();
  const available = availableRegisteredPlayers(team).filter(p=>{
    if(!q) return true;
    return p.name.toLowerCase().includes(q) || (p.team||'').toLowerCase().includes(q) || (p.sport||'').toLowerCase().includes(q);
  });
  results.innerHTML = available.map(p=>`
    <div class="search-dropdown-item" style="padding:10px 12px;cursor:pointer;border-bottom:1px solid var(--border,#262E4D);" onmousedown="selectAddPlayer('${p.name.replace(/'/g,"\\'")}')">
      <div style="font-weight:600;font-size:13px;">${p.name}</div>
      <div style="font-size:12px;color:var(--muted);">${p.team && p.team!=='—' ? p.team+' · ' : ''}${p.sport}</div>
    </div>`).join('') || `<p class="topbar-sub" style="text-transform:none;padding:10px 12px;margin:0;">No registered, approved ${team.sport} players available to add right now.</p>`;
  results.style.display = 'block';
}
function selectAddPlayer(name){
  const search = document.getElementById('new-player-search');
  const sel = document.getElementById('new-player-select');
  const results = document.getElementById('new-player-results');
  if(search) search.value = name;
  if(sel) sel.value = name;
  if(results){ results.style.display = 'none'; }
}
function addPlayerToMyTeam(){
  const team = getMyTeam();
  if(!team){ showToast('No team linked to your account.'); return; }
  const sel = document.getElementById('new-player-select');
  const name = sel.value;
  if(!name){ showToast('Search and select a registered player first.'); return; }
  // Hard guard: the name must match an actual registered + admin-approved player,
  // AND that player's preferred sport must match this team's sport.
  // Never trust the input value alone — this is what stops a coach from adding
  // anyone who hasn't registered/been approved, or pulling in a player from a
  // different sport, even if the hidden field were tampered with.
  const match = registeredPlayers().find(p => p.name === name);
  if(!match){ showToast("That name isn't a registered, approved player."); populateAddPlayerSelect(); return; }
  if(match.sport !== team.sport){ showToast(`${name} registered for ${match.sport}, not ${team.sport} — can't add to this roster.`); populateAddPlayerSelect(); return; }
  // Guard against a player already on a roster (theirs or another team's) slipping through.
  if(rosteredPlayerNames().has(name)){ showToast('That player is already on a roster.'); populateAddPlayerSelect(); return; }
  team.players.push(name);
  populateAddPlayerSelect();
  buildMyTeam();
  showToast(`Added ${name} to ${team.name}`);
}
function removePlayerFromMyTeam(index){
  const team = getMyTeam();
  if(!team) return;
  const [removed] = team.players.splice(index,1);
  buildMyTeam();
  showToast(`Removed ${removed} from ${team.name}`);
}

document.addEventListener('DOMContentLoaded', function(){
  // A QR code (or shared link) opens this same file with ?live=<matchId> — jump straight
  // into the read-only public scoreboard for that one match, no login/gate needed.
  const liveParam = new URLSearchParams(window.location.search).get('live');
  if(liveParam){
    publicLiveMatchId = Number(liveParam);
    showGate('gate-public-live');
  }
  initFirestore();
});
document.addEventListener('click', function(e){
  const results = document.getElementById('new-player-results');
  const search = document.getElementById('new-player-search');
  if(!results || !search) return;
  if(e.target !== search && !results.contains(e.target)){
    results.style.display = 'none';
  }
});

function buildDashboard(){
  // Stat cards (Active Tournaments / Registered Teams / Matches Today / Total Players)
  // are admin/official-only — hidden for Coach and Spectator dashboards.
  const statsGrid = document.getElementById('dashboard-stats-grid');
  if(statsGrid) statsGrid.style.display = (currentRole==='coach' || currentRole==='spectator') ? 'none' : '';

  const live = schedule.filter(s=>s.status!=='done').slice(0,3);
  document.getElementById('today-matches').innerHTML = schedule.slice(0,3).map(m=>`
    <div class="card ${m.status==='live'?'live-clickable':''}" ${m.status==='live'?`onclick="openLiveViewer(${m.id})"`:''}>
      <div style="display:flex;justify-content:space-between;align-items:center;margin-bottom:12px;">
        <span class="mono" style="color:var(--muted);font-size:12px;">${m.time}</span>
        <span class="pill ${m.status==='live'?'pill-live':m.status==='done'?'pill-done':'pill-upcoming'}">${m.status==='live'?'Live':m.status==='done'?'Final':'Upcoming'}</span>
      </div>
      <div style="display:flex;justify-content:space-between;align-items:center;margin-bottom:6px;">
        <div class="team-cell"><div class="team-logo" style="background:${colorFor(m.a)}">${initials(m.a)}</div>${m.a}</div>
      </div>
      <div style="display:flex;justify-content:space-between;align-items:center;">
        <div class="team-cell"><div class="team-logo" style="background:${colorFor(m.b)}">${initials(m.b)}</div>${m.b}</div>
      </div>
      <div class="topbar-sub" style="margin-top:10px;text-transform:none;">${m.venue}</div>
    </div>`).join('');

  document.getElementById('dash-tournaments').innerHTML = tournaments.filter(t=>t.status!=='Completed').slice(0,3).map(t=>`
    <div class="card">
      <div style="display:flex;justify-content:space-between;align-items:flex-start;margin-bottom:10px;">
        <div class="stat-icon" style="background:rgba(76,141,255,0.1);color:var(--lime);">🏆</div>
        <span class="pill ${t.status==='Ongoing'?'pill-live':'pill-upcoming'}">${t.status}</span>
      </div>
      <h3 style="font-size:15px;">${t.name}</h3>
      <div class="topbar-sub" style="text-transform:none;margin-top:4px;">${t.sport} · ${t.teams} teams · ${t.dates}</div>
    </div>`).join('');

  // Public dashboard: hide admin-only approval-queue alerts and other coaches' personal notices.
  const isAdminView = currentRole === 'admin';
  const visibleAnnouncements = announcements.filter(a => isAdminView ? true : (!a.forAdmin && !a.forCoach));
  document.getElementById('announce-list').innerHTML = visibleAnnouncements.slice(0,6).map(a=>`
    <div class="announce"><div class="announce-dot"></div><div><b>${a.t}</b><p>${a.d}</p></div></div>`).join('') || `<p class="topbar-sub" style="text-transform:none;">No announcements yet.</p>`;

  document.getElementById('quick-stats').innerHTML = players.filter(p=>p.sport==='Basketball').slice(0,3).map(p=>`
    <div class="announce"><div class="avatar" style="width:34px;height:34px;font-size:13px;">${initials(p.name)}</div>
    <div style="flex:1;"><b>${p.name}</b><p>${p.team} · ${p.pts} PPG</p></div></div>`).join('');

  buildDashboardUpdates();
}

/* Action types from logAudit() that are safe/relevant to show on every role's Dashboard.
   Registration reviews, account approvals, and "Notification Sent" are admin-internal workflow
   (and can surface emails/personal info), so those stay on the admin-only Audit Log screen.
   Everything below is specifically an Admin/Official change TO the tournament itself — bracket,
   schedule, matches, scores, standings — which is exactly what should auto-display for
   Spectator/Coach/Official the instant it happens. */
const DASHBOARD_UPDATE_TYPES = new Set([
  'Tournament Created', 'Tournament Deleted', 'Official Assigned',
  'Bracket Generated', 'Schedule Generated',
  'Match Added', 'Match Updated', 'Match Deleted',
  'Standings Updated', 'Standings Row Removed',
  'Score Updated', 'Match Ended', 'Team Approved',
]);
function buildDashboardUpdates(){
  const el = document.getElementById('dashboard-updates-list');
  if(!el) return;
  // auditLog is newest-first (logAudit uses unshift), and it's already kept live via the same
  // onSnapshot listener as every other collection — no extra sync code needed here.
  const items = auditLog.filter(a => DASHBOARD_UPDATE_TYPES.has(a.t)).slice(0, 8);
  el.innerHTML = items.map(a => `
    <div class="announce">
      <div class="announce-dot"></div>
      <div>
        <b>${escapeHtml(a.t)}</b>
        <p>${escapeHtml(a.d)}</p>
        <p style="font-size:11px;color:var(--muted-2);margin-top:2px;text-transform:none;">${escapeHtml(a.who)} · ${escapeHtml(a.when)}</p>
      </div>
    </div>`).join('') || `<p class="topbar-sub" style="text-transform:none;">No tournament updates yet — anything Admin or an Official generates or changes (bracket, schedule, scores, standings) will show up here automatically.</p>`;
}

function buildTourneyList(filter){
  const list = filter==='all' ? tournaments : tournaments.filter(t=>t.status===filter);
  const myTeam = currentRole==='coach' ? getMyTeam() : null;

  document.getElementById('tourney-list').innerHTML = list.map(t=>{
    let actionHtml = '';
    if(currentRole === 'admin'){
      actionHtml = `<button class="btn btn-danger btn-sm btn-block" onclick="deleteTournament(${t.id})">Delete Tournament</button>`;
    } else if(currentRole === 'coach'){
      if(!myTeam){
        actionHtml = `<p class="topbar-sub" style="text-transform:none;margin:0;">You need to create a team before joining. Go to My Team.</p>`;
      } else if(myTeam.tournament === t.name){
        actionHtml = `<span class="pill ${myTeam.status==='Approved'?'pill-upcoming':'pill-live'}">${myTeam.name} — ${myTeam.status}</span>`;
      } else if(t.regOpen){
        actionHtml = `<button class="btn btn-primary btn-sm btn-block" onclick="registerTeamForTournament(${t.id})">Register My Team</button>`;
      } else {
        actionHtml = `<span class="topbar-sub" style="text-transform:none;margin:0;">Registration closed</span>`;
      }
    }
    return `
    <div class="card">
      <div style="display:flex;justify-content:space-between;align-items:flex-start;margin-bottom:10px;">
        <div class="stat-icon" style="background:rgba(76,141,255,0.1);color:var(--lime);">🏆</div>
        <span class="pill ${t.status==='Ongoing'?'pill-live':t.status==='Upcoming'?'pill-upcoming':'pill-done'}">${t.status}</span>
      </div>
      <h3 style="font-size:15px;cursor:pointer;" onclick="openTourneyDetail(${t.id})">${t.name}</h3>
      <div class="topbar-sub" style="text-transform:none;margin:6px 0 14px;">${t.sport} · ${t.venue}</div>
      <div style="display:flex;justify-content:space-between;font-size:12.5px;color:var(--muted);margin-bottom:12px;">
        <span>${t.teams} teams</span><span>${t.dates}</span>
      </div>
      ${currentRole==='admin' ? `<div style="font-size:11.5px;color:var(--muted-2);margin-bottom:10px;">Official: ${officialNameByEmail(t.assignedOfficial) || 'Unassigned'}</div>` : ''}
      ${currentRole==='official' && isAssignedOfficial(t) ? `<div style="font-size:11.5px;color:var(--mint);margin-bottom:10px;">✓ Assigned to you</div>` : ''}
      <button class="btn btn-ghost btn-sm btn-block" style="margin-bottom:${actionHtml?'10px':'0'};" onclick="openTourneyDetail(${t.id})">View Teams</button>
      ${actionHtml}
    </div>`;
  }).join('') || `<p class="topbar-sub" style="text-transform:none;">No tournaments in this category.</p>`;
}
function registerTeamForTournament(tournamentId){
  const t = tournaments.find(t=>t.id===tournamentId);
  if(!t) return;
  const team = getMyTeam();
  if(!team){ showToast('Create your team first before joining a tournament.'); nav('myteam'); return; }

  // Tournament must be fully set up by admin and open before a coach can join it.
  if(!t.published){ showToast('This tournament is not yet published by the admin.'); return; }
  if(!t.regOpen){ showToast('Registration for this tournament is closed.'); return; }

  if(team.tournament === t.name){ showToast(`${team.name} is already registered for ${t.name}.`); return; }

  // Team must meet the minimum roster size the admin set for this tournament
  // — a coach whose player list falls short can't join at all.
  const minPlayers = t.minPlayers || 0;
  if(minPlayers > 0 && team.players.length < minPlayers){
    showToast(`${team.name} needs at least ${minPlayers} player(s) on the roster to join ${t.name} — currently has ${team.players.length}. Add more players first.`);
    return;
  }

  // Respect the team-slot cap the admin set when generating the tournament.
  const approvedCount = teams.filter(tm => tm.tournament===t.name && tm.status==='Approved').length;
  if(approvedCount >= t.teams){
    showToast(`${t.name} is already full (${t.teams} teams). Registration is effectively closed.`);
    return;
  }

  if(team.tournament && team.tournament !== '—'){
    if(!confirm(`${team.name} is currently registered for "${team.tournament}". Switch to "${t.name}" instead?`)) return;
  }

  // Registering here NEVER auto-joins the tournament — it always creates a Pending
  // request that must go through Admin approval (View Teams inside the tournament) before the team is in.
  team.tournament = t.name;
  team.status = 'Pending';
  team.eligibility = 'Under Review';

  logAudit('Team Registration Requested', `${team.name} requested to join "${t.name}" — awaiting admin approval.`, team.coach || 'Coach');

  // Let the admin know a new approval is waiting for them — surfaces on the admin's Dashboard announcements.
  announcements.unshift({
    id: fsIdCounter++,
    t: '🔔 New Team Registration Awaiting Approval',
    d: `${team.name} (Coach ${team.coach || ''}) requested to join "${t.name}". Open the tournament's View Teams page to approve or delete it.`,
    forAdmin:true
  });

  buildTourneyList(document.querySelector('#tourney-tabs .tab-btn.active')?.dataset.filter || 'all');
  buildMyTeam();
  buildDashboard();
  showToast(`Requested to join ${t.name} for ${team.name} — pending admin approval. You'll be notified once it's approved.`);
}
function deleteTournament(id){
  const t = tournaments.find(t=>t.id===id);
  if(!t) return;
  const linkedTeams = teams.filter(tm=>tm.tournament===t.name);
  const warning = linkedTeams.length
    ? `Delete "${t.name}"? ${linkedTeams.length} team(s) are linked to it and will be unassigned. This can't be undone.`
    : `Delete "${t.name}"? This can't be undone.`;
  if(!confirm(warning)) return;

  const idx = tournaments.findIndex(t=>t.id===id);
  tournaments.splice(idx,1);
  deleteFromFirestore('tournaments', id);
  linkedTeams.forEach(tm => tm.tournament = '—');

  logAudit('Tournament Deleted', `"${t.name}" was deleted.`, 'Administrator');
  buildTourneyList(document.querySelector('#tourney-tabs .tab-btn.active')?.dataset.filter || 'all');
  buildDashboard();
  showToast(`Deleted "${t.name}"`);
}
function filterTourneys(btn, f){
  document.querySelectorAll('#tourney-tabs .tab-btn').forEach(b=>b.classList.remove('active'));
  btn.classList.add('active');
  buildTourneyList(f);
}

let currentBracket = bracketData; // starts with the seeded demo bracket; admin can regenerate
let currentBracketTournament = null; // which tournament currentBracket belongs to — needed so a
                                      // newly-decided round can be auto-published to the right Schedule

function buildBracket(){
  document.getElementById('bracket-render').innerHTML = currentBracket.map(r=>`
    <div class="bracket-round">
      <div class="round-title">${r.round}</div>
      ${r.matches.map(m=>`
        <div class="matchup ${r.round==='Finals' && m.winner ? 'champion' : ''}">
          <div class="mrow ${m.winner==='a'?'winner':''}"><span class="team-name">${m.winner==='a'?'🏅 ':''}${m.a}</span><span class="score">${m.sa}</span></div>
          <div class="mrow ${m.winner==='b'?'winner':''}"><span class="team-name">${m.winner==='b'?'🏅 ':''}${m.b}</span><span class="score">${m.sb}</span></div>
        </div>`).join('')}
    </div>`).join('') || `<p class="topbar-sub" style="text-transform:none;">No bracket yet — generate one from a tournament.</p>`;
}

/* Round names for a single-elim bracket, keyed by number of rounds remaining */
function roundNameFor(roundsLeft, totalRounds){
  if(roundsLeft===1) return 'Finals';
  if(roundsLeft===2) return 'Semifinals';
  if(roundsLeft===3) return 'Quarterfinals';
  return `Round of ${Math.pow(2,roundsLeft)}`;
}
function shuffle(arr){
  const a = [...arr];
  for(let i=a.length-1;i>0;i--){
    const j = Math.floor(Math.random()*(i+1));
    [a[i],a[j]] = [a[j],a[i]];
  }
  return a;
}
function generateBracketFor(tournamentName){
  const tData0 = tournaments.find(t=>t.name===tournamentName);
  if(!canManageTournament(tData0)){ showToast('You can only generate a bracket for the tournament assigned to you.'); return; }
  const roster = teams.filter(t=>t.tournament===tournamentName && t.status==='Approved').map(t=>t.name);
  if(roster.length < 2){
    showToast('Need at least 2 approved teams in this tournament to generate a bracket.');
    return;
  }
  // Pad to the next power of two with byes so the bracket structure is always valid
  let size = 1;
  while(size < roster.length) size *= 2;
  const seeded = shuffle(roster);
  while(seeded.length < size) seeded.push('BYE');

  const rounds = Math.log2(size);
  let currentRoundTeams = seeded;
  const built = [];
  for(let r=0; r<rounds; r++){
    const roundsLeft = rounds - r;
    const matches = [];
    for(let i=0; i<currentRoundTeams.length; i+=2){
      const a = currentRoundTeams[i], b = currentRoundTeams[i+1];
      // First round: auto-advance byes so the bracket isn't stuck on an unplayable match
      if(r===0 && (a==='BYE' || b==='BYE')){
        matches.push({a, sa: a==='BYE'?'—':'—', b, sb: b==='BYE'?'—':'—', winner: a==='BYE'?'b':'a'});
      } else {
        matches.push({a, sa:'—', b, sb:'—', winner:null, live:false});
      }
    }
    built.push({round: roundNameFor(roundsLeft, rounds), matches});
    // Next round's slots are the winners where known, else a TBA placeholder until that match is Final
    currentRoundTeams = matches.map(m => m.winner==='a' ? m.a : m.winner==='b' ? m.b : 'TBA');
  }
  currentBracket = built;
  currentBracketTournament = tournamentName;
  buildBracket();
  persistBracket(); // push the new bracket to Firestore so it auto-displays for spectator/coach accounts too

  // Re-generating replaces this tournament's previously auto-published matchups instead of duplicating them.
  const removedIds = [];
  for(let i=schedule.length-1;i>=0;i--){
    if(schedule[i].fromBracket && schedule[i].tournament===tournamentName){ removedIds.push(schedule[i].id); schedule.splice(i,1); }
  }
  clearCollectionFromFirestore('schedule', removedIds);
  // Publish every currently-decided matchup (round 1 right now) to the Schedule. Because this only
  // ever reads real team names sitting in m.a/m.b — never 'TBA' and never a team that already lost —
  // an eliminated team can't end up back in the pool that "Generate Schedule" draws from.
  publishReadyBracketMatches(tournamentName);

  logAudit('Bracket Generated', `New bracket generated for "${tournamentName}" (${roster.length} teams) — first round published to the Schedule.`, actorLabel());
  showToast(`Bracket generated for ${tournamentName} — first round added to the Schedule`);
}
/* Scans the live bracket for matchups that are ready to be played (both slots filled with real,
   still-in-it teams — no 'TBA' placeholder, no 'BYE') and adds any that aren't on the Schedule yet.
   A team only ever occupies a slot here if it won its way in, so a loser can never resurface —
   this is what keeps eliminated teams out of "Generate Schedule". Safe to call after every score
   sync; already-scheduled pairings are skipped so re-running it never creates duplicates. */
function publishReadyBracketMatches(tournamentName){
  if(!tournamentName || !currentBracket) return 0;
  const tData = tournaments.find(t=>t.name===tournamentName);
  const venue = tData ? tData.venue : 'TBA';
  let added = 0;
  currentBracket.forEach(round=>{
    round.matches.forEach(m=>{
      if(m.a==='TBA' || m.b==='TBA' || m.a==='BYE' || m.b==='BYE') return; // not decided yet, or a bye
      if(m.winner) return; // already played — this pairing is done, its winner has moved on
      const alreadyScheduled = schedule.some(s => s.tournament===tournamentName && s.fromBracket &&
        ((s.a===m.a && s.b===m.b) || (s.a===m.b && s.b===m.a)));
      if(alreadyScheduled) return;
      scheduleIdCounter += 1;
      schedule.push({id: scheduleIdCounter, time:'TBA', a:m.a, b:m.b, venue, status:'upcoming', tournament: tournamentName, fromBracket:true, day:'today'});
      added++;
    });
  });
  if(added){
    schedule.sort((x,y)=> x.time.localeCompare(y.time));
    buildSchedule();
    buildDashboard();
  }
  return added;
}
function onGenerateBracketClick(){
  const sel = document.getElementById('bracket-tournament-select');
  if(!sel || !sel.value) return;
  const t = tournaments.find(t=>t.name===sel.value);
  if(!canManageTournament(t)){ showToast('You can only generate a bracket for the tournament assigned to you.'); return; }
  generateBracketFor(sel.value);
}
function populateBracketTournamentSelect(){
  const sel = document.getElementById('bracket-tournament-select');
  if(!sel) return;
  // Admin sees every tournament; an official only sees the one tournament assigned to them.
  const list = tournaments.filter(t=>canManageTournament(t));
  sel.innerHTML = list.map(t=>`<option value="${t.name}">${t.name}</option>`).join('')
    || `<option value="">No tournament assigned to you yet</option>`;
}

/* ---------------- AUTO SCHEDULE GENERATOR ----------------
   Mirrors the bracket generator's flow: pick a tournament, click "Generate Schedule".
   It never invents new matchups — it only fills in the date + time for that tournament's
   bracket matches that don't have a real one yet (freshly generated brackets publish their
   first round to the Schedule with time:'TBA' and no date). Re-generating the bracket clears
   the old TBA rows and this can simply be run again on the new ones. -------------------------- */
const SCHEDULE_TIME_SLOTS = ['08:00','10:00','13:00','15:00','17:00','19:00'];

function populateScheduleTournamentSelect(){
  const sel = document.getElementById('schedule-tournament-select');
  if(!sel) return;
  // Admin sees every tournament; an official only sees the one tournament assigned to them.
  const list = tournaments.filter(t=>canManageTournament(t));
  sel.innerHTML = list.map(t=>`<option value="${t.name}">${t.name}</option>`).join('')
    || `<option value="">No tournament assigned to you yet</option>`;
}
/* Which tournament a manually-added match belongs to. Without this, the match had no `tournament`
   tag at all, so an assigned official's QR button (canQr checks canManageTournament on the match's
   tournament) never showed for it — only admin, who bypasses the tournament check, could see it. */
function populateNewMatchTournamentSelect(){
  const sel = document.getElementById('new-match-tournament');
  if(!sel) return;
  const list = tournaments.filter(t=>canManageTournament(t));
  sel.innerHTML = list.map(t=>`<option value="${t.name}">${t.name}</option>`).join('')
    || `<option value="">No tournament assigned to you yet</option>`;
}
function addDaysIso(iso, n){
  const d = new Date(iso+'T00:00:00');
  d.setDate(d.getDate()+n);
  return d.toISOString().slice(0,10);
}
function dayBucketForDate(iso){
  const today = new Date(); today.setHours(0,0,0,0);
  const d = new Date(iso+'T00:00:00');
  const diffDays = Math.round((d-today)/86400000);
  if(diffDays<=0) return 'today';
  if(diffDays===1) return 'tomorrow';
  return 'week';
}
function isScheduleSlotTaken(dateStr, time, venue, teamA, teamB, excludeId){
  return schedule.some(o => o.id!==excludeId && o.date===dateStr && o.time===time && (
    o.venue===venue || o.a===teamA || o.a===teamB || o.b===teamA || o.b===teamB
  ));
}
function generateScheduleFor(tournamentName){
  const t = tournaments.find(x=>x.name===tournamentName);
  if(!t){ showToast('Select a tournament first.'); return; }
  if(!canManageTournament(t)){ showToast('You can only generate the schedule for the tournament assigned to you.'); return; }

  // Only touch this tournament's bracket-published matches that don't have a real date/time yet.
  const targets = schedule.filter(m => m.tournament===tournamentName && m.fromBracket && (!m.date || m.time==='TBA'));
  if(!targets.length){
    showToast(`Nothing to schedule for "${tournamentName}" — generate its bracket first, or its matches already have a date and time.`);
    return;
  }

  const startIso = t.startDate || new Date().toISOString().slice(0,10);
  let dayOffset = 0, slotIndex = 0;

  targets.forEach(m=>{
    let placed = false, attempts = 0;
    while(!placed && attempts < 60){
      const dateStr = addDaysIso(startIso, dayOffset);
      const time = SCHEDULE_TIME_SLOTS[slotIndex % SCHEDULE_TIME_SLOTS.length];
      if(!isScheduleSlotTaken(dateStr, time, m.venue, m.a, m.b, m.id)){
        m.date = dateStr;
        m.time = time;
        m.day = dayBucketForDate(dateStr);
        placed = true;
      }
      slotIndex++;
      if(slotIndex % SCHEDULE_TIME_SLOTS.length === 0) dayOffset++;
      attempts++;
    }
  });

  schedule.sort((x,y)=> (x.date||'').localeCompare(y.date||'') || x.time.localeCompare(y.time));
  buildSchedule();
  buildDashboard();

  logAudit('Schedule Generated', `Auto-generated the date and time for ${targets.length} bracket match(es) in "${tournamentName}".`, actorLabel());
  showToast(`Schedule generated for ${tournamentName} — ${targets.length} match(es) now have a date and time`);
}
function onGenerateScheduleClick(){
  const sel = document.getElementById('schedule-tournament-select');
  if(!sel || !sel.value){ showToast('Select a tournament first.'); return; }
  const t = tournaments.find(t=>t.name===sel.value);
  if(!canManageTournament(t)){ showToast('You can only generate the schedule for the tournament assigned to you.'); return; }
  generateScheduleFor(sel.value);
}

/* ---- Schedule: public read-only view · Admin and Official can add / edit / delete matches, and set matches live ----
   Matches auto-published from a generated bracket / Generate Schedule (fromBracket:true) are fully
   editable too, once they have a real date+time — admin/official can fix the auto-assigned slot,
   venue, or status any time. hasScheduleConflict() is kept around to flag a clash in the UI, but no
   longer gates whether the Edit button shows. ---- */
function hasScheduleConflict(m){
  return schedule.some(o => o.id!==m.id && o.time===m.time && (o.date||null)===(m.date||null) && (
    o.venue===m.venue || o.a===m.a || o.a===m.b || o.b===m.a || o.b===m.b
  ));
}
/* Only Admin and Official can add matches. Coach and Spectator get a view-only schedule (no add/edit/delete controls). */
function filterScheduleDay(btn, day){
  currentScheduleTab = day;
  document.querySelectorAll('#schedule-tabs .tab-btn').forEach(b=>b.classList.remove('active'));
  btn.classList.add('active');
  buildSchedule();
}
function buildSchedule(){
  const el = document.getElementById('schedule-list');
  const canManage = currentRole === 'admin' || currentRole === 'official';
  const dayMatches = schedule.filter(m => (m.day || 'today') === currentScheduleTab);
  el.innerHTML = dayMatches.map(m=>{
    const conflict = canManage && m.fromBracket && hasScheduleConflict(m);
    const fullyEditable = canManage;
    // Only the admin, or the official assigned to this match's tournament, gets the live-score QR control.
    const canQr = canManage && canManageTournament(tournaments.find(t=>t.name===m.tournament));
    if(canManage && editingMatchId === m.id){
      return `
      <div class="sched-edit-row">
        <select id="edit-match-tournament">
          ${tournaments.filter(t=>canManageTournament(t)).map(t=>`<option value="${t.name}" ${m.tournament===t.name?'selected':''}>${t.name}</option>`).join('') || `<option value="">No tournament assigned to you</option>`}
        </select>
        <input type="text" id="edit-match-time" value="${m.time}">
        <input type="text" id="edit-match-a" value="${m.a}">
        <input type="text" id="edit-match-b" value="${m.b}">
        <input type="text" id="edit-match-venue" value="${m.venue}">
        <select id="edit-match-status">
          <option value="upcoming" ${m.status==='upcoming'?'selected':''}>Upcoming</option>
          <option value="live" ${m.status==='live'?'selected':''}>Live</option>
          <option value="done" ${m.status==='done'?'selected':''}>Final</option>
        </select>
        <div class="sched-actions">
          <button class="btn btn-primary btn-sm" onclick="saveMatch(${m.id})">Save</button>
          <button class="btn btn-ghost btn-sm" onclick="cancelEditMatch()">Cancel</button>
        </div>
      </div>`;
    }
    return `
    <div class="sched-item ${m.status==='live'?'live-clickable':''}" ${m.status==='live'?`onclick="openLiveViewer(${m.id})"`:''}>
      <div class="sched-time">${m.time}${m.date ? `<span class="sched-date">${fmtShortDate(m.date)}</span>` : ''}</div>
      <div class="sched-vs">
        <div class="team-logo" style="background:${colorFor(m.a)}">${initials(m.a)}</div>${m.a}
        ${(m.scoreA!=null && m.scoreB!=null) ? `<span class="mono" style="color:var(--lime);font-weight:700;">${m.scoreA} - ${m.scoreB}</span>` : `<span style="color:var(--muted-2);font-weight:400;">vs</span>`}
        <div class="team-logo" style="background:${colorFor(m.b)}">${initials(m.b)}</div>${m.b}
      </div>
      <div class="sched-venue">${m.venue}</div>
      <span class="pill ${m.status==='live'?'pill-live':m.status==='done'?'pill-done':'pill-upcoming'}">${m.status==='live'?'Live':m.status==='done'?'Final':'Upcoming'}</span>
      ${conflict ? `<span class="pill" style="background:rgba(255,77,109,0.14);color:var(--danger);" title="Same time+venue or a team is double-booked">⚠ Conflict</span>` : ''}
      ${canManage ? `
      <div class="sched-actions">
        ${canQr ? `<button class="btn btn-ghost btn-sm" onclick="event.stopPropagation();openMatchQr(${m.id})">📱 QR</button>` : ''}
        ${fullyEditable ? `<button class="btn btn-ghost btn-sm" onclick="event.stopPropagation();editMatch(${m.id})">Edit</button>` : ''}
        <button class="btn btn-danger btn-sm" onclick="event.stopPropagation();deleteMatch(${m.id})">Delete</button>
      </div>` : ''}
    </div>`;
  }).join('') || `<p class="topbar-sub" style="text-transform:none;">No matches scheduled for this period.</p>`;
}
function addMatch(){
  const tournamentSel = document.getElementById('new-match-tournament');
  const tournament = tournamentSel ? tournamentSel.value : '';
  const time = document.getElementById('new-match-time').value.trim();
  const a = document.getElementById('new-match-a').value.trim();
  const b = document.getElementById('new-match-b').value.trim();
  const venue = document.getElementById('new-match-venue').value.trim();
  const day = document.getElementById('new-match-day').value;
  const status = document.getElementById('new-match-status').value;
  if(!tournament){
    showToast('Select a tournament for this match first.');
    return;
  }
  if(!time || !a || !b || !venue){
    showToast('Fill in time, both teams, and venue.');
    return;
  }
  const t = tournaments.find(x=>x.name===tournament);
  if(!canManageTournament(t)){ showToast('You can only add matches for the tournament assigned to you.'); return; }
  scheduleIdCounter += 1;
  // Tagging the tournament here is what lets the assigned official's live-score QR button show up
  // for this match too, same as admin — canQr in buildSchedule() checks it via canManageTournament.
  schedule.push({id: scheduleIdCounter, time, a, b, venue, status, day, tournament});
  schedule.sort((x,y)=> x.time.localeCompare(y.time));
  document.getElementById('new-match-time').value='';
  document.getElementById('new-match-a').value='';
  document.getElementById('new-match-b').value='';
  document.getElementById('new-match-venue').value='';
  document.getElementById('new-match-day').value='today';
  document.getElementById('new-match-status').value='upcoming';
  logAudit('Match Added', `${a} vs ${b} scheduled at ${venue}, ${time} (${tournament}).`, actorLabel());
  buildSchedule();
  buildDashboard();
  showToast(`Added ${a} vs ${b} to the schedule`);
}
function editMatch(id){
  editingMatchId = id;
  buildSchedule();
}
function cancelEditMatch(){
  editingMatchId = null;
  buildSchedule();
}
function saveMatch(id){
  const m = schedule.find(m=>m.id===id);
  if(!m) return;
  const tournamentSel = document.getElementById('edit-match-tournament');
  const tournament = tournamentSel ? tournamentSel.value : m.tournament;
  const time = document.getElementById('edit-match-time').value.trim();
  const a = document.getElementById('edit-match-a').value.trim();
  const b = document.getElementById('edit-match-b').value.trim();
  const venue = document.getElementById('edit-match-venue').value.trim();
  const status = document.getElementById('edit-match-status').value;
  if(!time || !a || !b || !venue){
    showToast('Fill in time, both teams, and venue.');
    return;
  }
  // Tagging (or fixing) the tournament here is what lets the assigned official's live-score QR
  // button show up for this match, same as admin — buildSchedule()'s canQr depends on it.
  Object.assign(m, {time, a, b, venue, status, tournament});
  schedule.sort((x,y)=> x.time.localeCompare(y.time));
  editingMatchId = null;
  // Marking a match Final here (e.g. fixing it manually instead of via the live-score page) should
  // still promote the higher-scoring team into the bracket's next-round TBA slot.
  if(status === 'done') syncScoreToBracket(m);
  logAudit('Match Updated', `${a} vs ${b} updated (${status}) — ${venue}, ${time}.`, actorLabel());
  buildSchedule();
  buildDashboard();
  showToast('Match updated');
}
function deleteMatch(id){
  const m = schedule.find(m=>m.id===id);
  if(!m) return;
  if(!confirm(`Delete ${m.a} vs ${m.b}? This can't be undone.`)) return;
  const idx = schedule.findIndex(x=>x.id===id);
  schedule.splice(idx,1);
  logAudit('Match Deleted', `${m.a} vs ${m.b} removed from the schedule.`, actorLabel());
  buildSchedule();
  buildDashboard();
  showToast('Match deleted');
}

/* ---- Standings: public read-only view · Admin can add / edit / delete rows ---- */
function calcWinPct(w,gp){
  if(!gp || gp<=0) return '0.0%';
  return ((w/gp)*100).toFixed(1)+'%';
}
function resortStandings(){
  standings.sort((x,y)=> y.pts - x.pts || parseInt(y.pd) - parseInt(x.pd));
  standings.forEach((s,i)=> s.rank = i+1);
}
function renderStandings(){
  resortStandings();
  const isAdmin = currentRole === 'admin';
  document.getElementById('standings-body').innerHTML = standings.map(s=>{
    if(isAdmin && editingStandingId === s.id){
      return `
      <tr>
        <td>${s.rank}</td>
        <td><input type="text" id="edit-st-team" class="standings-team-input" value="${s.team}"></td>
        <td><input type="number" id="edit-st-gp" class="standings-edit-input" value="${s.gp}"></td>
        <td><input type="number" id="edit-st-w" class="standings-edit-input" value="${s.w}"></td>
        <td><input type="number" id="edit-st-l" class="standings-edit-input" value="${s.l}"></td>
        <td><input type="text" id="edit-st-pd" class="standings-edit-input" value="${s.pd}"></td>
        <td class="mono">${calcWinPct(s.w,s.gp)}</td>
        <td><input type="number" id="edit-st-pts" class="standings-edit-input" value="${s.pts}"></td>
        <td>
          <div style="display:flex;gap:6px;">
            <button class="btn btn-primary btn-sm" onclick="saveStanding(${s.id})">Save</button>
            <button class="btn btn-ghost btn-sm" onclick="cancelEditStanding()">Cancel</button>
          </div>
        </td>
      </tr>`;
    }
    return `
    <tr>
      <td class="${s.rank===1?'rank-1':''}">${s.rank}</td>
      <td><div class="team-cell"><div class="team-logo" style="background:${colorFor(s.team)}">${initials(s.team)}</div>${s.team}</div></td>
      <td>${s.gp}</td><td>${s.w}</td><td>${s.l}</td><td>${s.pd}</td><td>${calcWinPct(s.w,s.gp)}</td>
      <td class="mono" style="color:var(--lime);font-weight:700;">${s.pts}</td>
      ${isAdmin ? `<td><div style="display:flex;gap:6px;">
        <button class="btn btn-ghost btn-sm" onclick="editStanding(${s.id})">Edit</button>
        <button class="btn btn-danger btn-sm" onclick="deleteStanding(${s.id})">Delete</button>
      </div></td>` : ''}
    </tr>`;
  }).join('') || `<tr><td colspan="9"><p class="topbar-sub" style="text-transform:none;">No teams in the standings yet.</p></td></tr>`;
}
function addStandingRow(){
  standingIdCounter += 1;
  standings.push({id: standingIdCounter, rank: standings.length+1, team:'New Team', gp:0, w:0, l:0, pd:'0', pts:0});
  editingStandingId = standingIdCounter;
  renderStandings();
  showToast('New row added — fill in the details and Save');
}
function editStanding(id){
  editingStandingId = id;
  renderStandings();
}
function cancelEditStanding(){
  editingStandingId = null;
  renderStandings();
}
function saveStanding(id){
  const s = standings.find(s=>s.id===id);
  if(!s) return;
  const team = document.getElementById('edit-st-team').value.trim();
  const gp = parseInt(document.getElementById('edit-st-gp').value) || 0;
  const w = parseInt(document.getElementById('edit-st-w').value) || 0;
  const l = parseInt(document.getElementById('edit-st-l').value) || 0;
  const pd = document.getElementById('edit-st-pd').value.trim() || '0';
  const pts = parseInt(document.getElementById('edit-st-pts').value) || 0;
  if(!team){
    showToast('Team name is required.');
    return;
  }
  Object.assign(s, {team, gp, w, l, pd, pts});
  editingStandingId = null;
  logAudit('Standings Updated', `${team}: ${w}W-${l}L, ${pts} pts.`, 'Administrator');
  renderStandings();
  showToast('Standings updated');
}
function deleteStanding(id){
  const s = standings.find(s=>s.id===id);
  if(!s) return;
  if(!confirm(`Remove ${s.team} from the standings? This can't be undone.`)) return;
  const idx = standings.findIndex(x=>x.id===id);
  standings.splice(idx,1);
  deleteFromFirestore('standings', id);
  logAudit('Standings Row Removed', `${s.team} removed from the standings.`, 'Administrator');
  renderStandings();
  showToast(`Removed ${s.team}`);
}

let sportFilter = 'all';
function filterSport(btn, sport){
  document.querySelectorAll('#search-filters .tab-btn').forEach(b=>b.classList.remove('active'));
  btn.classList.add('active');
  sportFilter = sport;
  renderPlayers();
}
function registeredPlayers(){
  // Only players who submitted a registration AND were approved by the admin are searchable.
  return registrations.filter(r=>r.role==='Player' && r.status==='Approved');
}
function renderPlayers(){
  const q = (document.getElementById('player-search-input')?.value || '').toLowerCase();
  const list = registeredPlayers().filter(p=>{
    const matchesSport = sportFilter==='all' || p.sport===sportFilter;
    const matchesQuery = !q || p.name.toLowerCase().includes(q) || (p.team||'').toLowerCase().includes(q) || (p.sport||'').toLowerCase().includes(q);
    return matchesSport && matchesQuery;
  });
  const canManagePlayers = currentRole === 'admin' || currentRole === 'official';
  document.getElementById('player-results').innerHTML = list.map(p=>`
    <div class="card">
      <div class="player-card">
        <div class="avatar" style="background:${colorFor(p.name)}">${p.photo ? `<img src="${p.photo}" alt="${p.name}">` : initials(p.name)}</div>
        <div class="player-meta">
          <div class="player-name">${p.name}</div>
          <div class="player-sub">${p.team && p.team!=='—' ? p.team+' · ' : ''}${p.sport}</div>
        </div>
      </div>
      ${canManagePlayers ? `<button class="btn btn-danger btn-sm" style="width:100%;margin-top:12px;" onclick="deletePlayerFromSearch(${p.id})">Delete Player</button>` : ''}
    </div>`).join('') || `<p class="topbar-sub" style="text-transform:none;">No registered players match your search.</p>`;
}
function pickFormat(el){
  document.querySelectorAll('.format-opt').forEach(f=>f.classList.remove('selected'));
  el.classList.add('selected');
}

/* ---------------- CALENDAR-STYLE DATE PICKER (Generator: Start/End Date) ----------------
   Start Date: full navigable calendar, pick any day.
   End Date: automatically set to the Start Date the moment a start date is chosen, then
   LOCKED to that same month/year — the admin can only change the day (dd), and only to a
   day on/after the start day within that same month. */
const genCal = {
  openFor: null,       // 'start' | 'end' | null
  viewYear: null,
  viewMonth: null,     // 0-11, for whichever popup is open
};

function pad2(n){ return String(n).padStart(2,'0'); }
function isoFromParts(y,m,d){ return `${y}-${pad2(m+1)}-${pad2(d)}`; }
function fmtDisplayDate(iso){
  if(!iso) return '';
  const d = new Date(iso+'T00:00:00');
  return d.toLocaleDateString('en-US',{month:'short',day:'numeric',year:'numeric'});
}
function daysInMonth(y,m){ return new Date(y, m+1, 0).getDate(); }

function closeAllCalendars(){
  document.getElementById('gen-start-popup')?.classList.remove('open');
  document.getElementById('gen-end-popup')?.classList.remove('open');
  document.getElementById('gen-start-display')?.classList.remove('open');
  document.getElementById('gen-end-display')?.classList.remove('open');
  genCal.openFor = null;
}

function toggleCalendar(which){
  const displayEl = document.getElementById(`gen-${which}-display`);
  if(which === 'end' && displayEl.classList.contains('disabled')) return; // pick a start date first

  const alreadyOpen = genCal.openFor === which;
  closeAllCalendars();
  if(alreadyOpen) return; // clicking the same field again just closes it

  const startIso = document.getElementById('gen-start').value;
  if(which === 'end'){
    // Locked to the start date's month/year — no navigation.
    const s = new Date(startIso+'T00:00:00');
    genCal.viewYear = s.getFullYear();
    genCal.viewMonth = s.getMonth();
  } else {
    const existing = document.getElementById('gen-start').value;
    const base = existing ? new Date(existing+'T00:00:00') : new Date();
    genCal.viewYear = base.getFullYear();
    genCal.viewMonth = base.getMonth();
  }
  genCal.openFor = which;
  displayEl.classList.add('open');
  document.getElementById(`gen-${which}-popup`).classList.add('open');
  renderCalendar(which);
}

function navCalendar(which, delta){
  if(which === 'end') return; // end date's month is locked to the start date
  genCal.viewMonth += delta;
  if(genCal.viewMonth < 0){ genCal.viewMonth = 11; genCal.viewYear--; }
  if(genCal.viewMonth > 11){ genCal.viewMonth = 0; genCal.viewYear++; }
  renderCalendar(which);
}

function renderCalendar(which){
  const popup = document.getElementById(`gen-${which}-popup`);
  const y = genCal.viewYear, m = genCal.viewMonth;
  const monthLabel = new Date(y, m, 1).toLocaleDateString('en-US',{month:'long',year:'numeric'});
  const today = new Date(); today.setHours(0,0,0,0);
  const selectedIso = document.getElementById(`gen-${which}`).value;

  // End date can never be before the start date — clamp the earliest selectable day
  // to the start day when we're rendering the (locked) end-date month.
  let minDay = 1;
  if(which === 'end'){
    const startIso = document.getElementById('gen-start').value;
    const s = new Date(startIso+'T00:00:00');
    if(s.getFullYear() === y && s.getMonth() === m) minDay = s.getDate();
  }

  const firstDow = new Date(y, m, 1).getDay(); // 0=Sun
  const totalDays = daysInMonth(y, m);
  const cells = [];
  for(let i=0;i<firstDow;i++) cells.push(null);
  for(let d=1; d<=totalDays; d++) cells.push(d);

  const dowRow = ['S','M','T','W','T','F','S'].map(d=>`<span>${d}</span>`).join('');
  const dayCells = cells.map(d=>{
    if(d===null) return `<div class="cal-day muted" style="visibility:hidden;">·</div>`;
    const iso = isoFromParts(y,m,d);
    const cellDate = new Date(y,m,d); cellDate.setHours(0,0,0,0);
    const isToday = cellDate.getTime() === today.getTime();
    const isSelected = iso === selectedIso;
    const disabled = d < minDay;
    return `<button type="button" class="cal-day${isToday?' today':''}${isSelected?' selected':''}" ${disabled?'disabled':''} onclick="event.stopPropagation();selectCalDay('${which}',${y},${m},${d})">${d}</button>`;
  }).join('');

  popup.innerHTML = `
    <div class="cal-head">
      <button type="button" class="cal-nav" onclick="event.stopPropagation();navCalendar('${which}',-1)" ${which==='end'?'disabled style="visibility:hidden;"':''}>‹</button>
      <span class="cal-head-label">${monthLabel}</span>
      <button type="button" class="cal-nav" onclick="event.stopPropagation();navCalendar('${which}',1)" ${which==='end'?'disabled style="visibility:hidden;"':''}>›</button>
    </div>
    <div class="cal-dow">${dowRow}</div>
    <div class="cal-grid">${dayCells}</div>
    ${which==='end' ? `<div class="cal-end-hint">Locked to ${monthLabel} — pick any day on/after the start date</div>` : ''}
  `;
}

function selectCalDay(which, y, m, d){
  const iso = isoFromParts(y,m,d);
  document.getElementById(`gen-${which}`).value = iso;
  const displayText = document.getElementById(`gen-${which}-display-text`);
  displayText.textContent = fmtDisplayDate(iso);
  displayText.classList.remove('ph');

  if(which === 'start'){
    // Auto-set the End Date to match, then unlock (only) its day picker to this same month.
    document.getElementById('gen-end').value = iso;
    const endText = document.getElementById('gen-end-display-text');
    endText.textContent = fmtDisplayDate(iso);
    endText.classList.remove('ph');
    document.getElementById('gen-end-display').classList.remove('disabled');
  }
  closeAllCalendars();
}

document.addEventListener('click', function(e){
  if(!genCal.openFor) return;
  const withinPopup = e.target.closest('.cal-popup') || e.target.closest('.datefield-display');
  if(!withinPopup) closeAllCalendars();
});

function resetGenDateFields(){
  document.getElementById('gen-start').value = '';
  document.getElementById('gen-end').value = '';
  const startText = document.getElementById('gen-start-display-text');
  startText.textContent = 'Select a date';
  startText.classList.add('ph');
  const endText = document.getElementById('gen-end-display-text');
  endText.textContent = 'Pick start date first';
  endText.classList.add('ph');
  document.getElementById('gen-end-display').classList.add('disabled');
  closeAllCalendars();
}

function fmtShortDate(iso){
  if(!iso) return '';
  const d = new Date(iso+'T00:00:00');
  return d.toLocaleDateString('en-US',{month:'short',day:'numeric'});
}
function computeInitialTourneyStatus(startDate){
  // Per admin's rule: start date within this week (today up to 7 days out) -> "Upcoming".
  // Start date beyond 7 days from today -> "Ongoing".
  if(!startDate) return 'Upcoming';
  const today = new Date(); today.setHours(0,0,0,0);
  const start = new Date(startDate+'T00:00:00');
  const diffDays = Math.round((start - today) / 86400000);
  return diffDays > 7 ? 'Ongoing' : 'Upcoming';
}
function generateTourney(){
  const name = document.getElementById('gen-name').value.trim();
  const sport = document.getElementById('gen-sport').value;
  const teamsCount = parseInt(document.getElementById('gen-teams').value) || 0;
  const startDate = document.getElementById('gen-start').value;
  const endDate = document.getElementById('gen-end').value;
  const venue = document.getElementById('gen-venue').value.trim();
  const minPlayers = parseInt(document.getElementById('gen-min-players').value) || 0;
  const formatEl = document.querySelector('#format-grid .format-opt.selected');
  const format = formatEl ? formatEl.querySelector('h3').textContent : 'Round Robin';

  if(!name || !venue || !startDate || !endDate || teamsCount < 2){
    showToast('Fill in the tournament name, venue, both dates, and at least 2 teams.');
    return;
  }
  if(new Date(endDate+'T00:00:00') < new Date(startDate+'T00:00:00')){
    showToast('End date can\'t be earlier than the start date. Please fix the tournament dates.');
    return;
  }
  if(minPlayers < 1){
    showToast('Minimum players per team must be at least 1.');
    return;
  }

  tourneyIdCounter += 1;
  const dates = `${fmtShortDate(startDate)}–${fmtShortDate(endDate)}`;
  const initialStatus = computeInitialTourneyStatus(startDate);
  tournaments.push({
    id: tourneyIdCounter, name, sport, status:initialStatus, teams: teamsCount,
    venue, dates, startDate, endDate, format, minPlayers, regOpen:true, published:true
  });

  // Notify coaches (and everyone else) — shows up on the Dashboard and My Team announcement feeds.
  // Coaches see this clearly flagged as an open-for-registration tournament they can apply to.
  const notifTitle = `📢 New Tournament Open for Registration: ${name}`;
  const notifMsg = `Coaches: ${sport} · ${format} · ${dates} at ${venue}. Teams need at least ${minPlayers} player(s) on the roster to join. Registration is now open — go to My Team or Tournaments and tap "Join" once you've created your team. Your team will be marked Pending until an admin approves it.`;
  announcements.unshift({id: fsIdCounter++, t: notifTitle, d: notifMsg, forCoaches:true});
  sentNotifications.unshift({type:'Tournament Announcement', title: notifTitle, msg: notifMsg, when: new Date().toLocaleDateString('en-US',{month:'short',day:'numeric',year:'numeric'})});
  logAudit('Tournament Created', `"${name}" created (${sport} · ${format} · min ${minPlayers} player(s)/team) — registration opened, coaches notified.`, 'Administrator');

  // Reset the form
  document.getElementById('gen-name').value = '';
  document.getElementById('gen-teams').value = '8';
  document.getElementById('gen-venue').value = '';
  document.getElementById('gen-min-players').value = '5';
  resetGenDateFields();

  // Refresh every screen that lists tournaments so the new one shows up immediately
  buildTourneyList(document.querySelector('#tourney-tabs .tab-btn.active')?.dataset.filter || 'all');
  buildDashboard();
  renderSentNotifications();
  populateBracketTournamentSelect();
  populateScheduleTournamentSelect();
  populateNewMatchTournamentSelect();
  buildMyTeam();

  showToast(`"${name}" created — coaches have been notified and can now register ✓`);
  nav('tournaments');
}
function exportToast(type){
  showToast(`${type} export ready for download`);
}

/* ---------------- MATCH LIVE-SCORE / QR CONTROL (new feature) ----------------
   Admin, or the official assigned to a match's tournament, opens this from a Schedule
   row. It shows a QR code (and plain link) to a public, no-login "live score" page for
   that one match, and lets them punch in the score right there. Saving the score updates
   the schedule doc (already Firestore-synced to every account) and pushes the same result
   into the matching bracket match — winners cascade into the next round automatically —
   so spectators/coaches see it update live on both the Schedule and the Bracket screens. */
let qrModalMatchId = null;

function liveScoreUrlFor(matchId){
  const url = new URL(window.location.href);
  url.search = `?live=${matchId}`;
  url.hash = '';
  return url.toString();
}
function openMatchQr(id){
  const m = schedule.find(s=>s.id===id);
  if(!m) return;
  const t = tournaments.find(t=>t.name===m.tournament);
  if(!canManageTournament(t)){ showToast('Only the admin or this tournament\'s assigned official can open the live-score QR for this match.'); return; }
  qrModalMatchId = id;
  renderMatchQrModal();
  document.getElementById('qr-modal-overlay').classList.add('open');
}
function closeMatchQr(){
  document.getElementById('qr-modal-overlay').classList.remove('open');
  qrModalMatchId = null;
}
function renderMatchQrModal(){
  const m = schedule.find(s=>s.id===qrModalMatchId);
  if(!m) return;
  document.getElementById('qr-modal-title').textContent = `${m.a} vs ${m.b}`;
  document.getElementById('qr-modal-sub').textContent = `${m.venue} · ${m.time}${m.tournament ? ' · '+m.tournament : ''}`;
  const link = liveScoreUrlFor(m.id);
  const img = document.getElementById('qr-modal-img');
  img.src = `https://api.qrserver.com/v1/create-qr-code/?size=280x280&margin=0&data=${encodeURIComponent(link)}`;
  const linkEl = document.getElementById('qr-modal-link');
  linkEl.textContent = link;
  linkEl.href = link;
}
function copyMatchQrLink(){
  if(!qrModalMatchId) return;
  const link = liveScoreUrlFor(qrModalMatchId);
  if(navigator.clipboard && navigator.clipboard.writeText){
    navigator.clipboard.writeText(link).then(()=>showToastOnly('Live score link copied ✓')).catch(()=>showToastOnly(link));
  } else {
    showToastOnly(link);
  }
}
/* Finds this match inside whichever bracket round it belongs to (by team names, either
   order) and mirrors the new score onto it. When the match is marked Final, it also works
   out the winner and slots that winner into the next round, same as a normal bracket advance. */
function syncScoreToBracket(m){
  if(!currentBracket || !currentBracket.length) return;
  let changed = false;
  for(let ri=0; ri<currentBracket.length; ri++){
    const round = currentBracket[ri];
    const mi = round.matches.findIndex(bm => (bm.a===m.a && bm.b===m.b) || (bm.a===m.b && bm.b===m.a));
    if(mi === -1) continue;
    const bm = round.matches[mi];
    const swapped = bm.a===m.b && bm.b===m.a;
    bm.sa = (swapped ? m.scoreB : m.scoreA) ?? '—';
    bm.sb = (swapped ? m.scoreA : m.scoreB) ?? '—';
    bm.live = m.status === 'live';
    if(m.status === 'done' && m.scoreA!=null && m.scoreB!=null && m.scoreA !== m.scoreB){
      const aWon = swapped ? (m.scoreB > m.scoreA) : (m.scoreA > m.scoreB);
      bm.winner = aWon ? 'a' : 'b';
      bm.live = false;
      advanceBracketWinner(ri, mi);
    } else if(m.status !== 'done'){
      bm.winner = null;
    }
    changed = true;
  }
  if(changed){
    buildBracket();
    persistBracket();
    // A winner may have just filled in the next round's TBA slot — if that matchup is now fully
    // decided, get it onto the Schedule so it's ready for "Generate Schedule" (losers never qualify).
    publishReadyBracketMatches(currentBracketTournament || m.tournament);
  }
}
function advanceBracketWinner(roundIndex, matchIndex){
  const round = currentBracket[roundIndex];
  const nextRound = currentBracket[roundIndex+1];
  if(!nextRound) return; // Finals — no further round to advance into
  const bm = round.matches[matchIndex];
  const winnerName = bm.winner === 'a' ? bm.a : bm.b;
  const nextMatch = nextRound.matches[Math.floor(matchIndex/2)];
  if(!nextMatch) return;
  if(matchIndex % 2 === 0) nextMatch.a = winnerName; else nextMatch.b = winnerName;
}

/* ---------------- PUBLIC LIVE SCORE PAGE (new — what a scanned QR code opens) ----------------
   Loaded with no login at all when the URL carries ?live=<matchId> (see the DOMContentLoaded
   handler near the bottom). It's read-only and stays in sync via the same Firestore listener
   that already keeps the Schedule screen live, so the score updates the instant an admin or
   official saves a new one from the QR modal above — no refresh needed on the scanning device. */
let publicLiveMatchId = null;
function renderPublicLiveMatch(){
  if(!publicLiveMatchId) return;
  const m = schedule.find(s=>s.id===publicLiveMatchId);
  const venueEl = document.getElementById('public-live-venue');
  const scoreRow = document.getElementById('public-live-score-row');
  const updateBtn = document.getElementById('public-live-update-btn');
  const statusEl = document.getElementById('public-live-status');
  if(!m){
    document.getElementById('public-live-team-a').textContent = 'Match not found';
    document.getElementById('public-live-team-b').textContent = '';
    scoreRow.style.display = 'none';
    updateBtn.style.display = 'none';
    statusEl.style.display = 'none';
    venueEl.textContent = 'This match may have been removed.';
    return;
  }
  scoreRow.style.display = 'flex';
  document.getElementById('public-live-tournament').textContent = m.tournament || 'TournamentPro';
  document.getElementById('public-live-team-a').textContent = m.a;
  document.getElementById('public-live-team-b').textContent = m.b;
  // Don't clobber a value the person is actively typing when a Firestore update lands mid-edit.
  const scoreAInput = document.getElementById('public-live-score-a');
  const scoreBInput = document.getElementById('public-live-score-b');
  if(document.activeElement !== scoreAInput) scoreAInput.value = m.scoreA ?? '';
  if(document.activeElement !== scoreBInput) scoreBInput.value = m.scoreB ?? '';
  statusEl.style.display = 'inline-block';
  statusEl.textContent = m.status==='live' ? 'LIVE' : m.status==='done' ? 'FINAL' : 'UPCOMING';
  statusEl.className = `pill ${m.status==='live'?'pill-live':m.status==='done'?'pill-done':'pill-upcoming'}`;
  venueEl.textContent = `${m.venue} · ${m.time}${m.date ? ' · '+fmtShortDate(m.date) : ''}`;

  const endBtn = document.getElementById('public-live-end-btn');
  const finalNote = document.getElementById('public-live-final-note');
  if(m.status === 'done'){
    // Match is finalized — lock the score inputs and hide the action buttons so it can't be re-ended by accident.
    scoreAInput.disabled = true;
    scoreBInput.disabled = true;
    updateBtn.style.display = 'none';
    endBtn.style.display = 'none';
    finalNote.style.display = 'block';
    const winnerName = m.scoreA > m.scoreB ? m.a : m.scoreB > m.scoreA ? m.b : null;
    finalNote.textContent = winnerName ? `✓ Final — ${winnerName} advances in the bracket` : '✓ Final score recorded';
  } else {
    scoreAInput.disabled = false;
    scoreBInput.disabled = false;
    updateBtn.style.display = 'block';
    endBtn.style.display = 'block';
    finalNote.style.display = 'none';
  }
}
/* Anyone who has the link can update the score from here — that's the point of handing this
   page out via QR at courtside. currentRole is usually 'spectator' on a freshly opened link
   (no login happened), so the audit trail notes it came from the live-score page rather than
   mislabeling it as an admin/official action. */
function liveScoreActorLabel(){
  return (currentRole === 'admin' || currentRole === 'official') ? actorLabel() : 'Live Score Page';
}
function savePublicLiveScore(){
  const m = schedule.find(s=>s.id===publicLiveMatchId);
  if(!m) return;
  const rawA = document.getElementById('public-live-score-a').value.trim();
  const rawB = document.getElementById('public-live-score-b').value.trim();
  m.scoreA = rawA === '' ? null : Number(rawA);
  m.scoreB = rawB === '' ? null : Number(rawB);
  // Entering a score on an upcoming match is a natural "it's started" signal.
  if(m.status === 'upcoming' && (m.scoreA!=null || m.scoreB!=null)) m.status = 'live';
  syncScoreToBracket(m);
  logAudit('Score Updated', `${m.a} ${m.scoreA ?? '—'} - ${m.scoreB ?? '—'} ${m.b}${m.tournament ? ' ('+m.tournament+')' : ''}.`, liveScoreActorLabel());
  buildSchedule();
  buildDashboard();
  renderPublicLiveMatch();
  showToast('Score updated — live on the schedule and the bracket ✓');
}
/* Finalizes the match from the courtside live-score page: locks in the score, marks it Final,
   and — since syncScoreToBracket() only promotes a winner into the next round's TBA slot once
   status is 'done' — this is what actually moves the higher-scoring team out of this match and
   into the bracket. Until this is pressed, the next round keeps showing TBA. */
function endPublicLiveMatch(){
  const m = schedule.find(s=>s.id===publicLiveMatchId);
  if(!m) return;
  const rawA = document.getElementById('public-live-score-a').value.trim();
  const rawB = document.getElementById('public-live-score-b').value.trim();
  const scoreA = rawA === '' ? null : Number(rawA);
  const scoreB = rawB === '' ? null : Number(rawB);
  if(scoreA==null || scoreB==null){
    showToast('Enter both scores before ending the match.');
    return;
  }
  if(scoreA === scoreB){
    showToast("Scores can't be tied — enter a final winner before ending the match.");
    return;
  }
  m.scoreA = scoreA;
  m.scoreB = scoreB;
  m.status = 'done';
  syncScoreToBracket(m); // determines the higher-score winner and advances them into the bracket's TBA slot
  const winnerName = scoreA > scoreB ? m.a : m.b;
  logAudit('Match Ended', `${m.a} ${scoreA} - ${scoreB} ${m.b}${m.tournament ? ' ('+m.tournament+')' : ''} — ${winnerName} advances.`, liveScoreActorLabel());
  buildSchedule();
  buildDashboard();
  renderPublicLiveMatch();
  showToast(`Match ended — ${winnerName} advances in the bracket ✓`);
}

/* ---------------- LIVE VIEWER (new feature) ---------------- */
let liveViewerMatchId = null;
const liveChatByMatch = {}; // per-match in-memory guest comments, frontend only — resets on page reload

function scoreForMatch(m){
  if(m.scoreA!=null && m.scoreB!=null) return `${m.scoreA} - ${m.scoreB}`;
  const t = TICKER_ITEMS.find(i => i.live && i.t === `${m.a} vs ${m.b}`);
  return t ? t.s : null;
}
function openLiveViewer(matchId){
  const m = schedule.find(s=>s.id===matchId);
  if(!m || m.status!=='live') return; // only LIVE cards open the viewer
  liveViewerMatchId = matchId;

  document.getElementById('live-viewer-team-a').textContent = m.a;
  document.getElementById('live-viewer-team-b').textContent = m.b;
  const score = scoreForMatch(m);
  document.getElementById('live-viewer-score').textContent = score || 'VS';
  document.getElementById('live-viewer-time').textContent = m.time;
  document.getElementById('live-viewer-venue').textContent = `${m.a} vs ${m.b}`;
  document.getElementById('live-viewer-venue-2').textContent = m.venue;

  // Seed a couple of sample comments the first time this match's viewer is opened
  if(!liveChatByMatch[matchId]){
    liveChatByMatch[matchId] = [
      {who:'Guest', txt:"Let's go!"},
      {who:'Fan123', txt:'Great match!'}
    ];
  }
  renderLiveChat();

  document.getElementById('live-viewer-overlay').classList.add('open');
  document.body.style.overflow = 'hidden';
}
function closeLiveViewer(){
  document.getElementById('live-viewer-overlay').classList.remove('open');
  document.body.style.overflow = '';
  liveViewerMatchId = null;
}
function escapeHtml(s){
  const d = document.createElement('div');
  d.textContent = s;
  return d.innerHTML;
}
function renderLiveChat(){
  const el = document.getElementById('live-chat-messages');
  const msgs = liveChatByMatch[liveViewerMatchId] || [];
  el.innerHTML = msgs.map(c=>`
    <div class="live-chat-msg">
      <div class="who ${c.who==='Guest'?'guest':''}">${escapeHtml(c.who)}</div>
      <div class="txt">${escapeHtml(c.txt)}</div>
    </div>`).join('');
  el.scrollTop = el.scrollHeight;
}
function postLiveComment(){
  if(!liveViewerMatchId) return;
  const input = document.getElementById('live-chat-input');
  const txt = input.value.trim();
  if(!txt) return;
  liveChatByMatch[liveViewerMatchId].push({who:'Guest', txt});
  input.value = '';
  renderLiveChat();
}

let toastTimer;
function showToastOnly(msg){
  const t = document.getElementById('toast');
  t.textContent = msg;
  t.classList.add('show');
  clearTimeout(toastTimer);
  toastTimer = setTimeout(()=>t.classList.remove('show'), 3200);
}
function showToast(msg){
  showToastOnly(msg);
  schedulePersist(); // most actions call showToast() right after mutating data — piggyback the Firestore sync here
}
</script>
</body>
</html>